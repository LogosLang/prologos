ns v7remedies
def ot2 := @[{:a {:b {:k 1}}} {:a {:b {:k 2}}}]
def ot3 := @[{:a {:b {:k 1}}} {:a {:b {:k 2}}} {:a {:b {:k 3}}}]
def vhm2 := @[@[{:x 1}] @[{:x 2}]]
def rv := {:xs @[{:a {:k 1}} {:a {:k 2}}] :k 9}
def w := {:v @[{:a {:b {:k 1}}} {:a {:b {:k 2}}}]}
def mx := {:m {:x 1 :y 2} :a {:b @[@[1 2] @[3]]}}
def ow := {:top {:eu {:cfg {:x {:p 1}}} :us {:cfg {:x {:p 2}}}}}
def og := {:db {:admins @[{:name {:f {:z 1}}} {:name {:f {:z 2}}}]}}
def m3 := {:a {:x 1} :b {:y 2} :c {:z 3}}
def mn := {:a {:x 1} :b {:y 2}}
def t5 := {:a {:b {:c {:m {:x 1} :n {:y 2}}}}}
def ovn := @[{:a @[{:x 1}]}]
def vn := {:a @[{:x 1}]}
;; every remedy the verify-round messages offer, on the message's own subject
;; L4 at an all-ordinal-head level (v4:7): keep a key before each star / end with ^ / examples / own block
ot2{0.a.b* 1.a^.b}
ot2{0.a^.b^ 1.a^.b}
ot2{0.a.b* 1.a.b*}
ot2{0.a^.b^ 1.a^.b^}
ot2{0.a^.b*}
;; L4 ot3 (v4:22)
ot3{0.a^.b^ 1.a^.b^ 2.a.b*_}
ot3{0.a^.b^ 1.a^.b^ 2.a^.b^}
;; dup ot2 `*` (v4:9): drop one (L4, as stated) / drop all / ^
ot2{0.a^.b 1.a^.b*}
ot2{0.a^.b 1.a^.b}
;; dup ot2 `*-` and `*-_` (v4:11,12): drop one / drop all / ^
ot2{0.a.b*- 1.a.b}
ot2{0.a.b 1.a.b}
ot2{0.a.b^ 1.a.b^}
;; dup vhm2 `{0}*` (v4:15): drop one / drop all
vhm2{0.{0} 1.{0}*}
vhm2{0.{0} 1.{0}}
;; dup mixed ot2 (v4:19): drop one (L4, as stated) / rename the unstarred branch
ot2{0.a.b.k^- 1.a^.b}
ot2{0.a.b.k^-k2 1.a^.b*}
;; dup ot3 (v4:21): ^ on every branch / drop on every branch
ot3{0.a^.b 1.a^.b 2.a^.b}
;; dup rv (v4:23): drop one (L4, as stated) / rename
rv{xs^.{0.a} k}
rv{xs^.{0.a*} k^k2}
;; dup w, bare numbers (v4:24): generic drop one / drop both (dup, as the caveat says) / ^
w{v^.0.a^.b v^.1.a^.b*}
w{v^.0.a^.b v^.1.a^.b}
w{v^.0.a^.b^ v^.1.a^.b^}
;; L4 mx (v4:25,26): dissolve the keys that survive on the others
mx{a.b*- m^}
mx{m^ a.b*-}
;; VF-1 remedies (v1, v2:6,7,14)
ow{top:{cfg.x*-}}
ow{top:{cfg.x^-}}
ow{top:{cfg.x^-_}}
og{db.admins:{name.f^-}}
og{db.admins:{name.f*-}}
;; VF-4 (Q_U56 lexeme arm): messages, then the offered spellings
m3{a*->b*->c}
m3{a*- b*- c}
mn{a*-_->b}
mn{a*-_ b}
mn{a*_->b}
mn{a*_ b}
;; VF-5 (^.. reading)
t5{a.b^..c*-}
t5{a^.b.c*-}
t5{a^.b^a.c*}
;; L1-7 (the yield-bare-join guard): an ordinal sn under an ordinal head vs its key-head control
ovn{0.a^.0*}
vn{a^.0*}
