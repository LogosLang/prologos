ns probe-1bvi-aa

def mn := {:a {:x 1} :b {:y 2}}
def t5 := {:a {:b {:c {:m {:x 1} :n {:y 2}}}}}
def app := {:server {:ssl {:enabled true :cert "c.pem"} :port 8080} :database {:url "db" :pool-size 10}}

;; 1b-vi-D-2b, after the mint: how a GLUED `*->` reads (Q_U56), before its message exists
mn{a*-> b}
mn{a*->b}
mn{a*- > b}
t5{a.b.c*->}
mn{a*-_> b}
;; type territory (Q_U56's prediction: Q_U37's refusal with Q_U31's "needs a SPACE")
<(x : Nat)*- Nat>
;; Q_U55's star half, and BOTH remedies it offers
t5{a.b^q.c*-}
t5{a.b.c*-}
t5{a^.b^q.c*}
app{server^srv.ssl*-}
app{server.ssl*-}
app{server^srv.ssl*}
;; controls: the provenance form keeps the rename; a dissolve stays legal
app{server^srv.ssl*-_}
t5{a^.b.c*-}
