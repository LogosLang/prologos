  PRE  (($retired-selection broadcast name))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 12) "broadcast `.*name` was retired — its replacement is `:name` (e.g. `xs:name`)" #f))
values.*:name
  PRE  ((values |.| ($select-path * ($bcast-step :name))))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-select #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) (((@bcast name))) path #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 13)))
x.*{a}
  PRE  ((x |.| ($select * a)))
  PAR  (#(struct:surf-app #(struct:surf-var x #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 1 1)) #(struct:surf-select #(struct:surf-var * #(struct:srcloc "<p>" 1 2 1)) ((a)) block #(struct:srcloc "<p>" 1 2 1))) #(struct:srcloc "<p>" 1 0 4)))
values.**
  PRE  (($retired-selection broadcast *))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 9) "broadcast `.**` was retired — its replacement is `:*` (e.g. `xs:*`)" #f))
values.**:name
