values: *
  PRE  ((values : *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 8 1))) #(struct:srcloc "<p>" 1 0 9)))
values :*
  PRE  ((values : *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 8 1))) #(struct:srcloc "<p>" 1 0 9)))
values :k
  PRE  ((values :k))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-keyword k #(struct:srcloc "<p>" 1 7 2))) #(struct:srcloc "<p>" 1 0 9)))
values:**
  PRE  ((values : **))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var ** #(struct:srcloc "<p>" 1 7 2))) #(struct:srcloc "<p>" 1 0 9)))
values:.*
  PRE  ((values : |.| *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var |.| #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 8 1))) #(struct:srcloc "<p>" 1 0 9)))
