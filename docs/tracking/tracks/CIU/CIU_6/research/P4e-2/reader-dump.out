values:*
  PRE  ((values : *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 8)))
values:*_
