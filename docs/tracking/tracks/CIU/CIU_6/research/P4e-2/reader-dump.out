values*
  PRE  ((values*))
  PAR  (#(struct:surf-app #(struct:surf-var values* #(struct:srcloc "<p>" 1 0 7)) () #(struct:srcloc "<p>" 1 0 7)))
values:*->
  PRE  ((values : *- >))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var *- #(struct:srcloc "<p>" 1 7 2)) #(struct:surf-var > #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values:*.*
  PRE  ((values : * |.| *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-var |.| #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
vhm.0*
  PRE  ((vhm |.| 0 *))
  PAR  (#(struct:surf-app #(struct:surf-var vhm #(struct:srcloc "<p>" 1 0 3)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 4 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 5 1))) #(struct:srcloc "<p>" 1 0 6)))
vhm.0*_
  PRE  ((vhm |.| 0 *_))
  PAR  (#(struct:surf-app #(struct:surf-var vhm #(struct:srcloc "<p>" 1 0 3)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 4 1)) #(struct:surf-var *_ #(struct:srcloc "<p>" 1 5 2))) #(struct:srcloc "<p>" 1 0 7)))
y.a.0*
  PRE  ((($select-path y a) |.| 0 *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var y #(struct:srcloc "<p>" 1 0 1)) ((a)) path #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 4 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 5 1))) #(struct:srcloc "<p>" 1 0 6)))
y.a.0*-
  PRE  ((($select-path y a) |.| 0 *-))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var y #(struct:srcloc "<p>" 1 0 1)) ((a)) path #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 4 1)) #(struct:surf-var *- #(struct:srcloc "<p>" 1 5 2))) #(struct:srcloc "<p>" 1 0 7)))
y{a.0*}
  PRE  (($select y a |.| 0 *))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 2) "stray `.` in a select block — write the path with no spaces (`server.host`)" #f))
vhm{0*}
  PRE  (($select vhm 0 *))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 4) "select: `0*` — `*` deletes the layer the step before it produced, and an ORDINAL step produces no layer (it selects a position, it does not add a level). Star a named step instead (`x{a.b*}`), or select the element first and flatten separately" #f))
vv:0*
  PRE  ((vv : 0 *))
  PAR  (#(struct:surf-app #(struct:surf-var vv #(struct:srcloc "<p>" 1 0 2)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 2 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 4 1))) #(struct:srcloc "<p>" 1 0 5)))
vhm.0:*
  PRE  (((get vhm 0) : *))
  PAR  (#(struct:surf-app #(struct:surf-get #(struct:surf-var vhm #(struct:srcloc "<p>" 1 0 3)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 0 3)) #(struct:srcloc "<p>" 1 0 3)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 5 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 6 1))) #(struct:srcloc "<p>" 1 0 7)))
vv:0:*
  PRE  ((($select-path vv ($bcast-step :0)) : *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var vv #(struct:srcloc "<p>" 1 0 2)) (((@bcast 0))) path #(struct:srcloc "<p>" 1 0 2)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 4 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 5 1))) #(struct:srcloc "<p>" 1 0 6)))
y.a.0:*
  PRE  (((get ($select-path y a) 0) : *))
  PAR  (#(struct:surf-app #(struct:surf-get #(struct:surf-select #(struct:surf-var y #(struct:srcloc "<p>" 1 0 1)) ((a)) path #(struct:srcloc "<p>" 1 0 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 0 1)) #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 5 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 6 1))) #(struct:srcloc "<p>" 1 0 7)))
#p(a.*)
  PRE  ((path :a.*))
  PAR  (#(struct:surf-path ((#:a *)) #(struct:srcloc "<p>" 1 0 7)))
#p(a.**)
  PRE  ((path :a.**))
  PAR  (#(struct:surf-path ((#:a **)) #(struct:srcloc "<p>" 1 0 8)))
#p(a:*)
  PRE  ((path :a:*))
  PAR  (#(struct:surf-path ((#:a:*)) #(struct:srcloc "<p>" 1 0 7)))
{:* 1}
  PRE  (($brace-params : * 1))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 1) "Map literal requires an even number of elements (key-value pairs)" #f))
:*
  PRE  ((: *))
  PAR  (#(struct:surf-app #(struct:surf-var : #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var * #(struct:srcloc "<p>" 1 1 1))) #(struct:srcloc "<p>" 1 0 2)))
values:name
  PRE  (($select-path values ($bcast-step :name)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast name))) path #(struct:srcloc "<p>" 1 0 11)))
values:{a b}
  PRE  (($select-path values ($bcast-step ($select-brace a b))))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast (@sub (a) (b))))) path #(struct:srcloc "<p>" 1 0 7)))
values:0
  PRE  (($select-path values ($bcast-step :0)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast 0))) path #(struct:srcloc "<p>" 1 0 8)))
values{a b}*
  PRE  (($select-path ($select values a b) $postfix-star))
  PAR  (#(struct:surf-select #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 6 1)) ((a) (b)) block #(struct:srcloc "<p>" 1 6 1)) (((@star flatten))) path #(struct:srcloc "<p>" 1 0 12)))
values{0 1}*
  PRE  (($select-path ($select values 0 1) $postfix-star))
  PAR  (#(struct:surf-select #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 6 1)) (((@ord 0)) ((@ord 1))) block #(struct:srcloc "<p>" 1 6 1)) (((@star flatten))) path #(struct:srcloc "<p>" 1 0 12)))
