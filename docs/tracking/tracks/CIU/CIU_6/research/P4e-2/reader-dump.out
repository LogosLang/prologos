  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var *_ #(struct:srcloc "<p>" 1 7 2))) #(struct:srcloc "<p>" 1 0 9)))
values:*-
  PRE  ((values : *-))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var *- #(struct:srcloc "<p>" 1 7 2))) #(struct:srcloc "<p>" 1 0 9)))
values:*-_
  PRE  ((values : *-_))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var *-_ #(struct:srcloc "<p>" 1 7 3))) #(struct:srcloc "<p>" 1 0 10)))
values:*:*
  PRE  ((values : * : *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-var : #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values:*:name
  PRE  ((values : ($select-path * ($bcast-step :name))))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-select #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) (((@bcast name))) path #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 13)))
values.0:*
  PRE  (((get values 0) : *))
  PAR  (#(struct:surf-app #(struct:surf-get #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 0 6)) #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values:k*
  PRE  (($select-path values ($bcast-step :k*)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k) (@star flatten))) path #(struct:srcloc "<p>" 1 0 9)))
values:k*_
  PRE  (($select-path values ($bcast-step :k*_)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k) (@star flatten-synth))) path #(struct:srcloc "<p>" 1 0 10)))
values:k*-
  PRE  (($select-path values ($bcast-step :k*-)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k) (@star flatten-collapse))) path #(struct:srcloc "<p>" 1 0 10)))
values:k*-_
  PRE  (($select-path values ($bcast-step :k*-_)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k) (@star flatten-collapse-synth))) path #(struct:srcloc "<p>" 1 0 11)))
values:k:*
  PRE  ((($select-path values ($bcast-step :k)) : *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k))) path #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values:k*:name
  PRE  (($select-path ($select-path values ($bcast-step :k*)) ($bcast-step :name)))
  PAR  (#(struct:surf-select #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 6 0)) (((@bcast k) (@star flatten))) path #(struct:srcloc "<p>" 1 6 3)) (((@bcast name))) path #(struct:srcloc "<p>" 1 0 14)))
values:k*.0
  PRE  ((get ($select-path values ($bcast-step :k*)) 0))
  PAR  (#(struct:surf-get #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 6 0)) (((@bcast k) (@star flatten))) path #(struct:srcloc "<p>" 1 6 3)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 9 2)) #(struct:srcloc "<p>" 1 0 11)))
values:k*{a b}
  PRE  (($select ($select-path values ($bcast-step :k*)) a b))
  PAR  (#(struct:surf-select #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (((@bcast k) (@star flatten))) path #(struct:srcloc "<p>" 1 0 6)) ((a) (b)) block #(struct:srcloc "<p>" 1 0 10)))
values:k**
  PRE  (($select-path values ($bcast-step :k**)))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 10) "`k**` — `*` is the layer-delete operator and attaches at the END of a segment, so `k**` is neither a field nor an operator. A field literally named `k**` is reached with `[map-get x :k**]`" #f))
values:k*^
  PRE  (($select-path values ($bcast-step :k*^)))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 10) "`k*^` — `*` is the layer-delete operator and attaches at the END of a segment, so `k*^` is neither a field nor an operator. A field literally named `k*^` is reached with `[map-get x :k*^]`" #f))
values:k*x
  PRE  (($select-path values ($bcast-step :k*x)))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 10) "`k*x` — `*` is the layer-delete operator and attaches at the END of a segment, so `k*x` is neither a field nor an operator. A field literally named `k*x` is reached with `[map-get x :k*x]`" #f))
values:*.0
  PRE  ((values : (get * 0)))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-get #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-int-lit 0 #(struct:srcloc "<p>" 1 7 1)) #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 10)))
values:*{a b}
  PRE  ((values : ($select * a b)))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-select #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) ((a) (b)) block #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 9)))
values:**:name
  PRE  ((values : ($select-path ** ($bcast-step :name))))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-select #(struct:surf-var ** #(struct:srcloc "<p>" 1 7 2)) (((@bcast name))) path #(struct:srcloc "<p>" 1 7 2))) #(struct:srcloc "<p>" 1 0 14)))
values:*-_:k
  PRE  ((values : ($select-path *-_ ($bcast-step :k))))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-select #(struct:surf-var *-_ #(struct:srcloc "<p>" 1 7 3)) (((@bcast k))) path #(struct:srcloc "<p>" 1 7 3))) #(struct:srcloc "<p>" 1 0 12)))
values{a:*}
  PRE  (($select values a : *))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 7) "block keys are written bare — `x{}`, not `x{:}`" #f))
values{a:k*}
  PRE  (($select values a ($bcast-step :k*)))
  PAR  (#(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) ((a (@bcast k) (@star flatten))) block #(struct:srcloc "<p>" 1 0 7)))
y{a.0:*}
  PRE  (($select y a ($postfix-index 0) : *))
  PAR  (#(struct:parse-error #(struct:srcloc "<p>" 1 0 2) "block keys are written bare — `x{}`, not `x{:}`" #f))
values.a:*
  PRE  ((($select-path values a) : *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) ((a)) path #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values{a}:*
  PRE  ((($select values a) : *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) ((a)) block #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 9 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 10 1))) #(struct:srcloc "<p>" 1 0 11)))
values{a}:k*
  PRE  (($select-path ($select values a) ($bcast-step :k*)))
  PAR  (#(struct:surf-select #(struct:surf-select #(struct:surf-var values #(struct:srcloc "<p>" 1 6 1)) ((a)) block #(struct:srcloc "<p>" 1 6 1)) (((@bcast k) (@star flatten))) path #(struct:srcloc "<p>" 1 0 12)))
