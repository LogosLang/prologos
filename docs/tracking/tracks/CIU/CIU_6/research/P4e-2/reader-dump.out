  PRE  ((($select-path x y) : *))
  PAR  (#(struct:surf-app #(struct:surf-select #(struct:surf-var x #(struct:srcloc "<p>" 1 0 1)) ((y)) path #(struct:srcloc "<p>" 1 0 1)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 3 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 4 1))) #(struct:srcloc "<p>" 1 0 5)))
(values):*
  PRE  (((values) : *))
  PAR  (#(struct:surf-app #(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 1 6)) () #(struct:srcloc "<p>" 1 1 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 8 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 1 9)))
[f x]:*
  PRE  (((f x) : *))
  PAR  (#(struct:surf-app #(struct:surf-app #(struct:surf-var f #(struct:srcloc "<p>" 1 1 1)) (#(struct:surf-var x #(struct:srcloc "<p>" 1 3 1))) #(struct:srcloc "<p>" 1 1 3)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 5 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 6 1))) #(struct:srcloc "<p>" 1 1 6)))
[f values:*]
  PRE  ((f values : *))
  PAR  (#(struct:surf-app #(struct:surf-var f #(struct:srcloc "<p>" 1 1 1)) (#(struct:surf-var values #(struct:srcloc "<p>" 1 3 6)) #(struct:surf-var : #(struct:srcloc "<p>" 1 9 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 10 1))) #(struct:srcloc "<p>" 1 1 10)))
values:* x
  PRE  ((values : * x))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var : #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1)) #(struct:surf-var x #(struct:srcloc "<p>" 1 9 1))) #(struct:srcloc "<p>" 1 0 10)))
values.*
  PRE  ((values |.| *))
  PAR  (#(struct:surf-app #(struct:surf-var values #(struct:srcloc "<p>" 1 0 6)) (#(struct:surf-var |.| #(struct:srcloc "<p>" 1 6 1)) #(struct:surf-var * #(struct:srcloc "<p>" 1 7 1))) #(struct:srcloc "<p>" 1 0 8)))
