ns probe-p4e2-b
;; P4e-2 — controls for probe-p4e2-a. Output line N = the Nth top-level form.
def values := @[@[1 2 3] @[4 5 6] @[7 8 9]]
def m := {:a {:x 1} :b {:y 2}}
;; the out-of-range panic (a:15) — without the star, and in path position
values{0 1 2 3}
values{3}
values{3}*
values.3
;; candidate identity steps (none is expected to exist)
values:*
values{}*
values:{}*
;; the route outside the path language
[concat '[1 2] '[3]]
[prologos::data::list::concat '['[1 2] '[3]]]
m:x
