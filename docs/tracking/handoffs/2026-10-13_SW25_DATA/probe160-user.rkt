#lang racket/base
;; DEFERRED 160, user-facing shapes of the driver-level leak (no test-support anywhere):
;;  A. the LSP re-check: the SAME file is checked twice in one process (lsp/server.rkt:561 per edit);
;;     version 1 has `spec f`, the user deletes it and annotates inline (version 2).
;;  B. the CLI: `racket driver.rkt s.prologos v.prologos` (driver.rkt:3921 loops process-file).
;; Run: timeout -k 10 300 racket probe160-user.rkt <checkout>/racket/prologos
(require racket/file racket/string racket/port racket/system)
(define root (vector-ref (current-command-line-arguments) 0))
(define (dr mod sym) (dynamic-require (string->path (string-append root "/" mod)) sym))
(define process-file (dr "driver.rkt" 'process-file))
(define prologos-error? (dr "errors.rkt" 'prologos-error?))
(define prologos-error-message (dr "errors.rkt" 'prologos-error-message))
(define dir (make-temporary-file "probe160u-~a" 'directory))
(define (write! name src) (define p (build-path dir name)) (call-with-output-file p #:exists 'truncate (λ (o) (display src o))) p)
(define (check label p)
  (define rs (parameterize ([current-output-port (open-output-nowhere)] [current-error-port (open-output-nowhere)])
               (process-file p #:evaluate? #f)))
  (define errs (filter prologos-error? rs))
  (printf "~a -> ~a\n" label
          (if (null? errs) (format "ok: ~a" (car (reverse rs)))
              (string-join (for/list ([e errs]) (let ([m (prologos-error-message e)]) (substring m 0 (min 100 (string-length m))))) " | ")))
  (null? errs))
(define v1 "ns doc\nspec f Nat -> Nat\ndefn f [x] [suc x]\n")
(define v2 "ns doc\ndefn f [x : Nat] : Nat [suc x]\n")
(printf "A. LSP re-check of one file (same path, same ns)\n")
(define p (write! "doc.prologos" v2))
(define a0 (check "  A0. version 2 alone, fresh                 " p))
(write! "doc.prologos" v1)
(define a1 (check "  A1. version 1 (spec f + defn f)            " p))
(write! "doc.prologos" v2)
(define a2 (check "  A2. version 2 (spec deleted, inline types) " p))
(printf "  VERDICT A: ~a\n" (cond [(not (and a0 a1)) "INCONCLUSIVE"] [a2 "no stale spec"] [else "STALE SPEC: the deleted spec still applies on re-check"]))
(printf "B. CLI with two files: racket driver.rkt s.prologos v.prologos\n")
(define s (write! "s.prologos" "ns test\nspec ok2 Nat -> Nat\ndefn ok2\n  | zero -> 1N\n  | suc _ -> 2N\n"))
(define v (write! "v.prologos" "ns t\ndefn ok2\n  | zero -> 1\n  | suc _ -> 2\n"))
(define racket (find-executable-path (find-system-path 'exec-file)))
(define (cli . files)
  (define o (open-output-string))
  (parameterize ([current-output-port o] [current-error-port o])
    (apply system* racket (string-append root "/driver.rkt") (map path->string files)))
  (for/list ([l (string-split (get-output-string o) "\n")] #:when (regexp-match? #rx"defined|rror|cannot" l)) (substring l 0 (min 100 (string-length l)))))
(printf "  B1. v alone:    ~s\n" (cli v))
(printf "  B2. s then v:   ~s\n" (cli s v))
(delete-directory/files dir)
