#!/usr/bin/env bash
#
# pre-commit — fast lint gates on staged .rkt files
#
# Two gates, both fast (each ~1s for typical staged set):
#   1. tools/check-parens.sh        — delimiter balance via Racket's reader
#   2. tools/check-stdout-clean.rkt — module-load stdout pollution
#
# Bypass: git commit --no-verify  (emergencies only).
#
# Per ~/.claude/rules/workflow.md, hooks should never be skipped
# routinely — failures indicate real bugs that must be fixed.
#
# Origin:
#   - check-parens: surfaced 2026-04-27 after commit d7bd97a4 (S2.e-iv-c
#     mechanical sed surgery) introduced unbalanced parens in 5 bench
#     files outside targeted-tests verification, breaking `raco pkg install`
#     and downstream CI on every open PR. PR #29 fixed the immediate bug;
#     this hook prevents recurrence.
#   - check-stdout-clean: surfaced 2026-04-28 — VS Code LSP failed with
#     "Header must provide a Content-Length property" because 5 top-level
#     (verify-rewrite-rule ...) calls in sre-rewrite.rkt printed #t to
#     stdout at module load, corrupting LSP's JSON-RPC framing. Commit
#     1fe1422f fixed; this hook prevents recurrence.

set -e

RACKET="/Applications/Racket v9.3/bin/racket"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "pre-commit: not inside a git repository" >&2
  exit 1
fi

# ============================================================
# Gate 0: TREE-SITTER GRAMMAR DRIFT TRIPWIRE
# ============================================================
#
# WARNS (never blocks) when a commit changes the surface-syntax reader/parser
# but not the tree-sitter grammar.
#
# Why this exists: the grammar drifted FIVE MONTHS behind the language with no
# signal at all, because tree-sitter never fails — it recovers, emits ERROR
# nodes, and every consumer (font-lock, folding, the surfer) degrades silently.
# By the time TSG Track 1 measured it, 87% of the corpus mis-parsed. The signal
# has to fire when the drift is CREATED; a corpus scan months later is an
# autopsy, not an alarm.
#
# Warn rather than block, deliberately: plenty of parser edits are internal and
# imply no grammar change, and a hook that cries wolf gets bypassed reflexively.
staged_all=$(git diff --cached --name-only --diff-filter=AM || true)
# 1b-v-C: reader-forms.rkt added — it is where the star family's spellings LIVE
# (one table), so a spelling can now be added without touching parser.rkt at all;
# without this line a table-only widening would slip past the tripwire (fail-open).
surface_touched=$(echo "$staged_all" | grep -E 'racket/prologos/(parse-reader|tree-parser|parser|macros|surface-syntax|reader-forms)\.rkt$' || true)
grammar_touched=$(echo "$staged_all" | grep -E 'editors/tree-sitter-prologos/(grammar\.js|src/scanner\.c)$' || true)
if [ -n "$surface_touched" ] && [ -z "$grammar_touched" ]; then
  echo "" >&2
  echo "⚠  tree-sitter grammar drift tripwire" >&2
  echo "   This commit changes the surface reader/parser:" >&2
  echo "$surface_touched" | sed 's/^/     /' >&2
  echo "   but does NOT touch editors/tree-sitter-prologos/grammar.js." >&2
  echo "" >&2
  echo "   If it adds or changes USER-FACING SYNTAX, the grammar needs the same" >&2
  echo "   change — otherwise editor support degrades silently for that syntax." >&2
  echo "   Update the grammar and run ./install.sh && ./check-corpus.sh, or file" >&2
  echo "   a DEFERRED entry saying why not." >&2
  echo "   (Internal parser refactors legitimately need nothing — this is a" >&2
  echo "    warning, not a gate.)" >&2
  echo "" >&2
fi

# Get staged .rkt files (added or modified, not deleted)
files=$(git diff --cached --name-only --diff-filter=AM | grep '\.rkt$' || true)

if [ -z "$files" ]; then
  # No .rkt files staged — nothing to check
  exit 0
fi

# Gate 1: paren balance on the staged files
"$REPO_ROOT/tools/check-parens.sh" $files

# Gate 2: stdout-clean check on the staged files
# Skip if no production .rkt files staged (the racket script also filters,
# but checking here saves a Racket startup when only tests/benchmarks staged)
prod_files=$(echo "$files" | grep -v -E '/(tests|benchmarks|examples|tools|lib)/' || true)
if [ -n "$prod_files" ]; then
  "$RACKET" "$REPO_ROOT/tools/check-stdout-clean.rkt" $prod_files
fi
