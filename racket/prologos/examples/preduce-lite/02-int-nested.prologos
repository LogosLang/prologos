def main : Int := [int- [int+ 10 5] [int* 2 3]]

;; PReduce-lite Phase 2: nested int arithmetic. (10 + 5) - (2 * 3) = 9.
;; Two int-add/mul propagators fire concurrently in round 1; their outputs
;; feed the int-sub propagator in round 2. Validates dataflow ordering
;; emerges from the network topology, not from imperative sequencing.
;; nf-equivalent: (expr-int 9)
;; :expect-exit 9
