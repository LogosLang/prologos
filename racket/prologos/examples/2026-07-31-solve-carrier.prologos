;; ============================================================================
;; Rel/CIU seam spin-out — the SOLVE CARRIER: List → PVec
;; docs/tracking/2026-07-31_SOLVE_CARRIER_SPINOUT.md
;;
;; Acceptance file. Run:   racket tools/run-file.rkt examples/2026-07-31-solve-carrier.prologos
;; Check:                  racket tools/run-file.rkt --check examples/2026-07-31-solve-carrier.prologos
;;
;; Written against the TARGET state (Phase 0, failing-test-first): every §A/§B
;; marker below is expected to FAIL at base HEAD cab30b9a and pass after P1;
;; every §D marker fails until P2.
;; ============================================================================

ns solve-carrier

;; ───────────────────────────────────────────────────────────────────────────
;; §A  THE CARRIER — solve returns PVec
;; ───────────────────────────────────────────────────────────────────────────

defr quest [?title ?giver ?reward]
  || "Rescue the cat"      "Alice" 50
     "Map the catacombs"   "Bob"   200
     "Debug the compiler"  "Alice" 9000
;;0=> quest : _ defined.

solve (quest t g r)
;;1=> @[{:t "Rescue the cat", :g "Alice", :r 50} {:t "Map the catacombs", :g "Bob", :r 200} {:t "Debug the compiler", :g "Alice", :r 9000}] : [PVec {:g String :r Int :t String}]

;; the declaration-order echo (Rel T1 POL.3) survives the carrier change —
;; keys read t, g, r (the goal's positional query vars), NOT champ-hash order.
solve (quest t "Alice" r)
;;2=> @[{:t "Rescue the cat", :r 50} {:t "Debug the compiler", :r 9000}] : [PVec {:r Int :t String}]

;; a def-bound solve result carries the PVec type
def quests := solve (quest t g r)
;;3=> quests : [PVec {:g String :r Int :t String}] defined.

;; implicit solve on a def RHS (Rel T1 POL.10) — same carrier
def alice-quests := (quest t "Alice" r)
;;4=> alice-quests : [PVec {:r Int :t String}] defined.

;; ───────────────────────────────────────────────────────────────────────────
;; §B  WHY — solve rows now compose with the NATIVE PVec machinery
;; ───────────────────────────────────────────────────────────────────────────

;; pvec-map is a native AST primitive (reduces via rrb-fold) — no List round-trip
pvec-map [fn [q] q.r] quests
;;5=> @[50 200 9000] : [PVec Int]

pvec-map [fn [q] q.t] alice-quests
;;6=> @["Rescue the cat" "Debug the compiler"] : [PVec String]

[pvec-length-int quests]
;;7=> 3 : Int

[pvec-nth-int quests 0]
;;8=> [prologos::data::option::some {:g String :r Int :t String} {:t "Rescue the cat", :g "Alice", :r 50}] : [prologos::data::option::Option {:g String :r Int :t String}]

;; the List reading is still one explicit hop away
[pvec-to-list-fn alice-quests]
;;9=> '[{:t "Rescue the cat", :r 50} {:t "Debug the compiler", :r 9000}] : [prologos::data::list::List {:r Int :t String}]

;; ───────────────────────────────────────────────────────────────────────────
;; §C  INVARIANTS THE FLIP MUST NOT BREAK
;; ───────────────────────────────────────────────────────────────────────────

;; C1 — BAG semantics (Rel T1 POL.1): one row per derivation path. Duplicate
;; rows are INTENDED (the multiplicity IS the derivation count). PVec is
;; ordered and duplicate-bearing, so this is preserved, not merely unharmed.
defr twice [?n]
  || 1
     1
     2
;;10=> twice : _ defined.

solve (twice n)
;;11=> @[{:n 1} {:n 1} {:n 2}] : [PVec {:n Int}]

;; C2 — the EMPTY result set. Was `nil` (a nullary List constructor carrying no
;; container identity); now an empty PVec that still announces its row type.
solve (quest t "Nobody" r)
;;12=> @[] : [PVec {:r Int :t String}]

;; C3 — solve-one is UNCHANGED: a bare row champ (D25.4-unwrapped), not a
;; container at all. R2 in the tracking doc.
solve-one (quest t "Bob" r)
;;13=> {:t "Map the catacombs", :r 200} : {:r Int :t String}

;; C4 — solve-one on an empty result stays `none`
solve-one (quest t "Nobody" r)
;;14=> none : {:r Int :t String}

;; C5 — explain FLIPS WITH solve (R1). Rows carry the conditional metadata keys
;; under a 'dyn tail, which is why the displayed row type ends `| _`.
explain (quest t "Bob" r)
;;15=>~ @[{:t "Map the catacombs", :r 200, :provenance

;; C6 — THE CAPTURE-GAP PIN. The B3.2 coinductive display refinement must still
;; fire through the new carrier. `:v` is statically a UNION (the fact rows
;; disagree), so a query returning only Int rows SHARPENS the *echoed* type to
;; Int while the *stored* type stays the union. That divergence between marker
;; 18 (def, static) and marker 19 (echo, observed) is the whole signal: it can
;; only appear if display-row-type-parts AND display-result-rows both walk the
;; PVec carrier. Miss either and 19 silently degrades to the union — no error.
defr val [?k ?v]
  || :a 1
     :b "two"
;;16=> val : _ defined.

solve (val k v)
;;17=> @[{:k :a, :v 1} {:k :b, :v "two"}] : [PVec {:k Keyword :v Int | String}]

def only-a := solve (val :a v)
;;18=> only-a : [PVec {:v Int | String}] defined.

solve (val :a v)
;;19=> @[{:v 1}] : [PVec {:v Int}]

;; ───────────────────────────────────────────────────────────────────────────
;; §D  THE `let` IMPLICIT-SOLVE GAP  (P2)
;; ───────────────────────────────────────────────────────────────────────────

;; D1 — explicit solve in a let RHS: worked before, must keep working
let ls := solve (quest t "Bob" r)
  ls
;;20=> @[{:t "Map the catacombs", :r 200}] : [PVec {:r Int :t String}]

;; D2 — implicit solve in a let RHS (nested shorthand). Was `Unbound variable t`.
let li := (quest t "Bob" r)
  li
;;21=> @[{:t "Map the catacombs", :r 200}] : [PVec {:r Int :t String}]

;; D3 — implicit solve in an ALIGNED let block, alongside an ordinary binding
let la (quest t "Bob" r)
    n 7
  [pvec-length-int la]
;;22=> 1 : Int

;; D4 — implicit solve in the BRACKET let form
let [lb := (quest t "Alice" r)] [pvec-length-int lb]
;;23=> 2 : Int

;; D5 — SCOPE BOUND: implicit solve is a BINDING-RHS rule, not a general
;; expression-position rule. A paren group in argument position stays
;; application/term, so this is an ordinary unbound-variable error — NOT a
;; silent re-query of the ambient fact store.
[pvec-length-int (quest t "Bob" r)]
;;24=>~ ERROR:

;; NOTE (out of scope, pre-existing): a top-level `let` SIBLING CHAIN
;; (`let p := 1` / `let q := 2` / indented body) fails with "`let` is not
;; allowed at top level" regardless of goals — the plain arithmetic case fails
;; identically at cab30b9a. That is a LET-track gap, not a solve-carrier one;
;; recorded in the tracking doc §6 rather than fixed here.
