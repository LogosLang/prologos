;; ============================================================================
;; CIU T6 F1b.5 — VALIDATE acceptance (skeleton laid at p0, 2026-07-17)
;;
;; The Result-returning runtime tabulation face (D27–D29, track doc §2a round
;; 7; design doc §13.8). Sections fill in per slice — commented target
;; expressions uncommented as slices land (the F1a acceptance pattern).
;; Lives apart from the main/seal files per the hang discipline (DEFERRED.md
;; § union-type hang): clean state here. Suite gate lands with s2.
;; ============================================================================

ns f1b5-validate-acceptance :no-prelude

;; --- schemas (register today; exercised by the slices) ----------------------

schema Person
  :name String
  :age Int
;;0=> Person : [Type 0] defined.

schema Cfg
  :host String :default "localhost"
  :port Int :default 8080
;;1=> Cfg : [Type 0] defined.

schema Checked
  :name String
  :age Int :check (> _ 0)
;;2=> Checked : [Type 0] defined.

;; --- s1: field-type repairs (angle-sentinel + bare-head qualification) ------
;; Rich-field schemas register AND construct after the s1 repairs (pre-s1:
;; both classes registered but EVERY construction failed — the p0 probes).
;; Container-field ((List Int)) coverage lives in the prelude-loaded rackunit
;; file (tests/test-schema-field-construction.rkt) — this file is :no-prelude.

schema WithUnion
  :v <Int | String>
;;3=> WithUnion : [Type 0] defined.

def wi : WithUnion := {:v 3}
;;4=> wi : f1b5-validate-acceptance::WithUnion defined.

wi.v
;;5=> 3 : Int | String
;;   ← the union field converts (pre-s1: mangled $angle-type/$pipe sentinels)

def ws : WithUnion := {:v "x"}
;;6=> ws : f1b5-validate-acceptance::WithUnion defined.

schema WithFn
  :name String
  :cb <Int -> Int>
;;7=> WithFn : [Type 0] defined.

spec idi Int -> Int
defn idi [x] x
;;8=> idi : Int -> Int defined.

def wf : WithFn := {:name "a" :cb idi}
;;9=> wf : f1b5-validate-acceptance::WithFn defined.
;;   ← arrow fields are EXPRESSIBLE + constructible (type-witness at runtime
;;     = the D28 skip set; the skip-set-empty test governs)

[wf.cb 4]
;;10=> 4 : Int

;; --- s2: the node — freestanding validate (THE DEMO BEAT) -------------------
;;
;; def m := [map-assoc [map-assoc {} :name "alice"] :age 30]
;; [validate Person m]
;; s2=> ok {...} : Result Person (Map Keyword Reason)
;;
;; def bad := [map-assoc [map-assoc {} :name "bob"] :age "x"]
;; [validate Person bad]
;; s2=> err {:age (type-mismatch ...)} — collect-all; field identity structural
;;
;; [validate Cfg {}]
;; s2=> ok — defaults FILL in the runtime tabulation (non-literal-safe)
;;
;; [validate Checked {:name "dave" :age 0}]
;; s2=> err {:age (check-failed ...)} — :check as recoverable Result, not panic

;; --- s3: the door flip — constructor = static-seal + validate + abort -------
;;
;; def cbad := [Checked {:name "dave" :age 0}]
;; s3=> still errors at commit (sealed definition forced) — via the NODE now;
;;      wrap-schema-checks is DELETED; message parity on single failures

