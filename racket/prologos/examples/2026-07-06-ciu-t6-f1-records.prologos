ns f1-records-acceptance :no-prelude

;; ============================================================================
;; CIU Track 6 F1 — Structural Record Typing: ACCEPTANCE FILE (Phase 0)
;; Design: docs/tracking/2026-07-06_CIU_T6_F1_STRUCTURAL_RECORDS_DESIGN.md §4.7
;;
;; Expectations use `;;N=>` (exact) / `;;N=>~` (contains) markers checked by
;;   racket tools/run-file.rkt --check examples/2026-07-06-ciu-t6-f1-records.prologos
;; N = the result index printed by run-file.rkt. Current expectations = PRE-F1a
;; baseline behavior; each F1a slice flips the marked lines (F1a targets are on
;; the adjacent `;;   F1a:` comment lines).
;; ============================================================================

;; --- fixtures -------------------------------------------------------------

schema Point
  :x Posit32
  :y Posit32

;;0=>~ Point : [Type 0] defined.

def q := {:a 1}
;;1=>~ q : {:a Int}

q.a
;;2=> 1 : Int

;; --- V5: arithmetic on a projected field (errors pre-F1a) ------------------

+ q.a 1
;;3=> 2 : Int

;; --- nested records ---------------------------------------------------------

def m := {:a {:a1 1} :b {:b1 11}}
;;4=>~ m : {:a {:a1 Int} :b {:b1 Int}}

m.a.a1
;;5=> 1 : Int

;; --- heterogeneous literal: per-field beats uniform-join --------------------

def het := {:n 1 :s "x"}
;;6=>~ het : {:n Int :s String}

het.n
;;7=> 1 : Int

het.s
;;8=> "x" : String

;; het.z   ← F1a: closed-row miss = type error naming available fields; add at s2

;; --- annotated + schema paths (MUST STAY GREEN — already concrete today) ----

def am : (Map Keyword Int) := {:a 1}
;;9=>~ Map Keyword Int

am.a
;;10=> 1 : Int

def p : Point := {:x 1.0 :y 2.0}
;;11=>~ Point

p.x
;;12=> 1.0 : Posit32

;; --- annotation-satisfaction canaries (the Record<:Map subsumption arm) -----

spec idm (Map Keyword Int) -> (Map Keyword Int)
defn idm [mm] mm
;;13=>~ idm

idm {:a 1}
;;14=> {:a 1} : [Map Keyword Int]

def r := {:a 1 :b 2}
;;15=>~ r : {:a Int :b Int}

idm r
;;16=> {:a 1, :b 2} : [Map Keyword Int]
;;   ← THE regression canary: inferred-map-vs-Map-annotation must stay green
;;     when r infers {:a Int :b Int} (via V := ⋃fields union-join)

;; --- map-op surfaces at :no-prelude (WS wiring probe + F1a-s3 targets) ------

map-assoc q :b "hi"
;;17=> {:a 1, :b "hi"} : {:a Int :b String}

map-dissoc q :a
;;18=> {} : {}

map-keys het
;;19=> '[:n :s] : [List Keyword]

map-vals het
;;20=> '[1 "x"] : [List Int | String]

map-size het
;;21=>~ Nat

map-has-key? het :n
;;22=>~ Bool

nil-safe-get q :a
;;23=> 1 : Int | Nil

get-in m #p(a.a1)
;;24=> 1 : Int

;; --- empty literal stays legacy in F1a (deliberate, design §4.2) ------------

def e : (Map Keyword Int) := {}
;;25=>~ Map Keyword Int

foreign racket "racket/base" :as time
  [current-inexact-monotonic-milliseconds :as ms : Float64]

[time/ms]

.((3.14p + 3.13p) * 40)

;; --- closed-row miss (F1a-s2): projecting an absent field is a type error ---
;; (appended at file END so the ;;N=> indices above don't renumber)
het.z
;;28=>~ ERROR

