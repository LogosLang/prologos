ns rel-t1-acceptance

;; ============================================================================
;; Rel Track 1 — Relational Language Usability — Aspect-A (NAF/guard) acceptance
;; ============================================================================
;; Run:   racket tools/run-file.rkt examples/2026-07-19-rel-t1-acceptance.prologos
;; Check: racket tools/run-file.rkt --check examples/2026-07-19-rel-t1-acceptance.prologos
;;
;; Aspect-A fix = E-with-B (belief-layer per-binding NAF narrowing). The bug is
;; the on-network Tier-2 single-bit collapse, with TWO faces:
;;   {both}    over-include  (fact generator picks an unblocked binding)
;;   {neither} over-exclude  (body-local join picks a blocked binding)
;; Recursive / all-ground NAF route to DFS/WF and are ALREADY correct.
;;
;; Markers tagged  (TARGET, post-A.2)  encode the CORRECT answer — they FAIL
;; pre-fix (documenting the collapse) and pass once A.2 lands. Correct-now
;; markers pass today and must keep passing.
;; ============================================================================

;; ---- fact-generator NAF: the canonical repro ------------------------------
defr vehicle [?type]
  || "bicycle"
     "automobile"

defr license [?v]
  || "automobile"

;; ---- A.1: top-level bare NAF goal (was echoed unevaluated; now runs via DFS) --
;; bicycle is NOT licensed → NAF succeeds → one empty-binding answer
;;2=> '[{}] : _
solve (not (license "bicycle"))
;; automobile IS licensed → NAF fails → no answers
;;3=> nil : _
solve (not (license "automobile"))

defr light-vehicle [?v]
  &> (vehicle v) (not (license v))

;; ground queries route to DFS — CORRECT NOW (must stay green)
;;5=> '[{}] : _
solve (light-vehicle "bicycle")
;;6=> nil : _
solve (light-vehicle "automobile")

;; free-var (on-network Tier-2, FACT generator): FIXED by A.2 core (was {both})
;;7=> '[{:lv "bicycle"}] : _
solve (light-vehicle lv)

;; ---- body-local join NAF: over-exclude {neither} pre-fix ------------------
defr edge [?a ?b]
  || "x" "y"
     "y" "z"
     "y" "w"

defr blk [?n]
  || "z"

defr twohop [?a ?c]
  &> (edge a b) (edge b c)

defr safe-twohop [?a ?c]
  &> (twohop a c) (not (blk c))

;; twohop(x)={z,w}, blk={z}  (TARGET, A.2b): '[{:c "w"}] : _
;; A.2b — the RULE generator `twohop` does NOT materialize c's per-branch tags on
;; the shared scope cell (probe: resolves to a single collapsed value), so A.2's
;; per-binding enumeration can't fire and it falls back to the single-bit path
;; ({neither} = nil). Needs the DFS-defer (design §5 A.2 boundary).
solve (safe-twohop "x" c)

;; ---- recursive NAF: ALSO on-network (NAF forces it) — ALSO buggy ----------
defr reaches [?a ?c]
  &> (edge a c)
  &> (edge a b) (reaches b c)

;; confirm the generator set: reaches(x) = {y, z, w}
solve (reaches "x" c)

defr safe-reach [?a ?c]
  &> (reaches a c) (not (blk c))

;; reaches(x)={y,z,w}, blk={z}  (TARGET, A.2b): '[{:c "w"} {:c "y"}] : _
;; A.2b — same as safe-twohop: the RECURSIVE generator `reaches` under-tags c.
;; pre-fix DROPS w (a third collapse face) — recursion does NOT save it.
solve (safe-reach "x" c)
