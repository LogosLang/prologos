ns rel-t1-acceptance

;; ============================================================================
;; Rel Track 1 — Relational Language Usability — Aspect-A (NAF/guard) acceptance
;; ============================================================================
;; Run:   racket tools/run-file.rkt examples/2026-07-19-rel-t1-acceptance.prologos
;; Check: racket tools/run-file.rkt --check examples/2026-07-19-rel-t1-acceptance.prologos
;;
;; Aspect-A NAF correctness has TWO landed fixes:
;;   A.2-core (E-with-B, belief-layer per-binding narrowing): FACT-generator NAF,
;;     on-network — fixes the {both} over-include (`light-vehicle` → {bicycle}).
;;   A.2b minimal slice (adaptive-dispatch DFS-routing): NAF/guard over a RULE
;;     generator with a body-local (non-param) join/recursion var is INCOMPLETE on
;;     the on-network engine (a join → {}, recursion → base case only), so the
;;     dispatcher routes those to DFS (correct). Scaffolding — retirement owner is
;;     BSP-LE Track 3 (on-network body-local threading + SLG completion).
;;
;; `;;N=>` markers encode the CORRECT answer and are checked by `--check`.
;; ============================================================================

;; ---- fact-generator NAF: the canonical repro ------------------------------
defr vehicle [?type]
  || "bicycle"
     "automobile"

defr license [?v]
  || "automobile"

;; ---- A.1: top-level bare NAF goal (was echoed unevaluated; now runs via DFS) --
;; bicycle is NOT licensed → NAF succeeds → one empty-binding answer
;;2=> @[{}] : _
solve (not (license "bicycle"))
;; automobile IS licensed → NAF fails → no answers
;;3=> @[] : _
solve (not (license "automobile"))

defr light-vehicle [?v]
  &> (vehicle v) (not (license v))

;; ground queries route to DFS — CORRECT NOW (must stay green)
;;5=> @[{}] : _
solve (light-vehicle "bicycle")
;;6=> @[] : _
solve (light-vehicle "automobile")

;; free-var (on-network Tier-2, FACT generator): FIXED by A.2 core (was {both})
;;7=> @[{:lv "bicycle"}] : [PVec {:lv String}]
solve (light-vehicle lv)

;; ---- body-local join NAF: over-exclude {neither} pre-fix ------------------
defr edge [?a ?b]
  || "x" "y"
     "y" "z"
     "y" "w"

defr blk [?n]
  || "z"

defr twohop [?a ?c]
  &> (edge a b) (edge b c)

defr safe-twohop [?a ?c]
  &> (twohop a c) (not (blk c))

;; twohop(x)={z,w}, blk={z} → {w}. FIXED (A.2b minimal slice): `twohop` is a rule
;; with a body-local join var `b` the on-network engine can't thread (empty on-
;; network), so the adaptive dispatcher now routes NAF over body-local-var rules to
;; DFS, which threads `b` correctly. Scaffolding — retires with BSP-LE Track 3.
;;12=> @[{:c "w"}] : [PVec {:c String}]
solve (safe-twohop "x" c)

;; ---- recursive NAF: ALSO on-network (NAF forces it) — ALSO buggy ----------
defr reaches [?a ?c]
  &> (edge a c)
  &> (edge a b) (reaches b c)

;; generator set (DFS): reaches(x) = {y, z, w}
;;14=> @[{:c "y"} {:c "z"} {:c "w"}] : [PVec {:c String}]
solve (reaches "x" c)

defr safe-reach [?a ?c]
  &> (reaches a c) (not (blk c))

;; reaches(x)={y,z,w}, blk={z} → {y,w}. FIXED (A.2b minimal slice): recursive
;; `reaches` has a body-local recursion var → routed to DFS (correct). Scaffolding —
;; retires with BSP-LE Track 3.
;;16=> @[{:c "y"} {:c "w"}] : [PVec {:c String}]
solve (safe-reach "x" c)

;; ---- A.4: guard over a multi-fact generator (routed to DFS) ---------------
defr weighted-edge [?from ?to ?weight]
  || "a" "b" 3
     "b" "c" 0
     "c" "d" 5

defr positive-edge [?from ?to ?weight]
  &> (weighted-edge from to weight) (guard [gt weight 0])

;; weighted-edge has a w=0 edge; the guard keeps weight>0. On-network the single
;; shared guard bit cannot filter per-row (it leaks or over-narrows), so Check 4
;; (reachable-has-guard?) routes guard-bearing queries to DFS, which filters
;; per-row. FIXED (A.4). Scaffolding — retires with BSP-LE Track 3 (the on-network
;; guard design is captured in the Track 3 note).
;;19=> @[{:from "a", :to "b", :w 3} {:from "c", :to "d", :w 5}] : [PVec {:from String :to String :w Int}]
solve (positive-edge from to w)

;; ---- POL.2 (B3.0): anon `_` vars are projection-excluded from solution rows --
;; `_` mints a fresh solver-visible logic var per occurrence (answer COUNT
;; unchanged — duplicates preserved; dedup = POL.1, separate), but its
;; `:_anonNNN` gensym key must NOT appear in any row. Kernel-level filter
;; (reduction.rkt row-query-vars) so runtime rows + B3 static labels agree.
;; POL.2: no :_anon key, and no :w key (the `_` position is not projected)
;;20=> @[{:from "a"} {:from "c"}] : [PVec {:from String}]
solve (positive-edge from _ _)

;; all-anon -> membership-style empty rows, one per solution
;;21=> @[{} {}] : _
solve (positive-edge _ _ _)

;; ---- B3.1: rule-relation solutions are STATICALLY TYPED (body-goal dataflow) --
;; The B2-deferred half, delivered: rule rows derive an UPPER BOUND through the
;; body's generators (schema/B1 + facts/B2 + rule/fixpoint sources; never output
;; observation). Recursive rules type via the Kleene fixpoint (D-B3.2).
;;22=> @[{:a "x", :c "z"} {:a "x", :c "w"}] : [PVec {:a String :c String}]
solve (twohop a c)

;; typed via the FIXPOINT (reaches is recursive): rows keyed :c String
;;23=> @[{:c "y"} {:c "z"} {:c "w"}] : [PVec {:c String}]
solve (reaches "x" c)

;; anonymous rel through the SAME walker (D-B3.3)
;;24=> @[{:v "x"} {:v "y"} {:v "y"}] : [PVec {:v String}]
solve (rel [?v]
       &> (edge v _))

;; ---- POL.5: def := solve(…) binds without a spurious multiplicity violation --
;; (the qtt goal-head inferQ poison, fixed 2026-07-24). The MOTIVATING
;; composition: bind a rule-relation solve, project a typed field.
;;25=> reach-one : {:a String :c String} defined.
def reach-one := solve-one (twohop a c)

;; def-bound rule row projects a TYPED field
;;26=> "z" : String
reach-one.c

;; ---- POL.10: def binds the WHNF-reduced value (SNAPSHOT semantics) ----------
;; Owner-ruled 2026-07-24 (second pass): evaluation runs ONCE at definition;
;; mentions read the value (a def'd solve no longer re-runs the solver).
;; Lambda-valued defs are whnf-trivial — binder-headed stays lazy by identity.
;; rows bound ONCE at definition (POL.10 snapshot)
;;27=> twohops : [PVec {:a String :c String}] defined.
def twohops := solve (twohop a c)

;; same rows on every mention (and zero additional solver work)
;;28=> @[{:c "z", :a "x"} {:c "w", :a "x"}] : [PVec {:a String :c String}]
twohops

;; ---- POL.8: implicit rule-clause groups (layout-based parenless goals) ------
;; (owner co-design 2026-07-25). Goal-ness from defr-body context; the `&>`
;; line's head token decides; sibling lines at the goal column; deeper lines
;; nest. Both spellings stay legal.

;;29=> fruit-color : _ defined.
defr fruit-color [?fruit ?color]
  || "blueberry" "blue"
  || "banana" "yellow"
  || "cherry" "red"

;; owner form 1 — bare single-goal clauses; two clauses = disjunction
;;30=> blue-or-yellow : _ defined.
defr blue-or-yellow [?fruit]
  &> fruit-color fruit "blue"
  &> fruit-color fruit "yellow"

;;31=> @[{:f "blueberry"} {:f "banana"}] : [PVec {:f String}]
solve (blue-or-yellow f)

;; owner form 2 — bare goal + sibling not(…) at the goal column
;;32=> fruit-not-of-color : _ defined.
defr fruit-not-of-color [?fruit ?not-color]
  &> fruit-color fruit color
     not (= color not-color)

;; cherry is red — excluded
;;33=> @[{:f "blueberry"} {:f "banana"}] : [PVec {:f String}]
solve (fruit-not-of-color f "red")

;; owner form 3 — nested bare not; the deeper line is its goal argument
;;34=> fruit-not-of-color2 : _ defined.
defr fruit-not-of-color2 [?fruit ?not-color]
  &> fruit-color fruit color
     not
       = color not-color

;;35=> @[{:f "blueberry"} {:f "banana"}] : [PVec {:f String}]
solve (fruit-not-of-color2 f "red")

;; ---- POL.9: implicit solve — parens make goals at command position ----------
;; (owner co-design 2026-07-25). `(foo x)` at top level ≡ solve (foo x);
;; `foo x` / `[foo x]` stays application; `rel` is the one keyword that
;; queries. Composes with POL.8's parenless clause groups.

;;36=> rg-fruits : _ defined.
defr rg-fruits [?f]
  &> fruit-color f "red"

;; implicit solve on a paren goal — same rows as the explicit `solve` above
;;37=> @[{:f "blueberry"} {:f "banana"}] : [PVec {:f String}]
(fruit-not-of-color f "red")

;; the composed owner example — paren rel + parenless clauses. All fixture
;; fruits are red or blue-or-yellow, so the answer is nil — the echo still
;; carries the typed row.
;;38=> @[] : [PVec {:fruit String}]
(rel [fruit]
  &> fruit-color fruit _
     not (rg-fruits fruit)
     not (blue-or-yellow fruit))

;; ---- POL.9b: def RHS is command position — `def r := (goal)` binds rows ----
;; implicit solve on the RHS; POL.10 snapshot semantics govern.
;;39=> blues : [PVec {:f String}] defined.
def blues := (fruit-not-of-color f "red")

;;40=> @[{:f "blueberry"} {:f "banana"}] : [PVec {:f String}]
blues
