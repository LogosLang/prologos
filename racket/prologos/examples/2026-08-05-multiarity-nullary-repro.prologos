;; Minimal repro — a 2-argument multi-arity `defn` over NULLARY constructors
;; discriminates on the FIRST argument only, and says nothing about it.
;;
;; Compiles. Type-checks. 0 errors. Wrong answers:
;;   [keq ka ka] -> true   (correct)
;;   [keq ka kb] -> true   (WRONG — hits the `ka ka` arm)
;;   [keq kb ka] -> true   (WRONG — hits the `kb kb` arm)
;; The `| _ _ -> false` catch-all is unreachable.
;;
;; Found 2026-08-05 while replacing captp-core's Peano kind tags with a real
;; sum type: `refr-kind-eq?` was written in this shape and quietly broke OCapN
;; brand-check. One assertion in the whole tree distinguishes the two cases.
;;
;; ROOT CAUSE (same day): NOT the pattern compiler. Two adjacent BARE names in a
;; clause are ambiguous — `| ka ka ->` is read as ONE application pattern (ctor
;; `ka` applied to `ka`), so the clause has arity 1. BRACKETING fixes it:
;;
;;   defn keq | [ka] [ka] -> true | [kb] [kb] -> true | _ _ -> false
;;
;; gives the correct true / false / false / true. That is the one-character fix.
;; The field-carrying twin always worked because `[wa _]` is already bracketed —
;; the real axis is unbracketed-vs-bracketed, not nullary-vs-not.
;;
;; Pitfall #18; full write-up + the recommended compiler fix in DEFERRED.md.
;;
;; ⚠ This file documents a DEFECT. When it starts printing
;; true/false/false/true it should move to a test and this note should go.

ns multiarity-nullary-repro

data K
  ka
  kb
  kc

spec keq K K -> Bool
defn keq
  | ka ka -> true
  | kb kb -> true
  | kc kc -> true
  | _ _ -> false

def r1 := [keq ka ka]
def r2 := [keq ka kb]
def r3 := [keq kb ka]
def r4 := [keq kb kb]

r1
r2
r3
r4
