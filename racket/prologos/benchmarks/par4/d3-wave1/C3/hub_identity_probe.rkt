#lang racket/base
;;; C3 probe 2: identify the merge of the highest-degree cell(s) in the largest BSP snapshot (P0's "hub cell").
;;; Usage: racket hub_identity_probe.rkt FILE.prologos   (one file per process)
(require racket/list racket/port
         (only-in (file "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/driver.rkt") process-file)
         (only-in (file "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/propagator.rkt")
                  current-bsp-observer bsp-round-network-snapshot prop-network-merge-fns prop-network-propagators
                  prop-network-cells propagator-outputs propagator-inputs cell-id-hash cell-id-n)
         (only-in (file "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/champ.rkt")
                  champ-lookup champ-size champ-fold))
(define the-file (vector-ref (current-command-line-arguments) 0))
(define largest #f) (define largest-n -1)
(define (observe r)
  (define snap (bsp-round-network-snapshot r))
  (define sz (champ-size (prop-network-cells snap)))
  (when (> sz largest-n) (set! largest-n sz) (set! largest snap)))
(parameterize ([current-output-port (open-output-nowhere)] [current-bsp-observer observe])
  (process-file the-file))
(define deg (make-hasheqv)) (define first-out (make-hasheqv)) (define cid-of (make-hasheqv))
(champ-fold (prop-network-propagators largest)
            (λ (pid p acc)
              (for ([c (append (propagator-inputs p) (propagator-outputs p))])
                (hash-set! cid-of (cell-id-n c) c)
                (hash-set! deg (cell-id-n c) (add1 (hash-ref deg (cell-id-n c) 0))))
              (define outs (propagator-outputs p))
              (when (pair? outs) (hash-set! first-out (cell-id-n (car outs)) (add1 (hash-ref first-out (cell-id-n (car outs)) 0))))
              acc) (void))
(define (merge-name n)
  (define c (hash-ref cid-of n))
  (define mf (champ-lookup (prop-network-merge-fns largest) (cell-id-hash c) c))
  (if (eq? mf 'none) "none" (format "~a" (object-name mf))))
(printf "file ~a\nlargest snapshot: ~a cells, ~a propagators\n" the-file largest-n (champ-size (prop-network-propagators largest)))
(for ([p (take (sort (hash->list deg) > #:key cdr) 3)])
  (printf "cell ~a degree ~a merge ~a; propagators with it as FIRST output: ~a\n"
          (car p) (cdr p) (merge-name (car p)) (hash-ref first-out (car p) 0)))
