== D1: fire-once F latches on a GROUND value of a fenced LWW cell x (a then b)
  (bsp (0 1 2 3 4) x b out a)
  (bsp (4 3 2 1 0) x b out a)
  (bsp (1 2 3 0 4) x b out a)
  (drain (0 1 2 3 4) x a out top)
  (drain (4 3 2 1 0) x b out top)
  (drain (1 2 3 0 4) x b out top)
== D2: two STABLE fire-once writers A, B of the same constant; epoch 2 raises the trigger again
  (bsp install (A B) C 7 fires-epoch1 ((A . 1) (B . 1)) fired-in-epoch2 ())
  (bsp install (B A) C 7 fires-epoch1 ((A . 1) (B . 1)) fired-in-epoch2 ())
  (drain install (A B) C 7 fires-epoch1 ((A . 2) (B . 2)) fired-in-epoch2 (A B))
  (drain install (B A) C 7 fires-epoch1 ((A . 2) (B . 2)) fired-in-epoch2 (A B))
  (K1-DIRECT install (A B) fired-in-epoch1 (A B) fired-in-epoch2 (B))
  (K1-DIRECT install (B A) fired-in-epoch1 (B A) fired-in-epoch2 (A))
