#lang racket/base
;; W2-4 t1: does the instrumented copy link with the compiled dependents? Power rows: C2's Tier-1 probe
;; network (must report a tier1 entry) and C8's chain (outer rounds).
(require (file "/Users/avanti/.hermes/profiles/logos-language-designer/cache/scratch/d3w2/W2-4/inst-loader.rkt"))
(define t0 (current-inexact-milliseconds))
(dynamic-require (string->path (string-append R "driver.rkt")) #f)
(eprintf "driver loaded in ~a ms\n" (round (- (current-inexact-milliseconds) t0)))
(define hook (dynamic-require prop-path 'w24-hook))
(define events '())
(set-box! hook (lambda (tag . args)
                 (set! events (cons (cons tag (case tag [(enter) (list (cadr args))] [(outer) args] [else (list (list-ref args 3))])) events))
                 'tok))
(define-values (make-prop-network net-new-cell net-add-propagator net-add-fire-once-propagator run-to-quiescence net-cell-read net-cell-write)
  (apply values (for/list ([s '(make-prop-network net-new-cell net-add-propagator net-add-fire-once-propagator run-to-quiescence net-cell-read net-cell-write)])
                  (dynamic-require prop-path s))))
(define (build fire-once?)
  (define net0 (make-prop-network))
  (define-values (net1 a) (net-new-cell net0 0 max))
  (define-values (net2 b) (net-new-cell net1 0 max))
  (define-values (net3 _p1) (net-add-propagator net2 (list a) (list b) (lambda (n) (net-cell-write n b (net-cell-read n a)))))
  (define net4 (run-to-quiescence net3))
  (define-values (net5 _p0)
    (if fire-once?
        (net-add-fire-once-propagator net4 '() (list a) (lambda (n) (net-cell-write n a 7)))
        (net-add-propagator net4 '() (list a) (lambda (n) (net-cell-write n a 7)))))
  (set! events '())
  (define out (run-to-quiescence net5))
  (printf "  A=~a B=~a events=~a\n" (net-cell-read out a) (net-cell-read out b) (reverse events)))
(printf "C2 Tier-1 network, fire-once:\n") (build #t)
(printf "C2 control, plain:\n") (build #f)
