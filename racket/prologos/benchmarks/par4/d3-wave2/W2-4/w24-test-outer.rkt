#lang racket/base
;; W2-4 Q4 for TEST files: run ONE test file with the outer-round instrument of w24-run.rkt installed
;; (current-bsp-observer + wrapped stratum handlers, fuel-linked runs, run record captured at handler entry).
;; Tests that install their own observer replace ours inside their extent (counted as unobserved).
(require rackunit/log json
         (only-in (file "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/driver.rkt") process-file)
         (only-in (file "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/propagator.rkt")
                  current-bsp-observer bsp-round-round-number bsp-round-network-snapshot bsp-round-propagators-fired
                  prop-network-worklist net-cell-read fuel-cell-id))
(define R "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos/")
(define f (simplify-path (path->complete-path (vector-ref (current-command-line-arguments) 0))))
(define runs (make-hash)) (define pending (make-hash)) (define run-max (make-hasheqv)) (define next-run 0)
(define conts 0) (define produced 0) (define rounds 0)
(define (fresh!) (begin0 (mcons next-run 0) (set! next-run (add1 next-run))))
(define (outer-observe r)
  (set! rounds (add1 rounds))
  (define net (bsp-round-network-snapshot r))
  (define n (length (bsp-round-propagators-fired r)))
  (define f-out (net-cell-read net fuel-cell-id)) (define f-in (+ f-out n))
  (cond
    [(zero? (bsp-round-round-number r))
     (define cont (hash-ref pending f-in #f))
     (hash-remove! pending f-in)
     (when cont (set! conts (add1 conts)))
     (define rec (if cont (mcons (mcar cont) (add1 (mcdr cont))) (fresh!)))
     (hash-set! runs f-out rec)
     (hash-set! run-max (mcar rec) (max (mcdr rec) (hash-ref run-max (mcar rec) 0)))]
    [else (define rec (hash-ref runs f-in #f))
          (when rec (hash-remove! runs f-in) (hash-set! runs f-out rec))]))
(define sh (eval 'stratum-handlers (module->namespace (string->path (string-append R "propagator.rkt")))))
(set-box! sh (for/list ([e (unbox sh)])
               (define fn (cadr e))
               (list* (car e)
                      (lambda (net pend)
                        (define F (net-cell-read net fuel-cell-id))
                        (define rec (or (hash-ref runs F #f) (fresh!)))
                        (define out (fn net pend))
                        (when (pair? (prop-network-worklist out)) (set! produced (add1 produced)) (hash-set! pending F rec))
                        out)
                      (cddr e))))
(define sub `(submod (file ,(path->string f)) test))
(parameterize ([current-bsp-observer outer-observe])
  (with-handlers ([exn:fail? (lambda (e) (eprintf "W24-TEST-RAISE: ~a\n" (exn-message e)))])
    (if (module-declared? sub #t) (dynamic-require sub #f) (dynamic-require `(file ,(path->string f)) #f))))
(test-log #:display? #t #:exit? #f)
(define ms (hash-values run-max))
(printf "W24O ~a\n" (jsexpr->string (hasheq 'rounds rounds 'runs (length ms) 'outer_max (apply max 0 ms)
                                           'runs_outer_ge_2 (for/sum ([m ms]) (if (>= m 2) 1 0))
                                           'handler_produced_s0 produced 'continuations conts)))
