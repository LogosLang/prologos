#lang racket/base
;; C8 probe: D.2 §6.3 row 8 proposes "clash (rigid heads differ) => top" for BOTH type merges.
;; Measure what each merge returns today on a rigid clash, with the meta unsolved and solved,
;; to see whether "clash => top" agrees with each merge's own ground behaviour.
;; Role A = type-lattice-merge (type-lattice.rkt:156; PPN 4C T-3 Commit B: ground clash => union)
;; Role B = type-unify-or-top  (type-lattice.rkt:203; ground clash => type-top)
(define root "/Users/avanti/dev/projects/logos/prologos/.claude/worktrees/par4-arena-executors/racket/prologos")
(define (p f) (string->path (string-append root "/" f)))
(define syn (lambda (id) (dynamic-require (p "syntax.rkt") id)))
(define tl  (lambda (id) (dynamic-require (p "type-lattice.rkt") id)))
(define expr-Pi (syn 'expr-Pi)) (define expr-Nat (syn 'expr-Nat)) (define expr-Bool (syn 'expr-Bool))
(define expr-meta (syn 'expr-meta))
(define roleA (tl 'type-lattice-merge))
(define roleB (tl 'type-unify-or-top))
(define type-top? (tl 'type-top?))
(define solfn (tl 'current-lattice-meta-solution-fn))
(define m (expr-meta 'pm1 #f))
(define (unsolved id) #f)
(define (solved id) (and (eq? id 'pm1) (expr-Nat)))
(define x (expr-Bool))
(define y-ground (expr-Pi 'mw (expr-Nat) (expr-Nat)))
(define y-meta (expr-Pi 'mw m (expr-Nat)))
(define (show label merge a b sol)
  (define r (parameterize ([solfn sol]) (merge a b)))
  (printf "~a => ~s   [top? ~a]\n" label r (type-top? r)))
(printf "--- Role A: type-lattice-merge ---\n")
(show "A1 Bool ⊔ Pi(Nat,Nat)            (ground clash)        " roleA x y-ground unsolved)
(show "A2 Bool ⊔ Pi(?m,Nat), ?m unsolved (F3(b) fallback)      " roleA x y-meta unsolved)
(show "A3 Bool ⊔ Pi(?m,Nat), ?m := Nat   (same args, solved)   " roleA x y-meta solved)
(show "A4 Pi(?m,Nat) ⊔ Bool, ?m unsolved (swapped)             " roleA y-meta x unsolved)
(printf "--- Role B: type-unify-or-top ---\n")
(show "B1 Bool ⊔ Pi(Nat,Nat)            (ground clash)        " roleB x y-ground unsolved)
(show "B2 Bool ⊔ Pi(?m,Nat), ?m unsolved (F3(b) fallback)      " roleB x y-meta unsolved)
(show "B3 Bool ⊔ Pi(?m,Nat), ?m := Nat   (same args, solved)   " roleB x y-meta solved)
(printf "--- power row: the instrument distinguishes top from non-top ---\n")
(show "P1 Bool ⊔ Bool                                          " roleA x x unsolved)
