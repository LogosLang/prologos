ns benchmarks::lowering::01-tailrec-pair-fib-30

;; Iterative fib(30) via pair-state tail-rec.
;; Exercises: tail-rec lowering (Sprint E.3) + pair construction (F.2)
;;            + pair-state iteration (F.3).
;;
;; Does NOT static-fold (Gate 2): pair construction is opaque to
;; static-eval, so this RUNS the BSP scheduler for ~30 iterations.
;; This is the canonical "real runtime" benchmark for the kernel.
;;
;; fib(30) = 832040; exit code (mod 256) = 40.
;; :expect-exit 40

spec fib-pair <Int * Int> -> Int -> Int
defn fib-pair [p n]
  match [int-lt n 1]
    | true  -> [fst p]
    | false -> [fib-pair [pair [snd p] [int+ [fst p] [snd p]]] [int- n 1]]

def main : Int := [fib-pair [pair 0 1] 30]
