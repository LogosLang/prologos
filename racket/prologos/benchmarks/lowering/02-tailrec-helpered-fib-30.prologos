ns benchmarks::lowering::02-tailrec-helpered-fib-30

;; Iterative fib(30) via tail-rec with TWO levels of helper inlining.
;; Exercises: tail-rec (E.3) + non-recursive helper inlining (F.1) +
;;            pair construction + pair-state iteration.
;;
;; Same network shape as 01-tailrec-pair-fib-30 (helpers inline at
;; lowering time), but tests that the inlining pass composes cleanly
;; with pair-state lowering. Runs the BSP scheduler.
;;
;; fib(30) = 832040; exit code (mod 256) = 40.
;; :expect-exit 40

spec is-pos Int -> Bool
defn is-pos [x] [int-lt 0 x]

spec next-step <Int * Int> -> <Int * Int>
defn next-step [p]
  pair [snd p] [int+ [fst p] [snd p]]

spec fib-helpered <Int * Int> -> Int -> Int
defn fib-helpered [p k]
  match [is-pos k]
    | true  -> [fib-helpered [next-step p] [int- k 1]]
    | false -> [fst p]

def main : Int := [fib-helpered [pair 0 1] 30]
