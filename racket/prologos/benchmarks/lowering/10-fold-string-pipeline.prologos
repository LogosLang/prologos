ns benchmarks::lowering::10-fold-string-pipeline

;; Gate 3 foreign-call folding: literal append + length folds to 7 at compile
;; time. Opaque seed from argv is added so output depends on runtime input.
;;
;; :inputs 0 5 100
;; :expect-stdout-for 0 = 7
;; :expect-stdout-for 5 = 12
;; :expect-stdout-for 100 = 107

require [prologos::data::string :refer [length append]]

def main : Int -> Int := (fn [seed : Int]
  [int+ seed [length (append (append "ab" "cde") "fg")]])
