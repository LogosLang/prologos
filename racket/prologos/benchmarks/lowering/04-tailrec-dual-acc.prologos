ns benchmarks::lowering::04-tailrec-dual-acc

;; Dual accumulator: pair-state tail-rec computing (sum 1..N + product 1..N).
;; State: <s * p> where s accumulates the sum, p accumulates the product.
;;
;; Step from (s, p, i) → (s+i, p*i, i-1). Loop exits when i ≤ 0,
;; returning s + p.
;;
;; Exercises: pair-state tail-rec, multi-cell update per iteration
;; (both s and p cells transition each round), independent leaf
;; lowering of pair components, parameterised main with M6 mirror.
;;
;; sum 1..N = N(N+1)/2;  product 1..N = N!
;;   N=4:  sum=10,    product=24,        total=34
;;   N=8:  sum=36,    product=40320,     total=40356
;;   N=12: sum=78,    product=479001600, total=479001678
;;
;; :inputs 4 8 12
;; :expect-stdout-for 4 = 34
;; :expect-stdout-for 8 = 40356
;; :expect-stdout-for 12 = 479001678

spec dual-acc <Int * Int> -> Int -> Int
defn dual-acc [p i]
  match [int-le i 0]
    | true  -> [int+ [fst p] [snd p]]
    | false -> [dual-acc [pair [int+ [fst p] i] [int* [snd p] i]] [int- i 1]]

def main : Int -> Int := (fn [n : Int] [dual-acc [pair 0 1] n])
