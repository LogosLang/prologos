ns benchmarks::lowering::05-fold-fib-non-tail-15

;; Non-tail fib(15) folds via Gate 2; argv seed shifts stdout so every bench
;; reads input and prints a runtime-dependent Int.
;;
;; :inputs 0 10 100
;; :expect-stdout-for 0 = 610
;; :expect-stdout-for 10 = 620
;; :expect-stdout-for 100 = 710

spec fib Int -> Int
defn fib
  | 0 -> 0
  | 1 -> 1
  | n -> [int+ [fib [int- n 1]] [fib [int- n 2]]]

def main : Int -> Int := (fn [seed : Int] [int+ seed [fib 15]])
