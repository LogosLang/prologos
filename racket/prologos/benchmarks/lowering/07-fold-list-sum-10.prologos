ns benchmarks::lowering::07-fold-list-sum-10

;; Fixed cons-list [1..10] + non-tail sum-list folds via Gate 1 + 2.
;; argv seed shifts stdout (opaque input still flows through main).
;;
;; :inputs 0 5 100
;; :expect-stdout-for 0 = 55
;; :expect-stdout-for 5 = 60
;; :expect-stdout-for 100 = 155

data List {A}
  nil
  cons : A -> List A

spec sum-list (List Int) -> Int
defn sum-list
  | nil       -> 0
  | cons a r  -> [int+ a [sum-list r]]

def main : Int -> Int := (fn [seed : Int]
  [int+ seed [sum-list (cons Int 1
                       (cons Int 2
                       (cons Int 3
                       (cons Int 4
                       (cons Int 5
                       (cons Int 6
                       (cons Int 7
                       (cons Int 8
                       (cons Int 9
                       (cons Int 10 (nil Int))))))))))]])
