ns benchmarks::lowering::12-showcase-tailrec-and-bool

;; Combined showcase: tail-rec `fib-pair` at fixed n=20 + Bool threshold +
;; match dispatch (historical lowering composition). An argv seed shifts stdout
;; so the bench reads runtime input while preserving foldable fib indices (see
;; 01–04 for argv-driven iteration counters).
;;
;; :inputs 0 10 100
;; :expect-stdout-for 0 = 65
;; :expect-stdout-for 10 = 75
;; :expect-stdout-for 100 = 165

spec fib-pair <Int * Int> -> Int -> Int
defn fib-pair [p n]
  match [int-lt n 1]
    | true  -> [fst p]
    | false -> [fib-pair [pair [snd p] [int+ [fst p] [snd p]]] [int- n 1]]

def main : Int -> Int := (fn [seed : Int]
  [match [int-lt 1000 [fib-pair [pair 0 1] 20]]
    | true  -> [int+ seed [int- [fib-pair [pair 0 1] 20] 6700]]
    | false -> seed])
