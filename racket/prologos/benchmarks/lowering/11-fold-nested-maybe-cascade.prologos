ns benchmarks::lowering::11-fold-nested-maybe-cascade

;; Maybe / some unwrap (Gate 1). `match` on Maybe cannot nest inside `[int+`
;; in the surface elaborator, so seed is folded via match arms instead.
;;
;; :inputs 0 5 100
;; :expect-stdout-for 0 = 7
;; :expect-stdout-for 5 = 12
;; :expect-stdout-for 100 = 107

data Maybe {A}
  none
  some : A

def main : Int -> Int := (fn [seed : Int]
  [match (some Int 7)
    | none -> seed
    | some x -> [int+ seed x]])
