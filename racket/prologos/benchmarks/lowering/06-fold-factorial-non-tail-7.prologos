ns benchmarks::lowering::06-fold-factorial-non-tail-7

;; Non-tail fact(7) folds via Gate 2; argv seed shifts stdout.
;;
;; :inputs 0 10 100
;; :expect-stdout-for 0 = 5040
;; :expect-stdout-for 10 = 5050
;; :expect-stdout-for 100 = 5140

spec fact Int -> Int
defn fact
  | 0 -> 1
  | n -> [int* n [fact [int- n 1]]]

def main : Int -> Int := (fn [seed : Int] [int+ seed [fact 7]])
