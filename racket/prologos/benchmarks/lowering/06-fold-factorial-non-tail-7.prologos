ns benchmarks::lowering::06-fold-factorial-non-tail-7

;; Non-tail-recursive factorial(7). The recursive call sits inside
;; `int*`, so this is non-tail. Folds at compile time via Gate 2.
;;
;; 7! = 5040; exit code (mod 256) = 5040 mod 256 = 176.
;; :expect-exit 176

spec fact Int -> Int
defn fact
  | 0 -> 1
  | n -> [int* n [fact [int- n 1]]]

def main : Int := [fact 7]
