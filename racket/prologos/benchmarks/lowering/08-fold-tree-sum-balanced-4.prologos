ns benchmarks::lowering::08-fold-tree-sum-balanced-4

;; Fixed balanced tree (leaves 1..4) sums to 10 at compile time.
;; argv seed shifts stdout.
;;
;; :inputs 0 5 100
;; :expect-stdout-for 0 = 10
;; :expect-stdout-for 5 = 15
;; :expect-stdout-for 100 = 110

data Tree {A}
  leaf   : A
  branch : Tree A -> Tree A

spec sum-tree (Tree Int) -> Int
defn sum-tree
  | leaf v     -> v
  | branch l r -> [int+ [sum-tree l] [sum-tree r]]

def main : Int -> Int := (fn [seed : Int]
  [int+ seed [sum-tree (branch Int (branch Int (leaf Int 1) (leaf Int 2))
                               (branch Int (leaf Int 3) (leaf Int 4)))]])
