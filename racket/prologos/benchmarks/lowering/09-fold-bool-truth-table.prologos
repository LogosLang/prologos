ns benchmarks::lowering::09-fold-bool-truth-table

;; Gate 4 Bool ops fold at compile time. Runtime adds opaque seed from argv
;; so every bench reads input and prints an Int (truth table result is 1).
;;
;; :inputs 0 5 100
;; :expect-stdout-for 0 = 1
;; :expect-stdout-for 5 = 6
;; :expect-stdout-for 100 = 101

require [prologos::data::bool :refer [and or xor not implies]]

def main : Int -> Int := (fn [seed : Int]
  [match [xor (and true (or false (not false))) (implies true false)]
    | true  -> [int+ seed 1]
    | false -> seed])
