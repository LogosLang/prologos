ns prologos::core::abstract-domains

require [prologos::data::sign :refer [Sign sign-bot sign-neg sign-zero sign-pos sign-nonpos sign-nonzero sign-nonneg sign-top]]
require [prologos::data::parity :refer [Parity parity-bot parity-even parity-odd parity-top]]
require [prologos::core::lattice :refer [Lattice HasTop GaloisConnection Interval interval-bot interval-top mk-interval]]
require [prologos::data::bool :refer [and or]]

;; ========================================
;; Sign atom accessors (the Q₃ 3-bit view: neg? zero? pos?)
;; ========================================

defn sign-has-neg [s <Sign>] <Bool>
  match s
    | sign-bot -> false
    | sign-neg -> true
    | sign-zero -> false
    | sign-pos -> false
    | sign-nonpos -> true
    | sign-nonzero -> true
    | sign-nonneg -> false
    | sign-top -> true

defn sign-has-zero [s <Sign>] <Bool>
  match s
    | sign-bot -> false
    | sign-neg -> false
    | sign-zero -> true
    | sign-pos -> false
    | sign-nonpos -> true
    | sign-nonzero -> false
    | sign-nonneg -> true
    | sign-top -> true

defn sign-has-pos [s <Sign>] <Bool>
  match s
    | sign-bot -> false
    | sign-neg -> false
    | sign-zero -> false
    | sign-pos -> true
    | sign-nonpos -> false
    | sign-nonzero -> true
    | sign-nonneg -> true
    | sign-top -> true

;; Reconstruct a Sign element from atom membership (neg?, zero?, pos?).
defn sign-from-atoms [hn <Bool> hz <Bool> hp <Bool>] <Sign>
  match hn
    | true ->
        match hz
          | true ->
              match hp
                | true -> sign-top
                | false -> sign-nonpos
          | false ->
              match hp
                | true -> sign-nonzero
                | false -> sign-neg
    | false ->
        match hz
          | true ->
              match hp
                | true -> sign-nonneg
                | false -> sign-zero
          | false ->
              match hp
                | true -> sign-pos
                | false -> sign-bot

;; ========================================
;; Lattice Sign — 8-element powerset ℘({neg,zero,pos}); join = ∪, leq = ⊆
;; ========================================
;; join/leq are computed pointwise over the 3 atoms (the Q₃ 3-bit test),
;; not a 64-case table: a⊔b = atoms(a)∪atoms(b); a⊑b ⟺ atoms(a)⊆atoms(b).

impl Lattice Sign
  defn bot [] <Sign>
    sign-bot
  defn join [a <Sign> b <Sign>] <Sign>
    sign-from-atoms [or [sign-has-neg a] [sign-has-neg b]] [or [sign-has-zero a] [sign-has-zero b]] [or [sign-has-pos a] [sign-has-pos b]]
  defn leq [a <Sign> b <Sign>] <Bool>
    and [if [sign-has-neg a] [sign-has-neg b] true] [and [if [sign-has-zero a] [sign-has-zero b] true] [if [sign-has-pos a] [sign-has-pos b] true]]

;; ========================================
;; HasTop Sign
;; ========================================

impl HasTop Sign
  defn top [] <Sign>
    sign-top

;; ========================================
;; Lattice Parity
;; ========================================

impl Lattice Parity
  defn bot [] <Parity>
    parity-bot
  defn join [a <Parity> b <Parity>] <Parity>
    match a
      | parity-bot -> b
      | parity-top -> parity-top
      | parity-even -> match b
          | parity-bot -> parity-even
          | parity-even -> parity-even
          | parity-odd -> parity-top
          | parity-top -> parity-top
      | parity-odd -> match b
          | parity-bot -> parity-odd
          | parity-even -> parity-top
          | parity-odd -> parity-odd
          | parity-top -> parity-top
  defn leq [a <Parity> b <Parity>] <Bool>
    match a
      | parity-bot -> true
      | parity-top -> match b
          | parity-top -> true
          | parity-bot -> false
          | parity-even -> false
          | parity-odd -> false
      | parity-even -> match b
          | parity-even -> true
          | parity-top -> true
          | parity-bot -> false
          | parity-odd -> false
      | parity-odd -> match b
          | parity-odd -> true
          | parity-top -> true
          | parity-bot -> false
          | parity-even -> false

;; ========================================
;; HasTop Parity
;; ========================================

impl HasTop Parity
  defn top [] <Parity>
    parity-top

;; ========================================
;; GaloisConnection Interval Sign
;; ========================================
;; Sign abstraction of numeric intervals.
;;
;; alpha (abstraction): Interval -> Sign
;;   interval-bot          -> sign-bot   (unreachable -> no info)
;;   interval-top          -> sign-top   (contradiction -> any sign)
;;   mk-interval lo hi:
;;     lo > 0              -> sign-pos   (entirely positive)
;;     hi < 0              -> sign-neg   (entirely negative)
;;     lo = 0 and hi = 0   -> sign-zero  (exactly zero)
;;     otherwise           -> sign-top   (spans zero -> unknown)
;;
;; gamma (concretization): Sign -> Interval
;;   sign-bot  -> interval-bot                  (unreachable -> unconstrained)
;;   sign-neg  -> mk-interval neg-inf -1/1      (some negative value)
;;   sign-zero -> mk-interval 0/1 0/1           (exactly zero)
;;   sign-pos  -> mk-interval 1/1 pos-inf       (some positive value)
;;   sign-top  -> mk-interval neg-inf pos-inf   (any value)

;; Sentinel values for "effectively unbounded" intervals.
;; In a sound abstract interpretation, these represent +/- infinity.
def pos-inf : Rat 999999/1
def neg-inf : Rat -999999/1

impl GaloisConnection Interval Sign
  defn alpha [iv <Interval>] <Sign>
    match iv
      | interval-bot -> sign-bot
      | interval-top -> sign-top
      | mk-interval lo hi ->
          if [rat-lt 0/1 lo] sign-pos
            [if [rat-lt hi 0/1] sign-neg
              [if [and [rat-eq lo 0/1] [rat-eq hi 0/1]] sign-zero
                [if [rat-eq lo 0/1] sign-nonneg
                  [if [rat-eq hi 0/1] sign-nonpos
                    sign-top]]]]
  defn gamma [s <Sign>] <Interval>
    match s
      | sign-bot  -> interval-bot
      | sign-neg  -> mk-interval neg-inf -1/1
      | sign-zero -> mk-interval 0/1 0/1
      | sign-pos  -> mk-interval 1/1 pos-inf
      | sign-nonpos -> mk-interval neg-inf 0/1
      | sign-nonzero -> mk-interval neg-inf pos-inf
      | sign-nonneg -> mk-interval 0/1 pos-inf
      | sign-top  -> mk-interval neg-inf pos-inf

