trait ToPosit16 {A}
  to-posit16 : A -> Posit16

impl ToPosit16 Nat
  defn to-posit16 [n : Nat] <Posit16>
    p16-from-nat n

impl ToPosit16 Int
  defn to-posit16 [x : Int] <Posit16>
