;; ---- ToPosit64 (total; NaN/±Inf/NaR -> NaR) ----
trait ToPosit64 {A}
  to-posit64 : A -> Posit64

impl ToPosit64 Nat
  defn to-posit64 [n : Nat] <Posit64>
