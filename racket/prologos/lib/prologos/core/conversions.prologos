      | false -> p64-nar

;; ---- ToRat (partial; PANIC on non-finite / NaR) ----
trait ToRat {A}
  to-rat : A -> Rat

impl ToRat Nat
  defn to-rat [n : Nat] <Rat>
    from-int [from-nat n]

impl ToRat Int
  defn to-rat [x : Int] <Rat>
    from-int x

impl ToRat Rat
  defn to-rat [x : Rat] <Rat>
    x

impl ToRat Posit8
  defn to-rat [x : Posit8] <Rat>
    p8-if-nar Rat (panic "to-rat: cannot convert NaR to Rat; use try-from for an Option") [p8-to-rat x] x

impl ToRat Posit16
  defn to-rat [x : Posit16] <Rat>
    p16-if-nar Rat (panic "to-rat: cannot convert NaR to Rat; use try-from for an Option") [p16-to-rat x] x

impl ToRat Posit32
  defn to-rat [x : Posit32] <Rat>
    p32-if-nar Rat (panic "to-rat: cannot convert NaR to Rat; use try-from for an Option") [p32-to-rat x] x

impl ToRat Posit64
  defn to-rat [x : Posit64] <Rat>
    p64-if-nar Rat (panic "to-rat: cannot convert NaR to Rat; use try-from for an Option") [p64-to-rat x] x

impl ToRat Float32
  defn to-rat [x : Float32] <Rat>
    match [float-finite? x]
      | true  -> float-to-rat x
      | false -> panic "to-rat: cannot convert non-finite Float to Rat; use try-from for an Option"

impl ToRat Float64
  defn to-rat [x : Float64] <Rat>
    match [float-finite? x]
      | true  -> float-to-rat x
      | false -> panic "to-rat: cannot convert non-finite Float to Rat; use try-from for an Option"

;; ---- ToInt (partial; truncate toward zero; PANIC on non-finite / NaR) ----
trait ToInt {A}
  to-int : A -> Int

impl ToInt Nat
  defn to-int [n : Nat] <Int>
    from-nat n

impl ToInt Int
  defn to-int [x : Int] <Int>
    x

impl ToInt Rat
  defn to-int [x : Rat] <Int>
    int/ [rat-numer x] [rat-denom x]

impl ToInt Posit8
  defn to-int [x : Posit8] <Int>
    p8-if-nar Int (panic "to-int: cannot convert NaR to Int; use try-from for an Option") [int/ [rat-numer [p8-to-rat x]] [rat-denom [p8-to-rat x]]] x

impl ToInt Posit16
  defn to-int [x : Posit16] <Int>
    p16-if-nar Int (panic "to-int: cannot convert NaR to Int; use try-from for an Option") [int/ [rat-numer [p16-to-rat x]] [rat-denom [p16-to-rat x]]] x

impl ToInt Posit32
  defn to-int [x : Posit32] <Int>
    p32-if-nar Int (panic "to-int: cannot convert NaR to Int; use try-from for an Option") [int/ [rat-numer [p32-to-rat x]] [rat-denom [p32-to-rat x]]] x

impl ToInt Posit64
  defn to-int [x : Posit64] <Int>
    p64-if-nar Int (panic "to-int: cannot convert NaR to Int; use try-from for an Option") [int/ [rat-numer [p64-to-rat x]] [rat-denom [p64-to-rat x]]] x

impl ToInt Float32
  defn to-int [x : Float32] <Int>
    match [float-finite? x]
      | true  -> float-to-int x
      | false -> panic "to-int: cannot convert non-finite Float to Int; use try-from for an Option"

impl ToInt Float64
  defn to-int [x : Float64] <Int>
    match [float-finite? x]
      | true  -> float-to-int x
      | false -> panic "to-int: cannot convert non-finite Float to Int; use try-from for an Option"

;; ---- Default-width aliases (delegating defns, not traits) ----
;; to-float = to-float64 (interop default width); to-posit = to-posit32 (compute).
;; Plain constrained generics delegating to the width method — first-class, but
;; a fixed default width (no separate user-extension axis).
spec to-float {A} A -> Float64 where (ToFloat64 A)
defn to-float [x] where (ToFloat64 A)
  to-float64 x

spec to-posit {A} A -> Posit32 where (ToPosit32 A)
defn to-posit [x] where (ToPosit32 A)
  to-posit32 x

;; ========================================
;; FromInt Trait — convert Int to A
;; ========================================
;; FromInt A = Int -> A (single-method: dict IS the function)
;; Method is "from-integer" (not "from-int" — that's a parser keyword).

trait FromInt {A}
  from-integer : Int -> A
  :doc "Convert from Int to type A"

;; Int instance — identity
impl FromInt Int
  defn from-integer [x : Int] <Int>
    x

;; Rat instance — uses the from-int parser keyword (Int->Rat primitive)
impl FromInt Rat
  defn from-integer [x : Int] <Rat>
    from-int x

;; ========================================
;; FromInt Posit instances — Int -> Posit{N}
;; ========================================
;; Bridges the 2-param From to the 1-param FromInt used by Num bundle.
;; Enables `Num Posit{N}` bundle resolution.

impl FromInt Posit8
  defn from-integer [x : Int] <Posit8>
    p8-from-int x

impl FromInt Posit16
  defn from-integer [x : Int] <Posit16>
    p16-from-int x

impl FromInt Posit32
  defn from-integer [x : Int] <Posit32>
    p32-from-int x

impl FromInt Posit64
  defn from-integer [x : Int] <Posit64>
    p64-from-int x

;; ========================================
;; FromRat Trait — convert Rat to A
;; ========================================
;; FromRat A = Rat -> A (single-method: dict IS the function)

trait FromRat {A}
  from-rational : Rat -> A
  :doc "Convert from Rat to type A"

;; Rat instance — identity
impl FromRat Rat
  defn from-rational [x : Rat] <Rat>
    x

;; ========================================
;; FromInt Float instances — Int -> Float{N} (Numerics N3e; lossy ≥2^53)
;; ========================================
;; Bodies use the arity-2 generic from-integer keyword (Path B), which reduces
;; via the generic-from-int Float arms. Enables `Num Float{N}` bundle resolution.

impl FromInt Float32
  defn from-integer [x : Int] <Float32>
    from-integer Float32 x

impl FromInt Float64
  defn from-integer [x : Int] <Float64>
    from-integer Float64 x

;; ========================================
;; FromRat Float instances — Rat -> Float{N} (Numerics N3e; the DEMO-P1 path)
;; ========================================
;; Enables `Fractional Float{N}` bundle resolution + the JSON JFloat conversion.

impl FromRat Float32
  defn from-rational [x : Rat] <Float32>
    from-rational Float32 x

impl FromRat Float64
  defn from-rational [x : Rat] <Float64>
    from-rational Float64 x

;; ========================================
;; FromRat Posit instances — Rat -> Posit{N}
;; ========================================
;; Bridges the 2-param From to the 1-param FromRat used by Fractional bundle.
;; Enables `Fractional Posit{N}` bundle resolution.

impl FromRat Posit8
  defn from-rational [x : Rat] <Posit8>
    p8-from-rat x

impl FromRat Posit16
  defn from-rational [x : Rat] <Posit16>
    p16-from-rat x

impl FromRat Posit32
  defn from-rational [x : Rat] <Posit32>
    p32-from-rat x

impl FromRat Posit64
  defn from-rational [x : Rat] <Posit64>
    p64-from-rat x
