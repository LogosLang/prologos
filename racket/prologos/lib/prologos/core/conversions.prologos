    p8-if-nar Posit16 p16-nar [p16-from-rat [p8-to-rat x]] x

impl ToPosit16 Posit16
  defn to-posit16 [x : Posit16] <Posit16>
    x

impl ToPosit16 Posit32
  defn to-posit16 [x : Posit32] <Posit16>
    p32-if-nar Posit16 p16-nar [p16-from-rat [p32-to-rat x]] x

impl ToPosit16 Posit64
  defn to-posit16 [x : Posit64] <Posit16>
    p64-if-nar Posit16 p16-nar [p16-from-rat [p64-to-rat x]] x

impl ToPosit16 Float32
  defn to-posit16 [x : Float32] <Posit16>
    match [float-finite? x]
      | true  -> p16-from-rat [float-to-rat x]
      | false -> p16-nar

impl ToPosit16 Float64
  defn to-posit16 [x : Float64] <Posit16>
    match [float-finite? x]
      | true  -> p16-from-rat [float-to-rat x]
      | false -> p16-nar

;; ---- ToPosit32 (total; NaN/±Inf/NaR -> NaR) ----
trait ToPosit32 {A}
  to-posit32 : A -> Posit32

impl ToPosit32 Nat
  defn to-posit32 [n : Nat] <Posit32>
