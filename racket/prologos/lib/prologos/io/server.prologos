ns prologos::io::server :no-prelude

;; ========================================
;; A frame server loop, written in Prologos
;; ========================================
;;
;; The event loop itself — accept, read, write, repeat — expressed in the
;; language rather than in the Racket host. This is the step the OCapN work
;; needs: while the loop lives in Racket, Racket owns the accumulator, which is
;; why per-connection state sits in an FFI hash table instead of being threaded
;; like any other value.
;;
;; Ordering comes from `prologos::core::world`: every action consumes a World
;; and produces the next, so the loop cannot run its steps out of order even
;; though reduction is lazy. Read `core::world` for what that does and does not
;; guarantee.
;;
;; ----------------------------------------
;; Cost
;; ----------------------------------------
;;
;; A loop iteration in the current reducer costs ~6.7 ms, and is LINEAR in the
;; iteration count (measured at N = 100 / 300 / 1000: 678 / 2025 / 6745 ms — no
;; blowup, no stack growth). Against that, moving the loop in REMOVES the
;; ~3.8 ms `process-string` the host pays per frame to re-parse and re-elaborate
;; its call. Roughly break-even per frame.
;;
;; The constraint that actually matters is GRANULARITY: one iteration per
;; FRAME is fine, one per BYTE is hopeless. That is why frame assembly and hex
;; decoding stay on the Racket side of the FFI and are not rewritten here.

require [prologos::core::world :refer [World world]]
        [prologos::data::list  :refer [List nil cons]]
        [prologos::data::nat   :as nat :refer [nat-eq?]]
        [prologos::io::net     :refer [ConnH ServerH conn-h conn-id server-id
                                        Synced synced net-sync
                                        Recv recv
                                        Accepted accepted
                                        Listening listening
                                        net-listen net-accept net-send net-recv
                                        net-close-conn net-close-server]]

;; ========================================
;; Echo one connection
;; ========================================
;;
;; Read a frame, write it back, repeat until the peer goes away.
;;
;; The EOF test is the loop's whole termination argument, and it is why
;; `net-recv` reports EOF as a field rather than as an empty payload. A peer
;; that sends a zero-length frame is still talking; a peer that closed is not.
;; Collapsing the two gives a server that either spins on a dead socket or
;; hangs up on a live one, and both look like a network fault rather than a
;; logic error.
;;
;; `w` is consumed exactly once on every path: handed to `net-recv`, and the
;; World that comes back is handed on to exactly one of the two arms. That is
;; what makes this a legal linear program, and it is also, precisely, the
;; statement that the loop has no branch which forgets to advance the world.

spec echo-conn ConnH -> <(w :1 World) -> World>
defn echo-conn [c]
  fn [w :1 World]
    match [[net-recv c] w]
      | recv w2 payload eof ->
          match eof
            | true  -> [[net-close-conn c] w2]
            | false -> [[echo-conn c] [[net-send c payload] w2]]

;; ========================================
;; Serve one connection, then stop
;; ========================================
;;
;; Binds the port, accepts ONE peer, echoes until that peer closes, and shuts
;; the listener down. The whole program is a single World transformer, so a
;; caller runs it by handing it `initial-world`.
;;
;; Both matches are inlined to TWO deep rather than factored into helpers.
;; A helper would read better and does not work: module-level definitions are
;; not forward-referenceable, so `echo-conn` calling a helper defined below it
;; fails at import with "Unbound variable", and moving the helper above only
;; moves the problem, since the two are mutually recursive. Self-recursion is
;; fine; that is what the `false` arm above relies on.

spec echo-once Nat -> <(w :1 World) -> World>
defn echo-once [port]
  fn [w :1 World]
    match [[net-listen port] w]
      | listening w2 s ->
          match [[net-accept s] w2]
            | accepted w3 c ->
                [[net-close-server s] [[echo-conn c] w3]]

;; ========================================
;; Many connections, ONE loop, ONE state
;; ========================================
;;
;; `echo-once` above serves a single peer. This serves many — and the whole
;; point is what the state looks like while it does: `SrvState` is an ORDINARY
;; VALUE threaded through the loop.
;;
;; That is the observation the OCapN migration turns on. The five shared FFI
;; hash tables that hold handoff state exist because the Racket server gives
;; each connection its own THREAD, so per-connection state cannot be an
;; accumulator — it has to be somewhere both threads can reach. One loop over a
;; multiplexed handle set removes the reason: state becomes fields, not tables.
;;
;; SEQUENTIAL, deliberately. `net-sync` returns one ready handle and it is
;; serviced before anything else runs, so a slow peer delays the others. That
;; is the accepted cost of getting the loop into the language; parallel service
;; is the on-network question and is not answered here.

;; server, open connections, connections still expected.
;;
;; The third field is what lets a TEST terminate. A real server would drop it
;; and loop forever, which is the only difference between this and one.
data SrvState
  srv-state : ServerH -> [List ConnH] -> Nat

spec srv-server SrvState -> ServerH
defn srv-server [st]
  match st
    | srv-state s _ _ -> s

;; The handle ids to wait on: every open connection, plus the listener while
;; we still expect more peers. Dropping the listener once we do not is what
;; lets the loop finish rather than blocking on an accept nobody will make.
spec conn-ids [List ConnH] -> [List Nat]
defn conn-ids
  | nil          -> [nil Nat]
  | cons c rest  -> [cons [conn-id c] [conn-ids rest]]

spec remove-conn Nat [List ConnH] -> [List ConnH]
defn remove-conn
  | _ nil         -> [nil ConnH]
  | h [cons c rest] ->
      match [nat-eq? h [conn-id c]]
        | true  -> remove-conn h rest
        | false -> [cons c [remove-conn h rest]]

spec watch-list SrvState -> [List Nat]
defn watch-list [st]
  match st
    | srv-state s conns remaining ->
        match [nat-eq? remaining 0N]
          | true  -> conn-ids conns
          | false -> [cons [server-id s] [conn-ids conns]]

;; Nothing left to wait for: no peer still expected and none still open.
spec srv-done? SrvState -> Bool
defn srv-done? [st]
  match st
    | srv-state _ conns remaining ->
        match [nat-eq? remaining 0N]
          | false -> false
          | true  -> match conns
                       | nil      -> true
                       | cons _ _ -> false

;; One step's outcome: the world after it, and the state after it.
data Served
  served : World -> SrvState

spec accept-one ServerH [List ConnH] Nat -> <(w :1 World) -> Served>
defn accept-one [s conns remaining]
  fn [w :1 World]
    match [[net-accept s] w]
      | accepted w2 c ->
          served w2 [srv-state s [cons c conns] [pred remaining]]

;; Echo one frame, or retire the connection when its peer has gone.
spec echo-one ServerH [List ConnH] Nat ConnH -> <(w :1 World) -> Served>
defn echo-one [s conns remaining c]
  fn [w :1 World]
    match [[net-recv c] w]
      | recv w2 payload eof ->
          match eof
            | true  -> served [[net-close-conn c] w2] [srv-state s [remove-conn [conn-id c] conns] remaining]
            | false -> served [[net-send c payload] w2] [srv-state s conns remaining]

spec handle-ready SrvState Nat -> <(w :1 World) -> Served>
defn handle-ready [st ready]
  fn [w :1 World]
    match st
      | srv-state s conns remaining ->
          match [nat-eq? ready [server-id s]]
            | true  -> [[accept-one s conns remaining] w]
            | false -> [[echo-one s conns remaining [conn-h ready]] w]

;; Wait for something to happen, then handle it.
spec serve-once SrvState -> <(w :1 World) -> Served>
defn serve-once [st]
  fn [w :1 World]
    match [[net-sync [watch-list st]] w]
      | synced w2 ready -> [[handle-ready st ready] w2]

;; The loop. Self-recursive only: `serve-once` is defined above and does not
;; call back, because module-level definitions are not forward-referenceable
;; and a mutually recursive pair fails at import with an unbound variable.
spec serve-loop SrvState -> <(w :1 World) -> World>
defn serve-loop [st]
  fn [w :1 World]
    match [srv-done? st]
      | true  -> w
      | false ->
          match [[serve-once st] w]
            | served w2 st2 -> [[serve-loop st2] w2]

;; Serve `n` connections concurrently on `port`, returning when all have
;; closed.
spec serve-n Nat Nat -> <(w :1 World) -> World>
defn serve-n [port n]
  fn [w :1 World]
    match [[net-listen port] w]
      | listening w2 s ->
          [[net-close-server s] [[serve-loop [srv-state s [nil ConnH] n]] w2]]
