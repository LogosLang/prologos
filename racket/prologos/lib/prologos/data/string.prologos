ns prologos::data::string

;; ========================================
;; Prologos String Library
;; Foreign imports for string operations from Racket.
;; ========================================
;; Note: Racket function names with <, > chars use string-quoted names
;; since the WS reader treats < and > as bracket syntax.

;; --- Comparison ---
foreign racket "racket/base" [string=? :as eq : String -> String -> Bool]
foreign racket "racket/base" ["string<?" :as lt : String -> String -> Bool]

;; --- Length & access ---
foreign racket "racket/base" [string-length :as length : String -> Int]
;; UTF-8 byte length (== `length` for ASCII strings, but counts
;; multi-byte chars by their byte count). Needed for wire formats
;; that prefix data with byte counts (e.g. OCapN Syrup).
foreign racket "racket/base" [string-utf-8-length :as bytes-length : String -> Int]
foreign racket "racket/base" [string-ref :as ref : String -> Int -> Char]

;; --- Construction ---
foreign racket "racket/base" [string-append :as append : String -> String -> String]
foreign racket "racket/base" [substring :as slice : String -> Int -> Int -> String]
foreign racket "racket/base" [make-string :as repeat-char : Int -> Char -> String]

;; --- Conversion ---
foreign racket "racket/base" [string :as from-char : Char -> String]
foreign racket "racket/base" ["number->string" :as from-int : Int -> String]

;; --- Search (racket/string) ---
foreign racket "racket/string" [string-contains? :as contains? : String -> String -> Bool]
foreign racket "racket/string" [string-prefix? :as starts-with? : String -> String -> Bool]
foreign racket "racket/string" [string-suffix? :as ends-with? : String -> String -> Bool]

;; --- Case conversion (racket/base) ---
foreign racket "racket/base" [string-upcase :as upper : String -> String]
foreign racket "racket/base" [string-downcase :as lower : String -> String]
foreign racket "racket/base" [string-titlecase :as capitalize : String -> String]

;; --- Unicode normalization (UAX #15) ---
;;
;; The four normalization forms, bridged to Racket rather than reimplemented:
;; the alternative is a UAX #15 decomposition table, and the runtime already
;; carries one.
;;
;; Which one to use, since picking wrong is the usual mistake:
;;
;;   NFC  canonical decomposition then canonical COMPOSITION. Store and
;;        transmit this one; it is what W3C and most wire formats expect.
;;   NFD  canonical decomposition only. For stripping diacritics or indexing
;;        by base letter.
;;   NFKC compatibility decomposition then canonical composition. Folds
;;        formatting distinctions. LOSSY -- search keys and identifier
;;        folding, never round-tripping user data.
;;   NFKD compatibility decomposition only. Lossy in the same way.
;;
;; Canonical equivalence is why this matters: two strings a reader cannot tell
;; apart, and that a font renders identically, are NOT `eq` unless they are in
;; the same form. Normalize both sides before comparing text a person typed.
;;
;; The `NormForm` type and the `normalize` dispatcher live in
;; `prologos::core::string-ops`: this module is a prelude-less leaf, and a
;; `match` over a user `data` needs machinery it does not have.
foreign racket "racket/base" [string-normalize-nfc :as normalize-nfc : String -> String]
foreign racket "racket/base" [string-normalize-nfd :as normalize-nfd : String -> String]
foreign racket "racket/base" [string-normalize-nfkc :as normalize-nfkc : String -> String]
foreign racket "racket/base" [string-normalize-nfkd :as normalize-nfkd : String -> String]
