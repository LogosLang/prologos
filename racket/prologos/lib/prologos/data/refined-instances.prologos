ns prologos::data::refined-instances :no-prelude

require [prologos::data::refined-int :refer [PosInt pos-int NegInt neg-int Zero mk-zero]]
require [prologos::data::refined-rat :refer [PosRat pos-rat NegRat neg-rat]]
require [prologos::core::eq :refer [Eq]]
require [prologos::core::ord :refer [Ord]]
require [prologos::data::ordering :refer [Ordering lt-ord eq-ord gt-ord]]

;; ========================================
;; Eq/Ord instances for the refined numeric types.
;; ========================================
;; Relocated from prologos::core::abstract-domains (Numerics N5a, 2026-06-30).
;; abstract-domains is :refer-all'd into the prelude (namespace.rkt), so keeping
;; these instances there made the prelude transitively require the refined-int/
;; refined-rat WRAPPERS. This module is NOT prelude-loaded, severing that edge —
;; the prelude-safe prerequisite for the N5 refinement-substrate migration (the
;; wrappers are deleted in N5e). Behaviour is unchanged: require this module to
;; get Eq/Ord on the refined types.

;; --- Int family: delegate to the underlying Int ---

impl Eq PosInt
  defn eq? [x <PosInt> y <PosInt>] <Bool>
    match x
      | pos-int a -> match y
                       | pos-int b -> int-eq a b

impl Eq NegInt
  defn eq? [x <NegInt> y <NegInt>] <Bool>
    match x
      | neg-int a -> match y
                       | neg-int b -> int-eq a b

impl Eq Zero
  defn eq? [x <Zero> y <Zero>] <Bool>
    true

impl Ord PosInt
  defn compare [x <PosInt> y <PosInt>] <Ordering>
    match x
      | pos-int a -> match y
                       | pos-int b -> if [int-lt a b] lt-ord [if [int-eq a b] eq-ord gt-ord]

impl Ord NegInt
  defn compare [x <NegInt> y <NegInt>] <Ordering>
    match x
      | neg-int a -> match y
                       | neg-int b -> if [int-lt a b] lt-ord [if [int-eq a b] eq-ord gt-ord]

impl Ord Zero
  defn compare [x <Zero> y <Zero>] <Ordering>
    eq-ord

;; --- Rat family: delegate to the underlying Rat ---

impl Eq PosRat
  defn eq? [x <PosRat> y <PosRat>] <Bool>
    match x
      | pos-rat a -> match y
                       | pos-rat b -> rat-eq a b

impl Eq NegRat
  defn eq? [x <NegRat> y <NegRat>] <Bool>
    match x
      | neg-rat a -> match y
                       | neg-rat b -> rat-eq a b

impl Ord PosRat
  defn compare [x <PosRat> y <PosRat>] <Ordering>
    match x
      | pos-rat a -> match y
                       | pos-rat b -> if [rat-lt a b] lt-ord [if [rat-eq a b] eq-ord gt-ord]

impl Ord NegRat
  defn compare [x <NegRat> y <NegRat>] <Ordering>
    match x
      | neg-rat a -> match y
                       | neg-rat b -> if [rat-lt a b] lt-ord [if [rat-eq a b] eq-ord gt-ord]
