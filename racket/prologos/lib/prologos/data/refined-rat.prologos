ns prologos::data::refined-rat :no-prelude

require [prologos::data::option :refer [Option some none]]

;; ========================================
;; Refined Rational Types — Numerics N5de (Q6 erasure)
;; ========================================
;; PosRat/NegRat are now BUILT-IN nominal-erased types (registered in macros.rkt:
;; `builtin-type-names` + the subtype-registry seeds `PosRat/NegRat <: Rat`). A refined
;; value IS its base (a PosRat is a Rat) at runtime. `(the T e)` is the erased cast.

;; --- Smart constructors (runtime-checked) ---

spec to-pos-rat Rat -> [Option PosRat]
defn to-pos-rat [r]
  if [rat-lt 0/1 r]
    [some (the PosRat r)]
    none

spec to-neg-rat Rat -> [Option NegRat]
defn to-neg-rat [r]
  if [rat-lt r 0/1]
    [some (the NegRat r)]
    none

spec is-zero-rat? Rat -> Bool
defn is-zero-rat? [r]
  rat-eq r 0/1

;; --- Unsafe constructors (caller guarantees the invariant) ---

spec unsafe-pos-rat Rat -> PosRat
defn unsafe-pos-rat [r]
  (the PosRat r)

spec unsafe-neg-rat Rat -> NegRat
defn unsafe-neg-rat [r]
  (the NegRat r)

;; --- Accessors: erased identity (a refined value already IS its base) ---

spec pos-rat-val PosRat -> Rat
defn pos-rat-val [p] p

spec neg-rat-val NegRat -> Rat
defn neg-rat-val [p] p
