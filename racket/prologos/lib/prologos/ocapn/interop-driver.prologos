ns prologos::ocapn::interop-driver

;; ========================================
;; OCapN interop test-server driver — Phase 59
;; ========================================
;;
;; Glue between the Racket TCP test server and the captp-core
;; connection machinery. The server reads one wire frame at a time and
;; calls `step-connection` — one `process-string` per frame, so each
;; frame gets a fresh reduction-fuel budget. The `ConnectionState`
;; persists between frames in ocapn-conn-ffi.rkt's table, keyed by an
;; integer connection id the server assigns. The ConnectionState type
;; is opaque across the FFI: the foreign mechanism passes through any
;; type it does not recognise, so the rich ADT crosses unmarshalled.

require [prologos::ocapn::captp-core :refer [ConnectionState empty-connection
                                              connection-step conn-step-state
                                              ConnStep conn-step-outbound conn-state
                                              conn-vat conn-bridge-state
                                              conn-emitted conn-aborted?
                                              GiftEntry bs-exportable-gifts
                                              bs-set-gifts
                                              bridge-state-empty
                                              signed-give-receiver-key
                                              sig-envelope-object bs-peer-key
                                              syrup-symbol-name syrup-list-or-nil
                                              record-args-of nth-syrup]]
        [prologos::ocapn::vat        :refer [Vat vat Actor actor actor-table-set
                                             promise-table-set vat-dials clear-dials
                                             Allocated vat-spawn alloc-id alloc-vat]]
        [prologos::ocapn::behavior   :refer [OutReq out-dial out-send
                                             beh-echo beh-greeter beh-cell beh-resolver beh-car-factory-builder
                                             beh-sturdyref-enlivener first-sturdyref-arg
                                             beh-sink]]
        [prologos::ocapn::crypto     :refer [side-id-of-encoded-key session-id-of
                                             pubkey-raw]]
        [prologos::ocapn::syrup      :refer [SyrupValue syrup-null syrup-string
                                             syrup-list syrup-nat syrup-tagged
                                             syrup-symbol syrup-bytes syrup-bool
                                             syrup-promise wire-nat]]
        [prologos::ocapn::promise    :refer [fresh]]
        [prologos::ocapn::captp-wire :refer [decode-op encode-op]]
        [prologos::ocapn::message    :refer [CapTPOp op-deliver op-deliver-only
                                             op-abort op-start-session op-listen
                                             op-gc-export op-gc-answer
                                             op-deliver-to-answer
                                             deliver-args deliver-target
                                             deliver-resolver deliver-to-answer?]]
        [prologos::ocapn::syrup-wire :as wire :refer []]
        [prologos::data::nat         :as nat :refer [nat-eq?]]
        [prologos::ocapn::handshake  :refer [hex-to-bytes sig-envelope-bytes
                                             record-bytes list-bytes bytes-atom
                                             gcrypt-pubkey-bytes]]
        [prologos::data::list        :refer [List nil cons append]]
        [prologos::data::string      :as str :refer []]
        [prologos::data::char        :as char :refer []]
        [prologos::data::option      :refer [Option some none unwrap-or]]

;; Per-connection ConnectionState stash (see ocapn-conn-ffi.rkt). `conn-fetch`
;; takes the state to use when nothing was ever stashed for `cid`: the FFI
;; cannot build a ConnectionState itself, and a `#f` from Racket would put a
;; non-ADT where the reducer expects one, which crashes `nf` rather than
;; erroring. Same reason `gift-fetch` takes an empty list.
foreign racket "ocapn-conn-ffi.rkt"
  [ocapn-conn-stash :as conn-stash : Nat -> ConnectionState -> Bool]
foreign racket "ocapn-conn-ffi.rkt"
  [ocapn-conn-fetch :as conn-fetch : Nat -> ConnectionState -> ConnectionState]

;; Outbound-connection requests. A pure behaviour cannot open a socket, so the
;; sturdyref enlivener records where it wants to go and the server dials
;; between steps -- the same shape as the gift table below. Only the server
;; drains the queue (`ocapn-dial-drain`, called from Racket), so there is no
;; declaration for it here.
foreign racket "ocapn-dial-ffi.rkt"
  [ocapn-dial-request :as dial-request : String -> Bool]

;; The connection registry and the outbound-send queue (ocapn-peer-ffi.rkt).
;; Together they are what lets this driver act on a connection OTHER than the
;; one being serviced — the capability a third-party handoff needs, and the
;; reason the gifter and receiver roles used to live in the Racket server.
;;
;; Only the READ side is declared here. Registration happens in the server, at
;; the moment a handshake completes, which is the only place that knows a
;; connection has opened.
foreign racket "ocapn-peer-ffi.rkt"
  [ocapn-peer-lookup :as peer-lookup : String -> Nat]
foreign racket "ocapn-peer-ffi.rkt"
  [ocapn-peer-side-id :as peer-side-id : String -> String]
foreign racket "ocapn-peer-ffi.rkt"
  [ocapn-peer-loc-of :as peer-loc-of : Nat -> String]
;; Did WE open this connection? See the FFI's note: this is the only binding
;; available between a parked give and the peer that gets to redeem it.
foreign racket "ocapn-peer-ffi.rkt"
  [ocapn-peer-dialled? :as peer-dialled? : Nat -> Bool]
foreign racket "ocapn-peer-ffi.rkt"
  [ocapn-send-on :as send-on-conn : Nat -> String -> Bool]

;; The process signing key, by handle (ocapn-identity-ffi.rkt). ONE value:
;; our public key, our side-id and every session id we take part in are all
;; derived from it, and the peer's key is already on the connection
;; (`bs-peer-key`). So this is the whole of the identity substrate a handoff
;; needs, and the reason a role that must sign can now live here.
;;
;; The argument is the fallback used when no server ever set one — a unit
;; test loading this module on its own. Zero is a keypair handle that does not
;; exist, so it errors at the FFI rather than signing with the wrong key, and
;; that is the behaviour we want from a miss.
foreign racket "ocapn-identity-ffi.rkt"
  [ocapn-identity-keypair :as identity-keypair : Nat -> Nat]

;; Gives handed to us and not yet withdrawn (ocapn-give-ffi.rkt). A give
;; arrives on the gifter's connection and is spent on the exporter's, so like
;; the gift table it has to outlive either one. `give-claim` answers "" for a
;; location with nothing waiting, which is what almost every start-session
;; sees.
foreign racket "ocapn-give-ffi.rkt"
  [ocapn-give-park :as give-park : String -> String -> Bool]
foreign racket "ocapn-give-ffi.rkt"
  [ocapn-give-claim :as give-claim : String -> String]
foreign racket "ocapn-give-ffi.rkt"
  [ocapn-handoff-count :as handoff-count : String -> Nat]

;; Enlivens whose fetch is out and whose answer has not come back
;; (ocapn-enliven-ffi.rkt). The answer arrives on the EXPORTER's connection,
;; which knows nothing about the enliven that started it on the receiver's —
;; this is what holds the two together across that gap.
foreign racket "ocapn-enliven-ffi.rkt"
  [ocapn-enliven-park :as enliven-park : String -> String -> Bool]
foreign racket "ocapn-enliven-ffi.rkt"
  [ocapn-enliven-peek :as enliven-peek : String -> String]
foreign racket "ocapn-enliven-ffi.rkt"
  [ocapn-enliven-drop :as enliven-drop : String -> Bool]
foreign racket "ocapn-enliven-ffi.rkt"
  [ocapn-gift-id :as fresh-gift-id : String -> String]

;; The exporter-global gift table (see ocapn-gift-ffi.rkt). A third-party
;; handoff DEPOSITS on the gifter's connection and WITHDRAWS on the receiver's,
;; so this one table has to outlive any single connection. Only DEPOSITED GIFTS
;; belong in it -- parked withdrawals and spent handoff identities are keyed by
;; per-connection values, so `publish-gifts` sends `bs-exportable-gifts` and
;; `bs-set-gifts` re-attaches this connection's own entries.
foreign racket "ocapn-gift-ffi.rkt"
  [ocapn-gift-stash :as gift-stash : Nat -> [List GiftEntry] -> Bool]
foreign racket "ocapn-gift-ffi.rkt"
  [ocapn-gift-fetch :as gift-fetch : Nat -> [List GiftEntry] -> [List GiftEntry]]

spec concat-frames [List String] -> String
  :doc "Concatenate already-encoded outbound wire frames (raw-syrup is self-delimiting, so back-to-back frames need no separator)."
defn concat-frames
  | nil        -> ""
  | cons h t   -> str::append h [concat-frames t]

;; ===========================================================
;; Phase 59b part 2: seed the bootstrap objects
;; ===========================================================
;;
;; The upstream suite calls `fetch_object` before anything else, and
;; `swiss-num-export` (captp-core) maps the Echo swiss-num
;; "IO58l1laTyhcrgDKbEzFOO32MDd6zE5w" to export position 2N. The bridge
;; uses a wire export position DIRECTLY as the vat's actor-table key, so
;; an actor sitting at vat actor id 2N is already reachable from
;; <desc:export 2> — routing needs no new code. What was missing was
;; only the seeding: init-connection stashed `empty-connection`, whose
;; vat has zero actors, so every fetched reference pointed at nothing.
;;
;; `vat-spawn` cannot be used here because it hands out the shared
;; next-id counter rather than accepting a chosen id, so the actor is
;; placed directly with `actor-table-set`. next-id is then set ABOVE the
;; highest seeded id, which is load-bearing: actor ids and promise ids
;; come from the SAME counter (`vat-spawn` / `fresh-promise` in
;; vat.prologos), so leaving it at zero would let `fresh-promise` hand out
;; id 2 and alias Echo. `seeded-next-id` DERIVES it from the seeded
;; positions rather than restating it as a literal.
;;
;; Echo (swiss IO58l1la..., export 2N) and Greeter (swiss VMDDd1vo...,
;; export 1N) are seeded. Greeter became possible in Phase 59b part 3,
;; which gave Vat an `outbound` list so a behaviour can originate a
;; message to a peer export position.
;;
;; `swiss-num-export` (captp-core) maps five swiss-nums, 1N through 5N.
;; Four of them have an actor here: Greeter 1N, Echo 2N, the Car Factory
;; builder 3N (`eff-spawn` exists — behavior.prologos — so the builder can
;; spawn), and the promise-resolver 4N with its pre-seeded (vow, resolver)
;; pair below.
;;
;; Position 5N, the sturdyref enlivener, IS an ordinary actor (see
;; `seeded-vat` below). It used to have none: a behaviour is pure and cannot
;; open a socket — which is why this used to be
;; a driver interception with NO actor behind the position at all. With
;; `eff-connect` and `act-step-pending` the enlivener is an ordinary actor:
;; it asks for the connection as an effect and answers nothing, leaving the
;; peer's promise for the reply the driver builds.


;; ===========================================================
;; The promise-resolver object (upstream swiss-num
;; IokCxYmMj04nos2JN1TDoY1bT8dXh6Lr, already mapped to export 4)
;; ===========================================================
;;
;; Upstream calls it with NO arguments and expects the answer
;;   ['fulfill [<desc:import-object VOW> <desc:import-object RESOLVER>]]
;; then listens on VOW and settles it by messaging RESOLVER.
;;
;; The pair is PRE-SEEDED here rather than created per call. That is
;; sound for the upstream suite because every test that asks for a pair
;; asks EXACTLY ONCE, on its own fresh connection
;; (`op_listen.py` — three tests, one `make_promise_resolver_pair()`
;; each, each after its own `netlayer.connect`). Verified by reading the
;; tests, not assumed.
;;
;; Doing it this way is what keeps the change small: creating the pair
;; on demand would mean a behaviour allocating a promise and spawning an
;; actor mid-turn, which needs ids that only exist AFTER the vat
;; interprets the effects — the chicken-and-egg that forces a
;; `step-behavior` signature change. Reserving the ids at connection
;; setup is the same "pre-allocated ids" answer applied statically.
;; KNOWN LIMIT: one pair per connection. The dynamic version is only
;; forced by the Car Factory, which must return a reference to something
;; it spawns.
;;
;; No new behaviours are needed:
;;   - the object itself is `beh-cell`, which returns its state unchanged
;;     for a list-shaped argument — and its state IS the pair;
;;   - the resolver is `beh-fulfiller`, whose state is `syrup-promise
;;     pid` and which emits `eff-resolve pid args` on any message.

def resolver-vow-pos      : Nat := 6N
def resolver-actor-pos    : Nat := 7N
def promise-resolver-pos  : Nat := 4N
;; The swiss-num JadQ0++… maps to export 3 in `swiss-num-export`; this is
;; the object that has to be sitting there for the Car Factory chain.
def car-factory-builder-pos : Nat := 3N
;; swiss gi02I1qgh… -> export 5 in `swiss-num-export`.
def sturdyref-enlivener-pos : Nat := 5N

spec import-object-desc Nat -> SyrupValue
defn import-object-desc [n]
  syrup-tagged "desc:import-object" [syrup-nat n]

;; The value the promise-resolver object returns: the (vow, resolver) pair.
def resolver-pair : SyrupValue :=
  [syrup-list [cons [import-object-desc resolver-vow-pos]
                    [cons [import-object-desc resolver-actor-pos] nil]]]

;; The highest id this file hands out that does NOT come from a parameter.
;; `sturdyref-enlivener-pos` is in here even though 5N gets no actor: the peer
;; can still name it, so nothing else may be allocated there. Split across
;; three defs because a continuation line starting with a bare identifier
;; parses as a sibling form, so each of these has to fit on one line.
def max-bootstrap-pos : Nat := [nat::max car-factory-builder-pos [nat::max promise-resolver-pos sturdyref-enlivener-pos]]
def max-resolver-pos  : Nat := [nat::max resolver-vow-pos resolver-actor-pos]
def seeded-max-fixed  : Nat := [nat::max max-bootstrap-pos max-resolver-pos]

spec seeded-next-id Nat Nat -> Nat
  :doc "One above every id seeded into the vat. DERIVED, not a literal: actor ids and promise ids come from the same counter, so a next-id at or below a seeded id would let `fresh-promise` alias an actor, and seeding a sixth object must not silently reintroduce that."
defn seeded-next-id [echo-pos greeter-pos]
  [suc [nat::max [nat::max echo-pos greeter-pos] seeded-max-fixed]]

spec seeded-vat Nat Nat -> Vat
  :doc "A vat holding the Echo, Greeter and promise-resolver objects at the export positions `fetch` hands out, plus the pre-seeded (vow, resolver) pair. next-id starts above every seeded id so promise allocation cannot alias an actor."
defn seeded-vat [echo-pos greeter-pos]
  [vat [seeded-next-id echo-pos greeter-pos]
       [actor-table-set echo-pos [actor beh-echo syrup-null]
         [actor-table-set greeter-pos [actor beh-greeter [syrup-string "Hello"]]
           [actor-table-set car-factory-builder-pos [actor beh-car-factory-builder syrup-null]
             [actor-table-set promise-resolver-pos [actor beh-cell resolver-pair]
               [actor-table-set resolver-actor-pos [actor beh-resolver [syrup-promise resolver-vow-pos]]
                 [actor-table-set sturdyref-enlivener-pos [actor beh-sturdyref-enlivener syrup-null] nil]]]]]]
       [promise-table-set resolver-vow-pos fresh nil]
       nil nil nil]

def seeded-connection : ConnectionState :=
  [conn-state [seeded-vat 2N 1N] bridge-state-empty nil false]

spec init-connection Nat -> Bool
  :doc "Set up fresh per-connection captp-core state for connection `cid`, with the bootstrap objects seeded."
defn init-connection [cid]
  conn-stash cid seeded-connection

;; ===========================================================
;; Reserving an export position
;; ===========================================================
;;
;; Hand out an export position in connection `cid`'s OWN table, backed by a
;; real (if inert) actor, and return it as decimal digits.
;;
;; The gifter path needs a resolve-me to put in the `fetch` it sends to an
;; exporter, and the exporter answers it as `<desc:export N>` on the
;; exporter's connection — so N has to be a position that connection actually
;; holds. It used to be a Racket counter starting at 900, reserved from the
;; vat's allocator by nothing but the distance between 900 and wherever
;; `next-id` had got to (gaps document §1.7 M7). This makes the reservation
;; structural: the id comes from the same allocator everything else does, so
;; it cannot collide by construction rather than by margin.
;;
;; `beh-sink` is what sits there. It absorbs the exporter's answer and does
;; not reply — the real handling is elsewhere — which is only expressible
;; because `act-step-pending` exists.
;; Zero on a failed stash. Zero is the BOOTSTRAP position, so it is not a
;; plausible reservation — a fetch addressed to it is answered by the
;; bootstrap object rather than going silently nowhere, which is the loudest
;; failure available here without an exception.
spec reserve-export-id Nat -> Nat
defn reserve-export-id [cid]
  let cs := [conn-fetch cid seeded-connection]
    let alloc := [vat-spawn beh-sink syrup-null [conn-vat cs]]
      match [conn-stash cid [conn-state [alloc-vat alloc] [conn-bridge-state cs] [conn-emitted cs] [conn-aborted? cs]]]
        | true  -> [alloc-id alloc]
        | false -> zero

;; Force the stash side effect — matching the Bool result drives its
;; evaluation — then return the concatenated outbound bytes.
;;
;; The arms are DELIBERATELY different. `conn-stash` cannot fail today (the
;; FFI returns #t unconditionally), so the false arm is unreachable; writing
;; it as `[concat-frames outbound]` too would make the match a pair of
;; identical arms that any arm-collapsing rewrite is entitled to fold away —
;; and folding it away deletes the stash. Emitting nothing is also the right
;; answer if the stash ever does fail: replying while our own state was lost
;; leaves the peer believing we are tracking a session we are not.
spec emit-after-stash Bool [List String] -> String
defn emit-after-stash [stashed outbound]
  match stashed
    | true  -> [concat-frames outbound]
    | false -> ""

;; Seed a connection's bridge state with the exporter-global gift table, so a
;; withdraw arriving on THIS connection can see a deposit made on another one.
;; `bs-set-gifts` takes only the deposited gifts from the global table and
;; keeps this connection's own park/used entries, which is what stops one
;; connection's parked withdrawal from being settled by another's `op:listen`.
spec with-global-gifts ConnectionState -> ConnectionState
defn with-global-gifts [cs]
  [conn-state [conn-vat cs]
              [bs-set-gifts [gift-fetch 0N [nil GiftEntry]] [conn-bridge-state cs]]
              [conn-emitted cs]
              [conn-aborted? cs]]

;; Force the publish side-effect (matching the Bool result) and hand back the
;; state, so the gifts this step deposited are visible to every other
;; connection.
;;
;; `bs-exportable-gifts`, NOT the whole table: park entries are keyed by a
;; local promise id and used-markers by a handoff identity, and every
;; connection's vat seeds its promise ids from the same counter — publishing
;; them globally made connection A's park on its promise 8 and connection B's
;; promise 8 the same key, so B's ordinary `op:listen` settled with A's gift
;; and destroyed A's pending handoff. No attacker needed, just two sessions.
;;
;; Both arms return `cs`: `gift-stash` cannot fail, and if it somehow did there
;; is nothing better to hand back than the state we already have. Unlike
;; `emit-after-stash` there is no honest way to make the arms differ.
spec publish-gifts ConnectionState -> ConnectionState
defn publish-gifts [cs]
  match [gift-stash 0N [bs-exportable-gifts [conn-bridge-state cs]]]
    | true  -> cs
    | false -> cs

;; ===========================================================
;; The sturdyref enlivener — our one outbound-connection trigger
;; ===========================================================
;;
;; Upstream's enlivener (swiss gi02I1qgh…) takes a sturdyref and is expected to
;; CONNECT to the peer it names. It is the only thing on the PROLOGOS side that
;; ever dials — the Racket test server dials too, from `note-handoff-give!`,
;; on a location it scrapes out of a handoff-give (see the gaps document
;; §1.9 M1, still open).
;;
;; It is handled here rather than as a behaviour because a behaviour is pure —
;; it cannot open a socket, and it cannot reach the FFI queue above. The driver
;; can, and the driver is already where per-step side effects live (the gift
;; table publishes from exactly here).
;;
;; What gets queued is the sturdyref RE-ENCODED to bytes, not a parsed
;; location: parsing it is the dialler's job, and re-encoding is the operation
;; that reproduces the peer's own bytes (see syrup-wire § Re-encoder).
;;
;; The argument IS checked before it is queued. This path makes us open an
;; outbound TCP connection on peer-chosen bytes, so accepting any first
;; argument at all would let a peer point the
;; dialler wherever it liked with a record of any shape. Upstream's sturdyref
;; is `<ocapn-sturdyref <ocapn-peer transport address hints> swiss-num>`
;; (utils/ocapn_uris.py), and the label is what we gate on — the interior is
;; the dialler's to parse and reject.

;; ===========================================================
;; Third-party handoff — the RECEIVER and GIFTER roles
;; ===========================================================
;;
;; Both used to live in the Racket test server as byte-scanners running over
;; every inbound frame ALONGSIDE captp-core, each with its own second Syrup
;; parser (gaps document §1.7 M8, §0.2). They could not move for two concrete
;; reasons: a handoff role has to SIGN, and it has to act on a connection
;; other than the one it is servicing. `sig-envelope-bytes` over the process
;; keypair and the connection registry are exactly those two capabilities.
;;
;; They are in the DRIVER rather than in behaviours, and that is a finding
;; rather than a shortcut: a handoff is protocol machinery, not application
;; logic. A behaviour is an object a peer can name and message; a handoff role
;; is none of those things — it has no swiss-num, answers no message of its
;; own, and needs to name connections, which is precisely what a behaviour
;; must not do. The driver is where per-step side effects already live.
;;
;; This is OBSERVATION, not the interception §0.3 removed. Every op still goes
;; through `connection-step`; nothing is handled instead of the bridge.
;;
;; Everything below is in DEPENDENCY ORDER. Modules are single-pass, and a
;; forward reference here does not error — it reduces to a stuck term that is
;; perfectly well-typed, so the only symptom is a handoff that quietly does
;; nothing until an FFI marshaller refuses the term far away. See pitfall #52.

;; --- Naming a peer ---

;; A real NUL, built rather than written as a literal: an escape in a string
;; literal is a reader question, and this has to be exactly byte 0.
def nul-string : String := [str::from-char [char::from-code 0]]

;; Text out of whichever atom carries it. A transport name reaches us as a
;; symbol from one implementation and a string from another, and a designator
;; can be either or a bytestring; all three are the same text to a location
;; key. Everything else has no text, and says so rather than guessing.
spec syrup-text-of SyrupValue -> [Option String]
defn syrup-text-of [v]
  match v
    | syrup-symbol s -> some s
    | syrup-string s -> some s
    | syrup-bytes  s -> some s
    | _              -> [none String]

;; NUL-joined because neither component may contain one, so the join is
;; injective — "a" + "bc" and "ab" + "c" must not collide into one peer.
spec key-of-transport-designator SyrupValue SyrupValue -> [Option String]
defn key-of-transport-designator [t d]
  match [syrup-text-of t]
    | none    -> [none String]
    | some ts ->
        match [syrup-text-of d]
          | none    -> [none String]
          | some ds -> some [str::append ts [str::append nul-string ds]]

;; The identity of a PEER, independent of how to reach it: transport and
;; designator, with hints dropped. Two locators differing only in hints name
;; the same peer, and the give's copy of a location need not carry the hints
;; the peer itself advertises when it connects. This is the key the connection
;; registry is written under (`record-open-conn!` in the server), so the two
;; must agree — both are transport, NUL, designator.
spec peer-location-key SyrupValue -> [Option String]
defn peer-location-key [v]
  let args := [record-args-of "ocapn-peer" v]
    match [nth-syrup args zero]
      | none   -> [none String]
      | some t ->
          match [nth-syrup args 1N]
            | none   -> [none String]
            | some d -> key-of-transport-designator t d

;; Our own raw Ed25519 public key — what a give must name for us to act on it.
spec our-public-key Unit -> String
defn our-public-key [u]
  pubkey-raw [identity-keypair 0N]

;; Our side-id: the doubled hash of our ENCODED public-key s-expression. Not
;; of the raw key — see `side-id-of-encoded-key`, where getting this wrong is
;; invisible until a session id disagrees several frames later.
spec our-side-id Unit -> String
defn our-side-id [u]
  side-id-of-encoded-key [gcrypt-pubkey-bytes [our-public-key unit]]

;; --- Frame pieces shared by both roles ---

def false-bytes : String := [wire::encode [syrup-bool false]]

spec export-zero-bytes Unit -> String
defn export-zero-bytes [u]
  record-bytes "desc:export" [cons [wire::encode [syrup-nat 0N]] nil]

;; --- The RECEIVER: building the withdraw ---

;; <desc:handoff-receive SESSION OUR-SIDE COUNT SIGNED-GIVE>
;;
;; The signed give is spliced VERBATIM, exactly as the gifter sent it. Its
;; signature covers its own bytes, so re-encoding a decoded copy risks
;; producing a give whose signature no longer verifies — over a difference we
;; would never see.
spec handoff-receive-bytes String String Nat String -> String
defn handoff-receive-bytes [session our-side count signed-give]
  record-bytes "desc:handoff-receive"
    [cons [bytes-atom session]
      [cons [bytes-atom our-side]
        [cons [wire::encode [syrup-nat count]]
          [cons signed-give nil]]]]

;; <op:deliver <desc:export 0> ['withdraw-gift ENVELOPE] f f>
spec withdraw-frame-bytes String -> String
defn withdraw-frame-bytes [env]
  record-bytes "op:deliver"
    [cons [export-zero-bytes unit]
      [cons [list-bytes [cons [wire::encode [syrup-symbol "withdraw-gift"]] [cons env nil]]]
        [cons false-bytes [cons false-bytes nil]]]]

;; The whole frame, signed. The count is drawn HERE, after we know there is a
;; give to redeem: drawing it earlier would burn a count on every
;; start-session, and a count is not just a number — upstream refuses a repeat
;; within a session as a replay, so the sequence has to be dense.
spec withdraw-bytes String String -> String
defn withdraw-bytes [their-side signed-give]
  let session := [session-id-of [our-side-id unit] their-side]
    let body := [handoff-receive-bytes session [our-side-id unit] [handoff-count session] signed-give]
      withdraw-frame-bytes [sig-envelope-bytes [identity-keypair 0N] body]

;; --- The RECEIVER: redeeming when a session OPENS ---
;;
;; The frame goes out as part of THIS step's outbound rather than through the
;; connection registry. The registry resolves a location to the newest
;; connection, and a peer with two concurrent sessions would then get the
;; withdraw on whichever one opened last; the step knows exactly which
;; connection it is on.

spec withdraw-if-give String String -> [List String]
defn withdraw-if-give [loc-key their-side]
  let signed-give := [give-claim loc-key]
    match [str::eq signed-give ""]
      | true  -> [nil String]
      | false -> [cons [withdraw-bytes their-side signed-give] nil]

;; The peer's key reaches us as the DECODED s-expression and is re-encoded
;; here, because the side-id hashes the encoded form. Re-encoding is exact for
;; a gcrypt sexp — nested lists of symbols and byte atoms, none of the shapes
;; (dicts, floats, sets) where an encoder can legitimately differ.
spec withdraw-for-session SyrupValue SyrupValue -> [List String]
defn withdraw-for-session [pk loc]
  match [peer-location-key loc]
    | none    -> [nil String]
    | some lk -> withdraw-if-give lk [side-id-of-encoded-key [wire::encode pk]]

;; A start-session is where a peer tells us who it is and where it lives,
;; which is exactly what a parked give is keyed on — so it is the only op that
;; can redeem one.
spec withdraw-frames-dialled CapTPOp -> [List String]
defn withdraw-frames-dialled [op]
  match op
    | op-start-session _ pk loc -> withdraw-for-session pk loc
    | _                         -> [nil String]

;; ONLY over a connection we dialled.
;;
;; A give names its exporter by location, never by key, so "the peer that
;; opened this session asserts the exporter's designator" proves nothing — any
;; peer may assert any designator, and the handshake signature only binds the
;; assertion to the asserter. Redeeming on an ACCEPTED session hands our signed
;; handoff-receive, with the gifter's give inside it, to whoever asked first;
;; it also destroys the honest handoff, because the claim removes.
;;
;; Restricting to connections we opened — to an address taken from the give
;; itself — is the strongest binding the protocol data allows. It is not
;; cryptographic: `tcp-testing-only` designators are unauthenticated by
;; construction, so a peer that can occupy the address the give names is still
;; the peer we will talk to. Closing that needs the give to carry the
;; exporter's KEY, which is an upstream protocol question.
spec withdraw-frames Nat CapTPOp -> [List String]
defn withdraw-frames [cid op]
  match [peer-dialled? cid]
    | false -> [nil String]
    | true  -> withdraw-frames-dialled op

;; --- The RECEIVER: recognising a give, and reaching its exporter ---
;;
;; The give is located by walking the DECODED op, never by scanning raw bytes
;; for `<17'desc:handoff-give`: a bytestring argument may contain any bytes at
;; all, including that exact pattern, and the consequence of a false positive
;; is an outbound TCP connection to a host:port the peer chose. Two further
;; gates for the same reason — the give must name OUR key as the receiver, and
;; the location must parse as an `ocapn-peer`.

;; `<desc:handoff-give k LOCATION …>` -> arg 1, the exporter's location.
spec give-location SyrupValue -> [Option SyrupValue]
defn give-location [hg]
  nth-syrup [record-args-of "desc:handoff-give" hg] 1N

;; What the dialler is handed. It parses an `ocapn-sturdyref`, not a bare
;; location, so the give's location is wrapped in one — the swiss-num is a
;; placeholder because we are not fetching an object, only opening the session
;; the withdraw will go out on.
spec handoff-sturdyref-bytes SyrupValue -> String
defn handoff-sturdyref-bytes [loc]
  record-bytes "ocapn-sturdyref"
    [cons [wire::encode loc] [cons [bytes-atom "handoff"] nil]]

;; A withdraw over a session that is ALREADY open. `peer-side-id` is why the
;; registry carries one: finding the connection is not enough, the receive has
;; to name the session, and that is derived from the two side-ids.
;; KNOWN RESIDUAL RACE, stated rather than half-fixed. `peer-side-id` here and
;; the `peer-lookup` inside `do-send-on` are two separate registry reads, so a
;; connection closing between them yields a receive signed over an empty
;; side-id — a well-formed frame naming a session nobody has.
;;
;; A compound `(cid, side-id)` read does NOT close it: the send resolves the
;; cid again later, so the atomicity has to reach as far as the write. Closing
;; it properly means threading the cid through `out-send` so the send targets
;; the connection whose side-id we signed with, which is a change to `OutReq`
;; and every producer. Not done here; named so it is not mistaken for safe.
spec withdraw-over-open-session String -> [Option OutReq]
defn withdraw-over-open-session [lk]
  let signed-give := [give-claim lk]
    match [str::eq signed-give ""]
      | true  -> [none OutReq]
      | false -> some [out-send lk [withdraw-bytes [peer-side-id lk] signed-give]]

;; Reach the exporter. If a session with it is already open we withdraw on
;; that one directly; otherwise we ask for a connection and the withdraw goes
;; out when the session opens (`withdraw-frames`).
;;
;; Both branches are needed. Dialling a peer we already have is refused by the
;; dialler ("a session to that peer is already open") and the give would then
;; sit parked forever with nothing logged — which is precisely why the Racket
;; version called its redeem from the dial-skip path as well as from the two
;; handshake paths.
spec reach-over-existing Nat String SyrupValue -> [Option OutReq]
defn reach-over-existing [cid lk loc]
  match [peer-dialled? cid]
    | true  -> withdraw-over-open-session lk
    | false -> some [out-dial [handoff-sturdyref-bytes loc]]

;; Reuse an open session ONLY if we dialled it — same binding as
;; `withdraw-frames`, and for the same reason. An accepted session to the
;; asserted location is exactly the case an attacker can manufacture, so
;; falling through to a dial there is the safe answer, not a missed
;; optimisation.
spec reach-exporter String SyrupValue -> [Option OutReq]
defn reach-exporter [lk loc]
  let cid := [peer-lookup lk]
    match [nat-eq? cid zero]
      | true  -> some [out-dial [handoff-sturdyref-bytes loc]]
      | false -> reach-over-existing cid lk loc

;; Force the park (by matching its Bool) before deciding how to reach the
;; exporter. Lazy reduction would otherwise drop the park outright — and the
;; already-open branch immediately claims what this just parked, so a dropped
;; park is a withdraw over an empty give, with no error at all.
spec park-then-reach String String SyrupValue -> [Option OutReq]
defn park-then-reach [lk give-bytes loc]
  match [give-park lk give-bytes]
    | false -> [none OutReq]
    | true  -> reach-exporter lk loc

spec park-give-at-location SyrupValue SyrupValue -> [Option OutReq]
defn park-give-at-location [sg loc]
  match [peer-location-key loc]
    | none    -> [none OutReq]
    | some lk -> park-then-reach lk [wire::encode sg] loc

spec give-park-and-reach SyrupValue SyrupValue -> [Option OutReq]
defn give-park-and-reach [sg hg]
  match [give-location hg]
    | none     -> [none OutReq]
    | some loc -> park-give-at-location sg loc

spec give-for-us SyrupValue -> [Option OutReq]
defn give-for-us [sg]
  match [sig-envelope-object sg]
    | none    -> [none OutReq]
    | some hg -> give-park-and-reach sg hg

;; One argument: a signed give naming US as the receiver, or nothing to do.
spec give-to-out-req SyrupValue -> [Option OutReq]
defn give-to-out-req [sg]
  match [signed-give-receiver-key sg]
    | none    -> [none OutReq]
    | some rk ->
        match [str::eq rk [our-public-key unit]]
          | false -> [none OutReq]
          | true  -> give-for-us sg

;; Every give addressed to us in one op's arguments.
;;
;; TOP-LEVEL arguments only, deliberately narrower than the Racket scan it
;; replaces (which walked the whole frame). A give is HANDED OVER, as an
;; argument — upstream's own test delivers `[signed_handoff_give]` to the
;; greeter — and a give buried inside some other structure is not one we were
;; handed. Narrowing the gate narrows what a peer can make us dial.
spec gives-in-args [List SyrupValue] -> [List OutReq]
defn gives-in-args
  | nil        -> [nil OutReq]
  | cons a rest ->
      match [give-to-out-req a]
        | none   -> gives-in-args rest
        | some r -> [cons r [gives-in-args rest]]

spec gives-in-op CapTPOp -> [List OutReq]
defn gives-in-op [op]
  match [deliver-args op]
    | none   -> [nil OutReq]
    | some a -> gives-in-args [syrup-list-or-nil a]

;; --- The GIFTER ---
;;
;; An enliven arrives on the receiver's connection naming an object on a THIRD
;; peer. We fetch that object from the exporter, deposit it there as a gift,
;; and answer the enliven with a signed `desc:handoff-give` the receiver can
;; redeem.

;; Every field of a `desc:handoff-give` is known when the enliven arrives: the
;; receiver's key from the connection it came in on, the exporter's location
;; from the sturdyref, the exporter session from the two side-ids, the gifter
;; side from ours, and the gift id because we mint it. Only the DEPOSIT needs
;; the fetch answer, because only the deposit names the object.
;;
;; Field values are pinned by upstream's own assertions
;; (third_party_handoffs.py:458-462): receiver-key belongs to the ENLIVENING
;; peer, while exporter-location / session / gifter-side all belong to the
;; EXPORTER session — and gifter-side is OUR side-id, because from the
;; exporter's point of view we are the gifter.
spec handoff-give-bytes String String String String String -> String
defn handoff-give-bytes [receiver-key loc session our-side gid]
  record-bytes "desc:handoff-give"
    [cons receiver-key
      [cons loc
        [cons [bytes-atom session]
          [cons [bytes-atom our-side]
            [cons [bytes-atom gid] nil]]]]]

;; <op:deliver <desc:export 0> ['fetch SWISS] f <desc:import-object SLOT>>
spec fetch-frame-bytes String Nat -> String
defn fetch-frame-bytes [swiss slot]
  record-bytes "op:deliver"
    [cons [export-zero-bytes unit]
      [cons [list-bytes [cons [wire::encode [syrup-symbol "fetch"]] [cons [bytes-atom swiss] nil]]]
        [cons false-bytes
          [cons [record-bytes "desc:import-object" [cons [wire::encode [syrup-nat slot]] nil]] nil]]]]

;; <op:deliver <desc:export 0> ['deposit-gift GID <desc:export REF>] f f>
spec deposit-frame-bytes String Nat -> String
defn deposit-frame-bytes [gid ref]
  record-bytes "op:deliver"
    [cons [export-zero-bytes unit]
      [cons [list-bytes
              [cons [wire::encode [syrup-symbol "deposit-gift"]]
                [cons [bytes-atom gid]
                  [cons [record-bytes "desc:export" [cons [wire::encode [syrup-nat ref]] nil]] nil]]]]
        [cons false-bytes [cons false-bytes nil]]]]

;; <op:deliver <desc:export RM> ['fulfill SIGNED-GIVE] f f>
spec answer-enliven-bytes Nat String -> String
defn answer-enliven-bytes [rm env]
  record-bytes "op:deliver"
    [cons [record-bytes "desc:export" [cons [wire::encode [syrup-nat rm]] nil]]
      [cons [list-bytes [cons [wire::encode [syrup-symbol "fulfill"]] [cons env nil]]]
        [cons false-bytes [cons false-bytes nil]]]]

;; Keyed by exporter connection and the export position we reserved on it:
;; that pair is what the exporter's answer is addressed to, and it is the only
;; thing in that answer we chose.
spec enliven-key Nat Nat -> String
defn enliven-key [cid slot]
  str::append [str::from-int [from-nat cid]] [str::append ":" [str::from-int [from-nat slot]]]

;; The parked fields, carried as Syrup rather than as an FFI signature so the
;; field list lives in ONE place — here, the only thing that reads it.
spec pending-enliven-blob String Nat String String String -> String
defn pending-enliven-blob [requester-loc rm exporter-loc give gid]
  wire::encode
    [syrup-list [cons [syrup-string requester-loc]
                  [cons [syrup-nat rm]
                    [cons [syrup-string exporter-loc]
                      [cons [syrup-string give]
                        [cons [syrup-string gid] nil]]]]]]

;; The exporter's session id, from our side-id and the one the registry
;; recorded when that connection opened.
spec exporter-session-id String -> String
defn exporter-session-id [lk]
  session-id-of [our-side-id unit] [peer-side-id lk]

;; The receiver's key, as the ENCODED public-key s-expression the give must
;; carry. `bs-peer-key` holds the raw q, so it is rebuilt rather than stored
;; twice.
spec receiver-key-bytes ConnectionState -> String
defn receiver-key-bytes [cs]
  gcrypt-pubkey-bytes [bs-peer-key [conn-bridge-state cs]]

;; `<ocapn-sturdyref LOCATION SWISS>` -> its two fields.
spec sturdyref-location SyrupValue -> [Option SyrupValue]
defn sturdyref-location [v]
  nth-syrup [record-args-of "ocapn-sturdyref" v] zero

spec sturdyref-swiss SyrupValue -> [Option String]
defn sturdyref-swiss [v]
  match [nth-syrup [record-args-of "ocapn-sturdyref" v] 1N]
    | none   -> [none String]
    | some s -> syrup-text-of s

spec first-arg SyrupValue -> [Option SyrupValue]
defn first-arg [args]
  nth-syrup [syrup-list-or-nil args] zero

;; Force the park before emitting the fetch. Lazy reduction will drop it
;; otherwise — nothing matches on its result — and then the fetch goes out
;; while its answer arrives with nothing to match it against, which presents
;; as a handoff that stalls with no error anywhere.
spec park-then-fetch String String String Nat String -> [Option OutReq]
defn park-then-fetch [key blob swiss slot lk]
  match [enliven-park key blob]
    | false -> [none OutReq]
    | true  -> some [out-send lk [fetch-frame-bytes swiss slot]]

;; A `let` value may not span lines — the reader loses the binding and the
;; form escapes to top level (pitfall #53) — so the give is built by a helper
;; rather than by a five-argument call broken across two.
spec give-for-handoff ConnectionState String SyrupValue String -> String
defn give-for-handoff [cs lk loc gid]
  handoff-give-bytes [receiver-key-bytes cs] [wire::encode loc] [exporter-session-id lk] [our-side-id unit] gid

spec begin-handoff-on Nat ConnectionState String SyrupValue String Nat Nat -> [Option OutReq]
defn begin-handoff-on [cid cs lk loc swiss rm ecid]
  let gid := [fresh-gift-id "prologos-gift-"]
    let slot := [reserve-export-id ecid]
      park-then-fetch [enliven-key ecid slot] [pending-enliven-blob [peer-loc-of cid] rm lk [give-for-handoff cs lk loc gid] gid] swiss slot lk

;; No connection to the exporter yet means no handoff: the enlivener
;; behaviour has already asked for the dial, and the enliven is not retried.
;; That is the Racket version's behaviour too, and it is a known limit rather
;; than a decision.
spec begin-handoff Nat ConnectionState String SyrupValue String Nat -> [Option OutReq]
defn begin-handoff [cid cs lk loc swiss rm]
  let ecid := [peer-lookup lk]
    match [nat-eq? ecid zero]
      | true  -> [none OutReq]
      | false -> begin-handoff-on cid cs lk loc swiss rm ecid

spec enliven-with-sturdyref Nat ConnectionState SyrupValue Nat -> [Option OutReq]
defn enliven-with-sturdyref [cid cs sr rm]
  match [sturdyref-location sr]
    | none     -> [none OutReq]
    | some loc ->
        match [sturdyref-swiss sr]
          | none       -> [none OutReq]
          | some swiss ->
              match [peer-location-key loc]
                | none    -> [none OutReq]
                | some lk -> begin-handoff cid cs lk loc swiss rm

spec enliven-with-args Nat ConnectionState SyrupValue Nat -> [Option OutReq]
defn enliven-with-args [cid cs args rm]
  match [first-arg args]
    | none    -> [none OutReq]
    | some sr -> enliven-with-sturdyref cid cs sr rm

spec opt-to-list [Option OutReq] -> [List OutReq]
defn opt-to-list [o]
  match o
    | none   -> [nil OutReq]
    | some r -> [cons r [nil OutReq]]

spec enliven-for-target Nat ConnectionState CapTPOp -> [List OutReq]
defn enliven-for-target [cid cs op]
  match [deliver-resolver op]
    | none    -> [nil OutReq]
    | some rm ->
        match [deliver-args op]
          | none   -> [nil OutReq]
          | some a -> opt-to-list [enliven-with-args cid cs a rm]

;; The gate is STRUCTURAL: a deliver, to the enlivener's export position,
;; carrying a resolve-me, whose first argument is an `ocapn-sturdyref`. The
;; scan this replaces fired on any frame containing the bytes
;; `<15'ocapn-sturdyref` anywhere — including inside a bytestring argument —
;; and took the FIRST `desc:import-object` in the whole frame as the reply
;; target, which on the wire is an ARGUMENT, since args precede resolve-me.
spec enliven-for-export Nat ConnectionState CapTPOp -> [List OutReq]
defn enliven-for-export [cid cs op]
  match [deliver-target op]
    | none   -> [nil OutReq]
    | some t ->
        match [nat-eq? t sturdyref-enlivener-pos]
          | false -> [nil OutReq]
          | true  -> enliven-for-target cid cs op

;; --- The GIFTER: finishing on the exporter's answer ---

;; A reference reaches us as whichever descriptor the exporter chose; all
;; three name a position, and that position is what a deposit carries.
;; Same export-namespace gate as `fetch-answer-out-reqs`, for the same reason:
;; `op:deliver-to-answer 5` is a peer-chosen answer slot, not our enlivener.
spec enliven-out-reqs Nat ConnectionState CapTPOp -> [List OutReq]
defn enliven-out-reqs [cid cs op]
  match [deliver-to-answer? op]
    | true  -> [nil OutReq]
    | false -> enliven-for-export cid cs op

spec desc-tag? String -> Bool
defn desc-tag? [tag]
  match [str::eq tag "desc:import-object"]
    | true  -> true
    | false ->
        match [str::eq tag "desc:export"]
          | true  -> true
          | false -> str::eq tag "desc:import-promise"

;; `wire-nat`, not a `syrup-nat` match. A wire nat decodes as EITHER
;; `syrup-nat` or a non-negative `syrup-int` (see `wire-nat-ok?` in
;; captp-wire), so a hand-rolled match on the first spelling silently misses
;; the second — and the codec's own predicate is the authority on which
;; spellings are one number.
spec nat-of-syrup [Option SyrupValue] -> [Option Nat]
defn nat-of-syrup [o]
  match o
    | none   -> [none Nat]
    | some v -> wire-nat v

;; A SINGLE-argument record's payload is the VALUE ITSELF, not a one-element
;; list. `<desc:import-object 0>` decodes to `syrup-tagged "desc:import-object"
;; <the number>`, so `syrup-list-or-nil` on it answers nil and every
;; list-shaped reader finds zero arguments — `record-args-of` included.
;;
;; That is why the multi-field records here (desc:handoff-give with five,
;; ocapn-peer with three, desc:sig-envelope with two) read fine through
;; `record-args-of` while the one-field descriptors silently produced nothing.
;; Both shapes are accepted rather than guessed at.
spec nat-of-payload SyrupValue -> [Option Nat]
defn nat-of-payload [payload]
  match [wire-nat payload]
    | some n -> some n
    | none   -> nat-of-syrup [nth-syrup [syrup-list-or-nil payload] zero]

spec desc-position-for String SyrupValue -> [Option Nat]
defn desc-position-for [tag payload]
  match [desc-tag? tag]
    | false -> [none Nat]
    | true  -> nat-of-payload payload

spec desc-position SyrupValue -> [Option Nat]
defn desc-position [v]
  match v
    | syrup-tagged tag payload -> desc-position-for tag payload
    | _                        -> [none Nat]

spec ref-position [Option SyrupValue] -> [Option Nat]
defn ref-position [o]
  match o
    | none   -> [none Nat]
    | some v -> desc-position v

;; `['fulfill REF]` — the reference is taken from the ARGUMENT LIST, not from
;; the first `desc:import-object` anywhere in the frame.
spec fulfill-ref SyrupValue -> [Option Nat]
defn fulfill-ref [args]
  let xs := [syrup-list-or-nil args]
    match [nth-syrup xs zero]
      | none   -> [none Nat]
      | some h ->
          match [syrup-symbol-name h]
            | none   -> [none Nat]
            | some n ->
                match [str::eq n "fulfill"]
                  | false -> [none Nat]
                  | true  -> ref-position [nth-syrup xs 1N]

;; The parked fields, read back out of the blob.
spec blob-field String Nat -> [Option SyrupValue]
defn blob-field [blob i]
  match [wire::decode-value blob]
    | none   -> [none SyrupValue]
    | some v -> nth-syrup [syrup-list-or-nil v] i

spec blob-string String Nat -> String
defn blob-string [blob i]
  match [blob-field blob i]
    | none   -> ""
    | some v -> unwrap-or "" [syrup-text-of v]

spec blob-nat String Nat -> Nat
defn blob-nat [blob i]
  match [nat-of-syrup [blob-field blob i]]
    | none   -> zero
    | some n -> n

;; Did the blob decode to the five fields we parked?
;;
;; `blob-nat` answers zero and `blob-string` answers "" for BOTH "field absent"
;; and "blob did not decode", and zero is not a harmless default here: it is the
;; peer's BOOTSTRAP position, so a blob we failed to read would send
;; `['fulfill ENV]` to the peer's bootstrap object rather than sending nothing.
;; Check once, up front, and emit nothing at all if the parked state is not
;; readable.
spec blob-ok? String -> Bool
defn blob-ok? [blob]
  match [blob-field blob 4N]
    | none   -> false
    | some _ ->
        match [str::eq [blob-string blob zero] ""]
          | true  -> false
          | false -> true

spec answer-for-blob String -> OutReq
defn answer-for-blob [blob]
  out-send [blob-string blob zero] [answer-enliven-bytes [blob-nat blob 1N] [sig-envelope-bytes [identity-keypair 0N] [blob-string blob 3N]]]

spec deposit-for-blob String Nat -> OutReq
defn deposit-for-blob [blob ref]
  out-send [blob-string blob 2N] [deposit-frame-bytes [blob-string blob 4N] ref]

;; Deposit the object at the exporter, and answer the enliven with the signed
;; give. Two sends, on two different connections — which is the whole reason
;; this role could not be expressed before the connection registry existed.
spec finish-handoff String Nat -> [List OutReq]
defn finish-handoff [blob ref]
  match [blob-ok? blob]
    | false -> [nil OutReq]
    | true  -> cons [deposit-for-blob blob ref] [cons [answer-for-blob blob] [nil OutReq]]

;; Remove the parked enliven, and act ONLY if we were the remover.
;;
;; `enliven-drop` answers #t for exactly one caller, so two threads racing one
;; slot produce one send rather than two.
spec finish-if-dropped Bool String Nat -> [List OutReq]
defn finish-if-dropped [dropped blob ref]
  match dropped
    | false -> [nil OutReq]
    | true  -> finish-handoff blob ref

;; VALIDATE, THEN CLAIM. The earlier shape claimed first and validated after,
;; so any deliver to a reserved slot that was not a well-formed
;; `['fulfill REF]` — a break, a `desc:answer` reference the descriptor gate
;; rejects, a second delivery — destroyed the pending handoff permanently and
;; silently. Peeking leaves it in place for the answer we can actually use.
spec claim-for-slot String String CapTPOp -> [List OutReq]
defn claim-for-slot [key blob op]
  match [str::eq blob ""]
    | true  -> [nil OutReq]
    | false ->
        match [deliver-args op]
          | none   -> [nil OutReq]
          | some a ->
              match [fulfill-ref a]
                | none     -> [nil OutReq]
                | some ref -> finish-if-dropped [enliven-drop key] blob ref

spec fetch-answer-for-export Nat CapTPOp -> [List OutReq]
defn fetch-answer-for-export [cid op]
  match [deliver-target op]
    | none   -> [nil OutReq]
    | some t -> claim-for-slot [enliven-key cid t] [enliven-peek [enliven-key cid t]] op

;; Both halves of the gifter role, for one inbound op.
;; The EXPORT table only. `deliver-target`'s own doc says it indexes the
;; question/answer table for `op-deliver-to-answer` and that `deliver-to-answer?`
;; is how you tell them apart — and the answer namespace is PEER-allocated and
;; starts at 0, so without this gate a peer reaches any slot it likes from a
;; namespace that has nothing to do with our exports.
spec fetch-answer-out-reqs Nat CapTPOp -> [List OutReq]
defn fetch-answer-out-reqs [cid op]
  match [deliver-to-answer? op]
    | true  -> [nil OutReq]
    | false -> fetch-answer-for-export cid op

spec gifter-out-reqs Nat ConnectionState CapTPOp -> [List OutReq]
defn gifter-out-reqs [cid cs op]
  append [enliven-out-reqs cid cs op] [fetch-answer-out-reqs cid op]

;; --- Draining what a turn asked the outside world for ---
;;
;; The vat records `OutReq`s and stays pure; these perform them.
;;
;; This used to be an INTERCEPTION: `run-step` inspected each inbound op,
;; recognised a deliver to the enlivener position, extracted the sturdyref
;; itself and queued the dial — all before `connection-step` ran, and the
;; enlivener position had no actor behind it at all. The whole arrangement
;; existed because a behaviour is pure and cannot open a socket.
;;
;; `eff-connect` removes the need for it. The enlivener is now an ordinary
;; actor (seeded above), it asks for the connection like any other effect,
;; and this drains what the vat recorded — the same shape as the outbound
;; message queue, one layer out.
;; A send needs a CONNECTION, and the behaviour named only a location. The
;; registry resolves it. A location we have no connection to yet answers 0 —
;; connection ids start at 1 — and the send is dropped rather than queued
;; against a connection that does not exist.
spec do-send-on String String -> Bool
defn do-send-on [loc bs]
  let cid := [peer-lookup loc]
    match [nat-eq? cid zero]
      | true  -> true
      | false -> send-on-conn cid bs

spec do-out-req OutReq -> Bool
defn do-out-req [r]
  match r
    | out-dial l    -> dial-request l
    | out-send l bs -> do-send-on l bs

spec drain-dials [List OutReq] -> Bool
defn drain-dials [rs]
  match rs
    | nil        -> true
    | cons r rest ->
        match [do-out-req r]
          | true  -> drain-dials rest
          | false -> drain-dials rest

spec clear-conn-dials ConnectionState -> ConnectionState
defn clear-conn-dials [cs]
  conn-state [clear-dials [conn-vat cs]] [conn-bridge-state cs] [conn-emitted cs] [conn-aborted? cs]

;; The dials have been taken, so the state that persists must not still carry
;; them — otherwise every later step re-dials everything this one asked for.
spec step-state-to-stash ConnStep -> ConnectionState
defn step-state-to-stash [step]
  publish-gifts [clear-conn-dials [conn-step-state step]]

;; Everything this step asks the outside world for: gives handed to us, the
;; gifter's two halves, and whatever the vat's behaviours queued. One list,
;; because they are all "things this turn wants done once the turn closes".
spec step-out-reqs Nat ConnectionState CapTPOp ConnStep -> [List OutReq]
defn step-out-reqs [cid cs op step]
  append [gives-in-op op] [append [gifter-out-reqs cid cs op] [vat-dials [conn-vat [conn-step-state step]]]]

;; Drain the dials, then emit. Reached only AFTER this step's own state has
;; been stashed — see `run-step`.
spec run-step-drain Nat CapTPOp ConnectionState ConnStep Bool -> String
defn run-step-drain [cid op cs step stashed]
  match [drain-dials [step-out-reqs cid cs op step]]
    | true  -> emit-after-stash stashed [append [conn-step-outbound step] [withdraw-frames cid op]]
    | false -> emit-after-stash stashed [append [conn-step-outbound step] [withdraw-frames cid op]]

spec run-step Nat CapTPOp ConnectionState -> String
;; EVERY op goes through `connection-step`. There is no longer an op the
;; driver handles instead of the bridge.
;;
;; There used to be: an enliven was intercepted here, the dial queued, and the
;; op never passed on — because a behaviour is pure and cannot open a socket,
;; so `sturdyref-enlivener-pos` had no actor at all. Two consequences, both
;; recorded in the gaps document: the two implementations acted on the same
;; frame with only one of them knowing (§1.7 M8), and the export position the
;; enlivener answers on was reserved by convention rather than construction
;; (§1.7 M7).
;;
;; `eff-connect` and `act-step-pending` between them remove the need. The
;; enlivener is an ordinary actor now: it asks for the connection as an
;; effect, and says it has NO ANSWER, so captp-core leaves the peer's promise
;; pending for the reply the driver will build. Seeding it without
;; `act-step-pending` does not work — the actor answers immediately with the
;; wrong thing and beats the real reply.
;;
;; `drain-dials` is FORCED by matching on its result rather than merely bound.
;; Reduction is lazy, so `let d := [drain-dials ...]` with `d` unused is
;; dropped outright and the side effect never happens — which presents as a
;; queue that stays empty with no error anywhere. Same idiom as
;; `publish-gifts` and `emit-after-stash` above, for the same reason.
;;
;; STASH BEFORE DRAINING, and the match below is what makes that an ORDER
;; rather than a wish — passing the stash as an argument would only bind it,
;; and lazy reduction would then run it whenever `emit-after-stash` got round
;; to matching on it, which is after the drain.
;;
;; Why the order matters: `reserve-export-id`, reached from `step-out-reqs`
;; via the gifter path, does its own conn-fetch → vat-spawn → conn-stash on
;; the EXPORTER's connection. When the exporter IS this connection — an
;; enliven naming a peer we already have a session with — draining first let
;; this step's stash land afterwards carrying a vat snapshot taken BEFORE the
;; reservation. The reservation vanished and `next-id` rolled back, so a later
;; `fresh-promise` could hand out the position the sink actor is sitting on: a
;; promise aliasing an actor, which is the exact collision `reserve-export-id`
;; exists to make structurally impossible.
;;
;; The two arms differ (they pass a different Bool), so unlike the pairs this
;; file warns about elsewhere, an arm-collapsing rewrite cannot fold them.
defn run-step [cid op cs]
  let step := [connection-step op [with-global-gifts cs]]
    match [conn-stash cid [step-state-to-stash step]]
      | true  -> run-step-drain cid op cs step true
      | false -> run-step-drain cid op cs step false

spec step-connection Nat String -> String
  :doc "Process one inbound wire frame (hex-encoded) for connection
        `cid`. Returns the concatenated outbound wire bytes to send."
;; `seeded-connection` is the fallback rather than a crash: `init-connection`
;; is always called first, so a miss means that call did not land, and
;; restarting the connection from the state it WOULD have stashed is the
;; least-wrong recovery. The FFI reports the miss on stderr.
;;
;; A frame we cannot decode gets an `op:abort`, not silence.
;;
;; This used to return "", which is one of several ways this server produces
;; no reply and which the peer cannot tell apart from "decoded fine, nothing
;; to say" — so a peer sending an op we do not understand waited out its own
;; timeout instead of learning anything. The spec entitles it to an abort.
;;
;; Every decode failure is fatal, deliberately. There is no partial-credit
;; reading of a CapTP frame: the decoder's gates are arity, descriptor label
;; and slot well-formedness, and a frame that fails any of them is one whose
;; meaning we do not know. Continuing the session on a frame we could not
;; read is how a desync becomes a wrong answer several frames later.
;;
;; This was blocked until recently for a concrete reason worth recording: the
;; SPEC's plural GC ops did not decode, so aborting here would have fired on
;; ordinary conforming traffic. They decode now.
defn step-connection [cid hex-frame]
  match [decode-op [hex-to-bytes hex-frame]]
    | none    -> [encode-op [op-abort "undecodable-frame"]]
    | some op -> [run-step cid op [conn-fetch cid seeded-connection]]
