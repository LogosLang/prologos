ns prologos::ocapn::bridge-interop-helpers

;; ========================================
;; Helpers for Phase 24 bridge-driven interop tests.
;; ========================================
;;
;; Pre-compiled wrappers around captp-incoming-with-state +
;; drain + pump-outbound, exposed as single-call functions so
;; test fixtures driving them via process-string don't pay the
;; elaboration cost of an inline 7-binding let-chain.
;;
;; Background: Phase 24's first cut hit goblin pitfalls #30
;; (match in deep let triggers inference failure) and #31
;; (decode-op + bridge chain through process-string takes
;; >90s). This module sidesteps both by exposing the chain as
;; named top-level functions that raco make compiles once and
;; the test fixture invokes via a single function call.

require [prologos::ocapn::core   :refer-all]
        [prologos::ocapn::message :refer-all]
        [prologos::ocapn::captp-wire :refer-all]
        [prologos::ocapn::captp-bridge :refer-all]
        [prologos::ocapn::promise :refer [PromiseState pst-unresolved pst-fulfilled pst-broken]]
        [prologos::data::list  :refer [List nil cons append]]
        [prologos::data::option :refer [Option some none]]
        [prologos::data::string :as str :refer []]

;; Eight-deep suc-tower; keeps `drive-echo-bridge-once` flat.
def drain-fuel-8 : Nat := [suc [suc [suc [suc [suc [suc [suc [suc zero]]]]]]]]

spec first-bytes [List String] -> Option String
defn first-bytes
  | nil       -> [none String]
  | cons hd _ -> [some String hd]

;; Drive the bridge end-to-end with a fresh echo-actor vat for one
;; inbound op. Returns Some <bytes> if the bridge produced an
;; outbound deliver; None otherwise.
spec drive-echo-bridge-once CapTPOp -> Option String
defn drive-echo-bridge-once [op]
  let sa   := [vat-spawn-actor beh-echo syrup-null empty-vat]
    let step := [captp-incoming-with-state op [alloc-vat sa] bridge-state-empty]
      let v2   := [drain drain-fuel-8 [bridge-step-vat step]]
        let pr   := [pump-outbound v2 [bridge-step-state step] nil]
          [first-bytes [pump-result-bytes pr]]

;; End-to-end: decode raw inbound bytes from a peer (e.g.,
;; `@endo/ocapn`-emitted Syrup) and drive the bridge through them.
;; Returns Some <reply-bytes> on success, None on either a decode
;; failure or a bridge that produced no outbound. This is the
;; entry point for live bridge-driven interop tests.
spec drive-echo-bridge-from-bytes String -> Option String
defn drive-echo-bridge-from-bytes [bytes]
  match [decode-op bytes]
    | none    -> [none String]
    | some op -> [drive-echo-bridge-once op]

;; ===========================================================
;; Phase 25: handshake-aware bridge driver
;; ===========================================================

;; Concatenate a list of byte-strings with newline framing between
;; them. Each frame ends with "\n" so the receiver's line-oriented
;; framing (read-line) extracts each cleanly.
spec framed-concat [List String] -> String
defn framed-concat
  | nil           -> ""
  | cons hd tl    -> [str::append hd [str::append "
" [framed-concat tl]]]

;; Drive the bridge with a handshake-configured initial state and
;; one inbound deliver op. The bridge's pump-outbound emits our
;; session bytes (queued in pending-out by `bridge-state-with-our-session`)
;; alongside the deliver reply. Returns the framed concatenation of
;; all outbound bytes: `[our-session, deliver-reply, ...]`.
;;
;; This is the entry point that exercises the in-bridge handshake
;; modelling: the test passes our (ver, loc) once at construction,
;; the bridge produces both reply frames from a single dispatch.
spec drive-handshake-with-deliver String String CapTPOp -> String
defn drive-handshake-with-deliver [our-ver our-loc op]
  let sa := [vat-spawn-actor beh-echo syrup-null empty-vat]
    let step := [captp-incoming-with-state op [alloc-vat sa] [bridge-state-with-our-session our-ver our-loc]]
      let v2 := [drain drain-fuel-8 [bridge-step-vat step]]
        let pr := [pump-outbound v2 [bridge-step-state step] [nil Nat]]
          [framed-concat [pump-result-bytes pr]]

;; End-to-end handshake-aware driver from raw bytes. Decodes the
;; deliver bytes, drives the bridge with our session pre-queued,
;; returns framed concatenation of all outbound. Returns empty
;; string if decode fails.
spec drive-handshake-and-deliver String String String -> String
defn drive-handshake-and-deliver [our-ver our-loc f2-bytes]
  match [decode-op f2-bytes]
    | none    -> ""
    | some op -> [drive-handshake-with-deliver our-ver our-loc op]

;; ===========================================================
;; Phase 40: pipelining cross-impl driver
;; ===========================================================
;;
;; Drive the bridge with TWO sequential inbound ops on the same
;; vat+state, then drain + pump. Used by the pipelining cross-impl
;; gate: peer sends a Q (op1) and pipelines a follow-up (op2) before
;; we reply; the bridge processes both, then emits its reply to the Q.
;;
;; The pipelined op2 queues `args` on the local promise allocated for
;; op1's answer-pos; that queue isn't directly observable in the
;; outbound bytes (vat-side resolution-and-forward isn't wired here),
;; so the cross-impl assertion is "Racket processed both ops without
;; protocol error AND emitted the expected reply for op1." That smoke-
;; tests Phase 38's dispatch-pipeline-on-our-q without needing a
;; full vat-side forwarding implementation.
spec drive-handshake-with-two-ops String String CapTPOp CapTPOp -> String
defn drive-handshake-with-two-ops [our-ver our-loc op1 op2]
  let sa := [vat-spawn-actor beh-echo syrup-null empty-vat]
    let step1 := [captp-incoming-with-state op1 [alloc-vat sa] [bridge-state-with-our-session our-ver our-loc]]
      let step2 := [captp-incoming-with-state op2 [bridge-step-vat step1] [bridge-step-state step1]]
        let v2 := [drain drain-fuel-8 [bridge-step-vat step2]]
          let pr := [pump-outbound v2 [bridge-step-state step2] [nil Nat]]
            [framed-concat [pump-result-bytes pr]]

;; End-to-end pipelining driver from raw bytes. Decodes both ops,
;; drives sequentially, returns framed concat of all outbound.
;; Empty string on decode failure.
spec drive-handshake-q-and-pipeline String String String String -> String
defn drive-handshake-q-and-pipeline [our-ver our-loc q-bytes pipe-bytes]
  match [decode-op q-bytes]
    | none -> ""
    | some op1 ->
        match [decode-op pipe-bytes]
          | none -> ""
          | some op2 -> drive-handshake-with-two-ops our-ver our-loc op1 op2

;; Phase 34f helpers — defined bottom-up (callees first).

;; Take a ConnectionState, pump's already-emitted bytes, plus a
;; release target. Apply release-import; return framed concat of
;; pump bytes + release bytes.
spec combine-pump-and-release ConnectionState Nat Nat [List String] -> String
defn combine-pump-and-release [cs release-id release-cnt pump-bytes]
  [framed-concat
    [append String pump-bytes
      [conn-release-bytes [release-import release-id release-cnt cs]]]]

;; Take the BridgeStep from a dispatched op, drain + pump, and then
;; layer the release-import bytes on top. 3-arg shape (BridgeStep,
;; Nat, Nat) keeps the cross-module call surface narrow.
spec post-step-with-release BridgeStep Nat Nat -> String
defn post-step-with-release [step release-id release-cnt]
  let v2 := [drain drain-fuel-8 [bridge-step-vat step]]
    let pr := [pump-outbound v2 [bridge-step-state step] [nil Nat]]
      [combine-pump-and-release [conn-state v2 [bridge-step-state step] [nil Nat] false]
                                 release-id release-cnt
                                 [pump-result-bytes pr]]

;; Inner: assumes op already decoded. Builds vat + handshake-pre-queued
;; state, dispatches inbound, then delegates to post-step-with-release.
spec drive-with-release String String CapTPOp Nat Nat -> String
defn drive-with-release [our-ver our-loc op release-id release-cnt]
  let sa := [vat-spawn-actor beh-echo syrup-null empty-vat]
    let step := [captp-incoming-with-state op [alloc-vat sa] [bridge-state-with-our-session our-ver our-loc]]
      [post-step-with-release step release-id release-cnt]

;; Phase 34f: drive handshake + deliver, then release the named
;; imported refr. Returns concat of: our-session + reply-to-Q +
;; op:gc-export N k. Demonstrates the full GC loop end-to-end:
;;
;;   1. Peer sends op:deliver with desc:export N in args.
;;   2. Bridge auto-increments imports-refcount[N] (Phase 34b).
;;   3. Bridge replies via echo (Phase 24).
;;   4. We release the import — bytes for op:gc-export N k emitted.
;;
;; The state thread is internal to this helper; the test fixture
;; sees only the final framed bytes.
spec drive-handshake-deliver-and-release String String String Nat Nat -> String
defn drive-handshake-deliver-and-release [our-ver our-loc f2-bytes release-id release-cnt]
  match [decode-op f2-bytes]
    | none    -> ""
    | some op -> [drive-with-release our-ver our-loc op release-id release-cnt]

;; ===========================================================
;; Phase 25.4: questioner-side interop helpers
;; ===========================================================

;; Look up a promise by id in the vat carried by a BridgeStep.
;; 2-arg shape — sidesteps issue #60 (cross-module inference failure
;; on multi-arg helpers calling captp-incoming-with-state with
;; bound vars).
spec lookup-after-step BridgeStep Nat -> [Option PromiseState]
defn lookup-after-step [step pid]
  lookup-promise pid [bridge-step-vat step]

;; Dispatch an inbound op for an outbound-question reply, then
;; look up the local promise. Caller supplies pre-built (vat, state, pid).
;; 2-arg form via curry-passing through lookup-after-step.
spec drive-after-step1-and-lookup BridgeStep Nat -> [Option PromiseState]
defn drive-after-step1-and-lookup [step pid]
  lookup-after-step step pid

;; Phase 25.4 entry point. Given a peer's reply bytes (which should
;; be `op:deliver <desc:answer q-pos> args false false`), set up a
;; fresh promise tied to `q-pos` in the bridge's outbound-questions
;; table, decode the reply, dispatch through the bridge, and return
;; the local promise's state.
;;
;; Expected reply bytes shape (from peer-responder.mjs):
;;   <op:deliver <desc:answer q-pos> reply-args false false>
;;
;; Returns:
;;   some <pst-fulfilled v>  — bridge correctly resolved
;;   some <pst-unresolved _> — bridge dispatched but didn't resolve
;;   none                    — decode failed
;;
;; Returning Option PromiseState rather than discriminating in-bridge
;; sidesteps issue #60 (multi-constructor inference failure
;; cross-module). The test fixture pretty-prints the result and
;; greps for "pst-fulfilled" + the answer payload.
spec verify-questioner-reply Nat String -> [Option PromiseState]
defn verify-questioner-reply [q-pos reply-bytes]
  let alloc := [fresh-promise empty-vat]
    let pid := [alloc-id alloc]
      let v0 := [alloc-vat alloc]
        let st0 := [bs-add-outbound-question q-pos pid bridge-state-empty]
          match [decode-op reply-bytes]
            | none    -> [none PromiseState]
            | some op ->
                drive-after-step1-and-lookup
                  [captp-incoming-with-state op v0 st0]
                  pid

