ns prologos::ocapn::locator

;; ========================================
;; OCapN Locator
;; ========================================
;;
;; A Locator names a peer machine + an object on it. It's the address
;; you dial when you want to talk to someone over an OCapN netlayer.
;;
;; This is a Phase-0 model of the OCapN locator described in
;; draft-specifications/Locators.md. We only carry the fields needed
;; for the tcp-testing-only netlayer:
;;
;;   { type: 'ocapn-peer'
;;     transport: <transport-name>      ;; e.g. "tcp-testing-only"
;;     designator: <peer-id>            ;; opaque peer identifier
;;     hints: { host, port }            ;; for tcp: where to dial
;;   }
;;
;; Hints are a MAP — a flat alternating key/value list, the same shape
;; `syrup-dict` uses on the wire — not two fixed scalar fields.
;;
;; They used to be exactly two: `host` and `port`. A netlayer whose
;; hints are anything else then had no representation at all, and
;; upstream ships one — `netlayers/onion.py` carries different keys
;; entirely. `loc-host` and `loc-port` survive as LOOKUPS into the map,
;; so the one consumer (`tcp-testing.prologos`) and the tests are
;; unaffected while an onion locator becomes expressible.
;;
;; `loc-port` returns a `Nat`, so it parses its hint. `prologos::data::string`
;; exposes no string→Nat, and the parse is here rather than there because a
;; hint that is absent or not a number must answer zero rather than raise —
;; a locator with no port is a loopback locator, not an error.
;;
;; The Endo `tcp-test-only.js` netlayer encodes this as a JS object;
;; we encode it as a small data type. Real OCapN production locators
;; carry a public-key designator, location signature, and crypto
;; certificates — explicitly out of scope here (see goblin-pitfalls
;; #18: "we model `tcp-testing-only` exactly because it's the
;; transport without auth/crypto").

require [prologos::data::list   :refer [List nil cons]]
        [prologos::data::option :refer [Option none some unwrap-or]]
        [prologos::data::string :as str :refer []]
        [prologos::data::char   :as char :refer []]

;; ========================================
;; Transport tag
;; ========================================
;;
;; Closed enum of supported transports. New transports extend this.

data Transport
  ;; In-process loopback — no actual sockets; used for unit testing.
  ;; This is the "simulated" netlayer; see netlayer.prologos.
  tr-loopback
  ;; tcp-testing-only — TCP without crypto/auth. NEVER use in
  ;; production; the name is per OCapN convention.
  tr-tcp-testing-only

spec transport-name Transport -> String
defn transport-name
  | tr-loopback         -> "loopback"
  | tr-tcp-testing-only -> "tcp-testing-only"

;; ========================================
;; Locator
;; ========================================
;;
;; designator is a string opaque to the netlayer (the peer's chosen
;; name); host and port are populated for tcp transports, ignored for
;; loopback.

data Locator
  ;; locator transport designator hints
  ;; hints is flat and alternating: ["host" "127.0.0.1" "port" "22045"]
  locator : Transport -> String -> [List String]

;; Selectors

spec loc-transport Locator -> Transport
defn loc-transport
  | locator t _ _ -> t

spec loc-designator Locator -> String
defn loc-designator
  | locator _ d _ -> d

spec loc-hints Locator -> [List String]
defn loc-hints
  | locator _ _ hs -> hs

spec hint-lookup [List String] String -> [Option String]
defn hint-lookup [hs k]
  match hs
    | nil -> [none String]
    | cons key rest ->
        match rest
          | nil -> [none String]
          | cons val more ->
              match [str::eq key k]
                | true  -> some val
                | false -> hint-lookup more k

spec loc-hint Locator String -> [Option String]
  :doc "The value of one hint, if the locator carries it."
defn loc-hint [loc k]
  hint-lookup [loc-hints loc] k

spec loc-host Locator -> String
defn loc-host [loc]
  unwrap-or "" [loc-hint loc "host"]

;; --- Parsing the port hint ---
;;
;; Total: anything that is not a non-empty run of digits answers zero.

spec digit-of Char -> [Option Int]
defn digit-of [c]
  let v := [int- [char::code c] 48]
    match [int-lt v 0]
      | true  -> [none Int]
      | false ->
          match [int-lt 9 v]
            | true  -> [none Int]
            | false -> some v

spec digits-to-int String Int Int Int -> [Option Int]
defn digits-to-int [s len acc i]
  match [int-eq i len]
    | true  -> some acc
    | false ->
        match [digit-of [str::ref s i]]
          | none   -> [none Int]
          | some d -> digits-to-int s len [int+ [int* acc 10] d] [int+ i 1]

spec string-to-int String -> [Option Int]
defn string-to-int [s]
  match [int-eq [str::length s] 0]
    | true  -> [none Int]
    | false -> digits-to-int s [str::length s] 0 0

spec port-of-hint [Option String] -> Nat
defn port-of-hint [h]
  match h
    | none   -> zero
    | some v ->
        match [string-to-int v]
          | none   -> zero
          | some i -> int-max-to-nat 0 i

foreign racket "racket/base" [max :as int-max-to-nat : Int -> Int -> Nat]

spec loc-port Locator -> Nat
defn loc-port [loc]
  port-of-hint [loc-hint loc "port"]

;; ========================================
;; Convenience constructors
;; ========================================

spec mk-loopback-locator String -> Locator
  :doc "Locator for an in-process loopback peer (testing only)."
defn mk-loopback-locator [designator]
  locator tr-loopback designator [nil String]

spec nat-digits-str Nat -> String
defn nat-digits-str [n]
  str::from-int [from-nat n]

spec mk-tcp-locator String String Nat -> Locator
  :doc "Locator for a tcp-testing-only peer at host:port."
defn mk-tcp-locator [designator host port]
  locator tr-tcp-testing-only designator
    [cons "host" [cons host [cons "port" [cons [nat-digits-str port] [nil String]]]]]

spec mk-locator-with-hints Transport String [List String] -> Locator
  :doc "Locator for a transport whose hints are not host/port -- e.g. onion."
defn mk-locator-with-hints [t designator hints]
  locator t designator hints

;; ========================================
;; Equality (structural)
;; ========================================
;;
;; Two locators are equal if every field matches. We only need this
;; to deduplicate in the connection-cache; not lifted as a typeclass
;; for Phase 0.

require [prologos::data::nat :refer [nat-eq?]]

spec transport-eq? Transport Transport -> Bool
defn transport-eq? [a b]
  match a
    | tr-loopback ->
        match b
          | tr-loopback         -> true
          | tr-tcp-testing-only -> false
    | tr-tcp-testing-only ->
        match b
          | tr-loopback         -> false
          | tr-tcp-testing-only -> true

;; Hints compare AS A SEQUENCE, order included. Two locators whose hints
;; differ only in order name the same peer, so this is stricter than the
;; semantics deserve — but the alternative is a set comparison over a flat
;; alternating list, and the one caller (connection-cache dedup) builds its
;; locators from `mk-tcp-locator`, which emits a fixed order.
spec hints-eq? [List String] [List String] -> Bool
defn hints-eq? [xs ys]
  match xs
    | nil ->
        match ys
          | nil      -> true
          | cons _ _ -> false
    | cons a arest ->
        match ys
          | nil -> false
          | cons b brest ->
              match [str::eq a b]
                | false -> false
                | true  -> hints-eq? arest brest

spec locator-eq? Locator Locator -> Bool
defn locator-eq?
  | [locator ta da ha] [locator tb db hb] ->
      match [transport-eq? ta tb]
        | false -> false
        | true  ->
            match [str::eq da db]
              | false -> false
              | true  -> hints-eq? ha hb
