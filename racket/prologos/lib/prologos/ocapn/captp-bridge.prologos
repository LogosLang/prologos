ns prologos::ocapn::captp-bridge

;; ===========================================================
;; CapTP ↔ Vat bridge — Phase 11 of OCapN interop
;; ===========================================================
;;
;; When a CapTP message arrives over the wire (decoded into a
;; `CapTPOp` value), this module maps it onto operations on the
;; local `Vat`. The dual direction (vat-side eff-resolve emerging
;; as outbound op:deliver) is Phase 12.
;;
;; Mapping (Phase 11 minimum):
;;   op:deliver   tgt args ap rm  →  enqueue VatMsg(deliver tgt args ap)
;;   op:deliver-only tgt args     →  send-only tgt args
;;   op:abort     reason          →  no-op (connection layer handles abort)
;;   op:start-session  ver loc    →  no-op (session layer)
;;   op:listen    tgt resolver    →  no-op for Phase 11 (tracked as TODO)
;;   op:gc-*                      →  no-op for Phase 11 (no GC yet)
;;
;; Caller obligations:
;;   - For op:deliver with answer-pos=Some N, the caller must
;;     have already allocated a promise at position N via
;;     `fresh-promise` (or otherwise ensure promise N exists).
;;     Phase 12 will handle allocation automatically when bridging
;;     a session.

require [prologos::ocapn::message :refer-all]
        [prologos::ocapn::vat     :refer-all]
        [prologos::ocapn::syrup   :refer-all]
        [prologos::data::option   :refer [Option some none]]
        [prologos::data::nat      :refer [nat-eq?]]

spec incoming-captp-op CapTPOp Vat -> Vat
  :doc "Apply an inbound CapTPOp to the vat. Phase 11. (Stateless wrt BridgeState; Phase 25 questioner-side answers are handled by captp-incoming-with-state.)"
defn incoming-captp-op
  | [op-deliver tgt args ap _rm] v ->
      enqueue-msg [vmsg-deliver tgt args ap] v
  | [op-deliver-only tgt args] v ->
      send-only tgt args v
  | [op-abort _reason] v ->
      v
  | [op-start-session _ver _loc] v ->
      v
  | [op-listen _tgt _resolver] v ->
      v
  | [op-gc-export _pos _cnt] v ->
      v
  | [op-gc-answer _pos] v ->
      v
  | [op-deliver-to-answer _qpos _args _ap _rm] v ->
      ;; Resolving an outbound question requires BridgeState (the
      ;; outbound-questions table). The stateless variant can't do it;
      ;; no-op here, the state-aware dispatcher handles it. Phase 25.
      v

;; ===========================================================
;; Wire-OUT bridge — Phase 12
;; ===========================================================
;;
;; Convert a (locally-resolved) promise into the SyrupValue
;; representation of the outbound CapTP message that delivers
;; the answer to the remote peer:
;;
;;   pid resolved to v       →  <op:deliver <desc:answer pid> v false false>
;;   pid broken with reason  →  <op:abort reason>          ;; no per-promise abort form;
;;                                                          ;; promise-level breaks need
;;                                                          ;; <op:deliver desc:answer
;;                                                          ;; <Error reason>>; deferred
;;                                                          ;; until Error type lands
;;
;; The result is a `SyrupValue` ready for `wire::encode` to bytes.
;; Caller is responsible for tracking which promises have already
;; been emitted (the bridge is stateless).

require [prologos::ocapn::promise :refer-all]
        [prologos::ocapn::pipelining :refer [pipeline-deliver]]
        [prologos::ocapn::syrup-wire :as wire :refer []]
        [prologos::ocapn::captp-wire :refer [wire-nat]]
        [prologos::data::list :refer [append cons nil]]

;; Build the bytes for an outbound op:deliver targeting an
;; answer-pos:
;;   <op:deliver <desc:answer pid> args false false>
;; This is the canonical OCapN shape for "the result of
;; question pid is args" — sent by the answering peer after a
;; deliver completes locally.
spec outbound-deliver-bytes Nat SyrupValue -> String
defn outbound-deliver-bytes [pid args]
  wire::encode-record "op:deliver"
    [cons [syrup-tagged "desc:answer" [syrup-nat pid]]
      [cons args
        [cons [syrup-bool false]
          [cons [syrup-bool false] nil]]]]

;; Build the bytes for our outbound op:start-session, given our
;; protocol version and locator string. CapTP requires both peers
;; to send their op:start-session; this is the canonical encoding
;; the bridge emits in response to a peer's inbound session.
;;   <op:start-session ver loc>
spec our-session-bytes String String -> String
defn our-session-bytes [ver loc]
  wire::encode-record "op:start-session"
    [cons [syrup-string ver]
      [cons [syrup-string loc] nil]]

;; Phase 25: build the bytes for an OUTBOUND question — Prologos
;; asking peer to deliver to one of peer's exports.
;;   <op:deliver <desc:export tgt-export> args <desc:answer our-q-pos> false>
;; `tgt-export` is the peer's export-id we're targeting.
;; `args` is the question payload (a SyrupValue, often a record).
;; `our-q-pos` is OUR question position; peer will reply with
;; <op:deliver <desc:answer our-q-pos> answer false false>.
;; Caller is responsible for tracking `our-q-pos -> local-promise`
;; via `bs-add-outbound-question` so the inbound dispatch can resolve.
spec outbound-question-bytes Nat SyrupValue Nat -> String
defn outbound-question-bytes [tgt-export args our-q-pos]
  wire::encode-record "op:deliver"
    [cons [syrup-tagged "desc:export" [syrup-nat tgt-export]]
      [cons args
        [cons [syrup-tagged "desc:answer" [syrup-nat our-q-pos]]
          [cons [syrup-bool false] nil]]]]

;; Wrap a SyrupValue in the canonical "broken-promise reason"
;; record `<Error r>`. Phase 17.
spec wrap-error SyrupValue -> SyrupValue
defn wrap-error [reason]
  syrup-tagged "Error" reason

;; Phase 48: build the bytes for a listener-notification op:deliver:
;;   <op:deliver <desc:export resolver-pos> args false false>
;; Sent to peer when our local promise resolves and peer had
;; previously registered an op:listen for it. resolver-pos is the
;; export-table position peer designated as the resolver capability.
;; Both answer-pos and resolve-me are false: the notification doesn't
;; expect its own answer.
spec listener-notify-bytes Nat SyrupValue -> String
defn listener-notify-bytes [resolver-pos args]
  wire::encode-record "op:deliver"
    [cons [syrup-tagged "desc:export" [syrup-nat resolver-pos]]
      [cons args
        [cons [syrup-bool false]
          [cons [syrup-bool false] nil]]]]

;; If a promise has settled (fulfilled OR broken), return the
;; bytes of the corresponding outbound op:deliver:
;;   pst-fulfilled v  →  <op:deliver <desc:answer pid> v false false>
;;   pst-broken    r  →  <op:deliver <desc:answer pid> <Error r> false false>
;; Unresolved promises return `none`.
spec outbound-from-resolution Nat PromiseState -> [Option String]
defn outbound-from-resolution
  | _   [pst-unresolved _] -> none
  | pid [pst-broken     r] -> some [outbound-deliver-bytes pid [wrap-error r]]
  | pid [pst-fulfilled  v] -> some [outbound-deliver-bytes pid v]

;; Phase 48: extract the syrup-shaped resolution payload from a
;; PromiseState, ready for shipment to a listener.
;;   pst-fulfilled v  →  some v
;;   pst-broken    r  →  some <Error r>
;;   pst-unresolved _ →  none (listeners aren't notified until settled)
spec resolution-syrup-of-pst PromiseState -> [Option SyrupValue]
defn resolution-syrup-of-pst [pst]
  match pst
    | pst-unresolved _ -> none
    | pst-broken     r -> some [wrap-error r]
    | pst-fulfilled  v -> some v

;; ===========================================================
;; Bridge state — Phase 14
;; ===========================================================
;;
;; The vat alone doesn't capture session-level concerns:
;;
;;   - op:listen registers a remote listener for a local promise.
;;     When the promise resolves, we should send an op:deliver
;;     to the remote resolver.
;;   - op:gc-export tells us a peer dropped references to one of
;;     our exports — we'd decrement a refcount.
;;   - op:gc-answer tells us a peer is done with one of our
;;     answer-table entries.
;;
;; Phase 14 introduces `BridgeState`, which carries the parts of
;; session state that don't fit in the Vat. The state-aware
;; dispatcher `captp-incoming-with-state` updates Vat AND
;; BridgeState as appropriate per op. Phase 15+ will wire
;; listeners to outbound resolution.

data Listener
  listener : Nat -> Nat
  ;; (target-promise-id, resolver-position-on-peer)

data GcExportReq
  gc-export-req : Nat -> Nat
  ;; (export-pos, count)

data QEntry
  q-entry : Nat -> Nat
  ;; (remote-question-pos, local-promise-id)
  ;;
  ;; The peer's op:deliver carries an answer-pos N — a position in
  ;; the peer's question table. We allocate a local promise and
  ;; record (N → local-id) so subsequent ops referring to the same
  ;; answer-pos route to the same local promise.

;; ===========================================================
;; PipeMsg — Phase 41: wire-side pipeline message queue entry
;; ===========================================================
;;
;; When peer pipelines `<op:deliver <desc:answer N> args ap rm>` and N
;; is in our inbound bs-questions table, the bridge records
;; (pid, args, ap) here — ap is peer's answer-pos for the pipelined Q
;; (Phase 45). The vat-side queue (PromiseState's pst-unresolved msgs)
;; is for in-process pipelining and gets WIPED on fulfill; this bridge-
;; level queue survives resolution so the pump can emit forwarding
;; bytes when the local promise resolves, AND can break-forward the
;; queued delivers' answers when the local promise breaks.
;; Single-constructor avoids issue #60.
data PipeMsg
  pipe-msg : Nat -> SyrupValue -> [Option Nat]
  ;; (local-promise-id, args, queued-deliver-answer-pos)

;; ===========================================================
;; Refr — runtime CapTP capability value (Phase 34a)
;; ===========================================================
;;
;; A Refr is a runtime reference to a capability: either one of OUR
;; exports/answer-table-entries (local kind) or one of PEER's
;; (remote kind, "imported" from peer's wire).
;;
;; Single-constructor with a numeric `kind` tag avoids issue #60
;; (multi-constructor cross-module inference failure). The four
;; smart constructors are the public API; user code never matches
;; on `refr` directly.
;;
;; Brand-check semantics (OCapN): two refrs are the same brand iff
;; same (kind, id). Within ONE connection (one BridgeState), this
;; is sufficient — connection identity is implicit. Cross-connection
;; comparison would need a connection-id field; deferred until
;; multi-connection scenarios.
;;
;; Reference-equality (Racket eq?) is NOT guaranteed across calls
;; — two `[refr-remote-export 5]` constructions produce equal? but
;; not necessarily eq? values. True hash-consed eq? would require
;; a per-BridgeState intern table; deferred until a use case
;; demands it. For OCapN brand-check (the spec's notion), structural
;; equality is the operational equivalent.
data Refr
  refr : Nat -> Nat            ;; (kind-tag, id) — return type Refr is implicit

;; Kind tags. Encoded as Nat for issue #60 avoidance (no enum sum).
def refr-kind-local-export         : Nat := zero
def refr-kind-remote-export        : Nat := [suc zero]
def refr-kind-local-answer         : Nat := [suc [suc zero]]
def refr-kind-remote-answer        : Nat := [suc [suc [suc zero]]]
;; Phase 37: a 5th kind for the OCapN three-vat handoff form.
;; `<desc:import-object N>` introduces a capability via the connecting
;; peer; the receiver treats it as a refr but resolution to the actual
;; provider requires netlayer machinery deferred beyond Phase 0.
def refr-kind-remote-import-object : Nat := [suc [suc [suc [suc zero]]]]

;; Smart constructors. Use these — never construct `refr` directly.

spec refr-local-export Nat -> Refr
defn refr-local-export [n]
  refr refr-kind-local-export n

spec refr-remote-export Nat -> Refr
defn refr-remote-export [n]
  refr refr-kind-remote-export n

spec refr-local-answer Nat -> Refr
defn refr-local-answer [n]
  refr refr-kind-local-answer n

spec refr-remote-answer Nat -> Refr
defn refr-remote-answer [n]
  refr refr-kind-remote-answer n

spec refr-remote-import-object Nat -> Refr
defn refr-remote-import-object [n]
  refr refr-kind-remote-import-object n

;; Accessors.

spec refr-kind Refr -> Nat
defn refr-kind
  | refr k _ -> k

spec refr-id Refr -> Nat
defn refr-id
  | refr _ n -> n

;; Predicates.

spec refr-local-export? Refr -> Bool
defn refr-local-export?
  | refr k _ -> nat-eq? k refr-kind-local-export

spec refr-remote-export? Refr -> Bool
defn refr-remote-export?
  | refr k _ -> nat-eq? k refr-kind-remote-export

spec refr-local-answer? Refr -> Bool
defn refr-local-answer?
  | refr k _ -> nat-eq? k refr-kind-local-answer

spec refr-remote-answer? Refr -> Bool
defn refr-remote-answer?
  | refr k _ -> nat-eq? k refr-kind-remote-answer

spec refr-remote-import-object? Refr -> Bool
defn refr-remote-import-object?
  | refr k _ -> nat-eq? k refr-kind-remote-import-object

;; Brand-check: two refrs are the same brand iff same (kind, id).
;; Implements OCapN brand-check semantics within a single connection.
spec refr-eq? Refr Refr -> Bool
defn refr-eq?
  | [refr k1 n1] [refr k2 n2] ->
      match [nat-eq? k1 k2]
        | true  -> nat-eq? n1 n2
        | false -> false

;; Phase 34d: Refr → SyrupValue encoding (for outbound args).
;;
;; Converts a Refr to the canonical wire-shape `syrup-tagged
;; "desc:*" (syrup-nat N)`. The receiver's extract-refrs-from-args
;; (Phase 34b) inverts this back to a Refr.
;;
;; Perspective flip: a refr-local-export N encodes as
;; `<desc:export N>` on the wire — when peer decodes it, they see
;; refr-remote-export N (their import of our export). Same for
;; refr-local-answer ↔ refr-remote-answer.
;;
;; Remote refrs in outbound args (peer-bounce / three-vat) are
;; encoded as desc:export / desc:answer too — the receiver can
;; figure out semantics from the desc-tag and our connection
;; identity. Full three-vat handoff would use desc:import-object;
;; deferred to a future phase.
;; Is the refr's kind one of the export-shaped kinds (local-export or
;; remote-export, vs. answer-shaped)? Used to choose the desc:* tag
;; for outbound encoding. Avoids 3-deep nested match in refr-to-syrup
;; (pitfall #18).
spec refr-export-kind? Refr -> Bool
defn refr-export-kind? [r]
  match [refr-local-export? r]
    | true  -> true
    | false -> refr-remote-export? r

;; Pick the desc:* tag name for a given Refr's wire encoding. Phase 37
;; extends Phase 34d to a third tag. Two-deep match (NOT three-deep)
;; sidesteps pitfall #18 / #33.
spec refr-syrup-tag Refr -> String
defn refr-syrup-tag [r]
  match [refr-export-kind? r]
    | true  -> "desc:export"
    | false ->
        match [refr-remote-import-object? r]
          | true  -> "desc:import-object"
          | false -> "desc:answer"

spec refr-to-syrup Refr -> SyrupValue
defn refr-to-syrup [r]
  syrup-tagged [refr-syrup-tag r] [syrup-nat [refr-id r]]

data BridgeState
  bridge-state : [List Listener] -> [List GcExportReq] -> [List Nat] -> [List QEntry] -> [List String] -> [List QEntry] -> [List QEntry] -> [List QEntry] -> [List PipeMsg]
  ;; (listeners, gc-export-requests, gc-answer-positions, inbound-questions,
  ;;  pending-out, outbound-questions, imports-refcount, exports-refcount,
  ;;  pipelined-msgs)
  ;;
  ;; 9th field `pipelined-msgs` (Phase 41): wire-side pipeline queue.
  ;; Phase 38 records peer's pipelined args here (in addition to the
  ;; vat-side promise queue). Pump-outbound walks this list on each
  ;; turn; for every entry whose pid has resolved to a peer-export-
  ;; shaped refr (`<desc:export K>`), emits a forwarding op:deliver
  ;; targeting that refr and removes the entry. Survives fulfill
  ;; (whereas the vat-side queue gets wiped); this is the bridge's
  ;; canonical wire-side pipeline storage.
  ;;
  ;; 8th field `exports-refcount` (responder-side, Phase 36):
  ;; references peer holds to OUR exports. Entry tracks
  ;; (our-export-id → peer's-refcount). Symmetric to imports-refcount;
  ;; decremented when peer sends op:gc-export. The increment side is
  ;; manual: the caller invokes `bs-incr-export N` whenever it shares
  ;; a refr-local-export N with peer (e.g., before encoding it in
  ;; outbound args). Initial inbound op:deliver targeting an export
  ;; doesn't auto-increment in our model — peer asks export 0 cold
  ;; without prior introduction; the convention is "peer assumes
  ;; export 0 exists." Future protocol enhancements (handshake-time
  ;; export announcement) could change this.
  ;;
  ;; 4th field `inbound-questions` (responder-side): peer's op:deliver
  ;; with answer-pos N → we allocate a local promise; entry tracks
  ;; (peer-question-pos N → local-promise-id).
  ;;
  ;; 5th field `pending-out`: byte-strings the bridge wants to emit
  ;; on next pump call but don't fit the question-table walk pattern
  ;; (e.g. our op:start-session handshake reply).
  ;;
  ;; 6th field `outbound-questions` (questioner-side, Phase 25):
  ;; questions WE asked. Wire form is `op:deliver <desc:export tgt>
  ;; args <desc:answer our-q-pos> false`. Entry tracks
  ;; (our-q-pos → local-promise-id-awaiting-answer). When peer replies
  ;; with `op:deliver <desc:answer our-q-pos> args ...` (decoded as
  ;; op-deliver-to-answer), the bridge looks up our-q-pos here and
  ;; resolves the corresponding local promise.
  ;;
  ;; 7th field `imports-refcount` (questioner-side, Phase 34c):
  ;; references we hold to peer's exports. Entry tracks
  ;; (remote-export-id → our-refcount). Incremented when we decode
  ;; a refr-remote-export from peer's args; decremented (and message
  ;; emitted) when user calls release-import.
  ;;
  ;; Reusing QEntry for the (Nat → Nat) lists; entry semantics
  ;; depends on which list it's in.

def bridge-state-empty : BridgeState := [bridge-state nil nil nil nil nil nil nil nil nil]

;; Construct a BridgeState pre-loaded with our op:start-session bytes
;; queued for flush on the next pump-outbound. CapTP handshake
;; protocol: when peer connects + sends their op:start-session, we
;; reciprocate by sending ours. Pre-queueing in BridgeState lets the
;; pump emit them alongside any vat-resolution outbound.
spec bridge-state-with-our-session String String -> BridgeState
defn bridge-state-with-our-session [ver loc]
  bridge-state nil nil nil nil [cons [our-session-bytes ver loc] nil] nil nil nil nil

spec bs-listeners BridgeState -> List Listener
defn bs-listeners
  | bridge-state ls _ _ _ _ _ _ _ _ -> ls

spec bs-gc-exports BridgeState -> List GcExportReq
defn bs-gc-exports
  | bridge-state _ es _ _ _ _ _ _ _ -> es

spec bs-gc-answers BridgeState -> List Nat
defn bs-gc-answers
  | bridge-state _ _ as _ _ _ _ _ _ -> as

spec bs-questions BridgeState -> List QEntry
defn bs-questions
  | bridge-state _ _ _ qs _ _ _ _ _ -> qs

spec bs-pending-out BridgeState -> List String
defn bs-pending-out
  | bridge-state _ _ _ _ p _ _ _ _ -> p

spec bs-outbound-questions BridgeState -> List QEntry
defn bs-outbound-questions
  | bridge-state _ _ _ _ _ oqs _ _ _ -> oqs

spec bs-imports-refcount BridgeState -> List QEntry
defn bs-imports-refcount
  | bridge-state _ _ _ _ _ _ ir _ _ -> ir

spec bs-exports-refcount BridgeState -> List QEntry
defn bs-exports-refcount
  | bridge-state _ _ _ _ _ _ _ er _ -> er

spec bs-pipelined-msgs BridgeState -> List PipeMsg
defn bs-pipelined-msgs
  | bridge-state _ _ _ _ _ _ _ _ pm -> pm

;; Pure updates.

spec bs-add-listener Nat Nat BridgeState -> BridgeState
defn bs-add-listener
  | tgt res [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state [cons [listener tgt res] ls] es as qs p oqs ir er pm

spec bs-add-gc-export Nat Nat BridgeState -> BridgeState
defn bs-add-gc-export
  | pos cnt [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls [cons [gc-export-req pos cnt] es] as qs p oqs ir er pm

spec bs-add-gc-answer Nat BridgeState -> BridgeState
defn bs-add-gc-answer
  | pos [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es [cons pos as] qs p oqs ir er pm

spec bs-add-question Nat Nat BridgeState -> BridgeState
defn bs-add-question
  | remote local [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as [cons [q-entry remote local] qs] p oqs ir er pm

spec bs-clear-pending-out BridgeState -> BridgeState
defn bs-clear-pending-out
  | bridge-state ls es as qs _ oqs ir er pm ->
      bridge-state ls es as qs nil oqs ir er pm

;; Phase 50: append a single byte-string to pending-out. Used by
;; declarative-release helpers that stage `op:gc-export` bytes for
;; flushing on the next pump-outbound, alongside any newly-resolved
;; question replies.
spec bs-append-pending-out String BridgeState -> BridgeState
defn bs-append-pending-out
  | bytes [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs [cons bytes p] oqs ir er pm

;; Phase 25: track an outbound question we asked. `our-q-pos` is the
;; position we used in the desc:answer of our outbound op:deliver;
;; `local-promise-id` is the vat-side promise that will be resolved
;; when peer replies. See `bridge-send-question` (Phase 25.3) for
;; the helper that allocates and registers in one step.
spec bs-add-outbound-question Nat Nat BridgeState -> BridgeState
defn bs-add-outbound-question
  | qpos local [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p [cons [q-entry qpos local] oqs] ir er pm

;; Look up the local-id for a given remote-question-pos.
;; First (most-recent) match wins per cons-at-head insertion.

spec bs-lookup-question-loop [List QEntry] Nat -> [Option Nat]
defn bs-lookup-question-loop
  | nil _ -> none
  | [cons [q-entry r l] rest] target ->
      match [nat-eq? r target]
        | true  -> some l
        | false -> bs-lookup-question-loop rest target

spec bs-lookup-question Nat BridgeState -> [Option Nat]
defn bs-lookup-question [remote st]
  bs-lookup-question-loop [bs-questions st] remote

;; Phase 25: look up the local promise awaiting an answer for a
;; given outbound question-pos. Reuses bs-lookup-question-loop on
;; the outbound-questions list.
spec bs-lookup-outbound-question Nat BridgeState -> [Option Nat]
defn bs-lookup-outbound-question [qpos st]
  bs-lookup-question-loop [bs-outbound-questions st] qpos

;; Phase 31: remove an entry from a List QEntry, matched by the
;; first field (key). Used by both bs-remove-question (inbound) and
;; bs-remove-outbound-question (outbound). Returns the list with the
;; first matching entry filtered out; if no match, returns the list
;; unchanged. Removes only ONE matching entry — duplicate keys
;; (which shouldn't occur in our usage but might from peer bugs)
;; have only the most-recently-added removed.
spec list-remove-q-by-key [List QEntry] Nat -> [List QEntry]
defn list-remove-q-by-key
  | nil _ -> [nil QEntry]
  | [cons [q-entry k v] rest] target ->
      match [nat-eq? k target]
        | true  -> rest
        | false -> [cons [q-entry k v] [list-remove-q-by-key rest target]]

;; Phase 31: remove the inbound-question entry for `peer-q-pos`.
;; Used when peer sends op:gc-answer telling us they're done with
;; that answer-pos — we no longer need to remember the local
;; promise we allocated for it.
spec bs-remove-question Nat BridgeState -> BridgeState
defn bs-remove-question
  | qpos [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as [list-remove-q-by-key qs qpos] p oqs ir er pm

;; Phase 31: remove the outbound-question entry for `our-q-pos`.
;; Used when WE've consumed peer's reply and want to send op:gc-answer
;; — the local-promise/q-pos mapping is no longer needed.
spec bs-remove-outbound-question Nat BridgeState -> BridgeState
defn bs-remove-outbound-question
  | qpos [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p [list-remove-q-by-key oqs qpos] ir er pm

;; ===========================================================
;; Phase 34c: imports-refcount accessors + updaters
;; ===========================================================

;; Helpers (math + list update) defined first; used by bs-incr/decr.

;; pred: predecessor on Nat. Saturates at zero.
spec pred Nat -> Nat
defn pred
  | zero  -> zero
  | suc n -> n

;; Saturating subtract for Nat: never below zero.
spec sat-sub Nat Nat -> Nat
defn sat-sub [a b]
  match [nat-eq? a zero]
    | true  -> zero
    | false ->
        match [nat-eq? b zero]
          | true  -> a
          | false -> [sat-sub [pred a] [pred b]]

;; add: Nat addition (helper). Simple def; refcounts are small so
;; non-tail-recursive shape is fine. Brackets around `[suc a]`
;; required for multi-arity defn — without them, `suc a b` parses
;; ambiguously (see goblin-pitfall #18).
spec add Nat Nat -> Nat
defn add
  | zero    b -> b
  | [suc a] b -> [suc [add a b]]

;; Replace-or-add the refcount for key in a List QEntry.
;; Used by bs-incr-import and bs-decr-import below.
spec list-set-q-by-key [List QEntry] Nat Nat -> [List QEntry]
defn list-set-q-by-key
  | nil k v -> [cons [q-entry k v] nil]
  | [cons [q-entry k1 v1] rest] k v ->
      match [nat-eq? k1 k]
        | true  -> [cons [q-entry k v] rest]
        | false -> [cons [q-entry k1 v1] [list-set-q-by-key rest k v]]

;; Look up the current refcount we hold for peer's export N.
;; Returns Some k if we hold k references; None if no entry (= 0).
spec bs-lookup-import-refcount Nat BridgeState -> [Option Nat]
defn bs-lookup-import-refcount [export-id st]
  bs-lookup-question-loop [bs-imports-refcount st] export-id

;; Increment imports-refcount[export-id] by 1. New entry created if
;; absent. Used when decoder encounters a desc:export N in peer's
;; args (Phase 34b).
spec bs-incr-import Nat BridgeState -> BridgeState
defn bs-incr-import
  | export-id [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs
        [list-set-q-by-key ir export-id
          [add [unwrap-or zero [bs-lookup-question-loop ir export-id]] [suc zero]]]
        er
        pm

;; Decrement imports-refcount[export-id] by k. Used by
;; release-import after sending op:gc-export. If decremented past 0
;; (peer-bug or caller bug), caps at 0.
;;
;; Note: this version doesn't remove the entry when refcount reaches
;; 0 — it leaves a 0-valued entry. A future cleanup pass could prune
;; zeroed entries; for now the entry persists harmlessly.
spec bs-decr-import Nat Nat BridgeState -> BridgeState
defn bs-decr-import
  | export-id k [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs
        [list-set-q-by-key ir export-id
          [sat-sub [unwrap-or zero [bs-lookup-question-loop ir export-id]] k]]
        er
        pm

;; ===========================================================
;; Phase 36: exports-refcount — symmetric to imports-refcount
;; ===========================================================
;;
;; Tracks references peer holds to OUR exports. Decremented by
;; inbound op:gc-export. The increment side is manual: the caller
;; (or a future export-introduction protocol) invokes
;; `bs-incr-export` whenever an export is made known to peer.

spec bs-lookup-export-refcount Nat BridgeState -> [Option Nat]
defn bs-lookup-export-refcount [export-id st]
  bs-lookup-question-loop [bs-exports-refcount st] export-id

spec bs-incr-export Nat BridgeState -> BridgeState
defn bs-incr-export
  | export-id [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs ir
        [list-set-q-by-key er export-id
          [add [unwrap-or zero [bs-lookup-question-loop er export-id]] [suc zero]]]
        pm

;; Decrement exports-refcount[export-id] by k. Saturates at 0 if
;; peer's count exceeds ours (peer bug or pre-existing race).
spec bs-decr-export Nat Nat BridgeState -> BridgeState
defn bs-decr-export
  | export-id k [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs ir
        [list-set-q-by-key er export-id
          [sat-sub [unwrap-or zero [bs-lookup-question-loop er export-id]] k]]
        pm

;; ===========================================================
;; Phase 41: pipelined-msgs append (for wire-out forwarding)
;; ===========================================================
;;
;; Append (pid, args) to the bridge's pipeline queue. Phase 38's
;; dispatch-pipeline-on-our-q calls this AFTER the vat-side
;; pipeline-deliver — both queues are populated, but only this one
;; survives fulfill (the vat-side queue gets wiped). Pump-outbound
;; later walks this list, emits forwarding bytes when a queued pid's
;; promise has resolved to a peer-export refr.
spec bs-add-pipeline-msg Nat SyrupValue [Option Nat] BridgeState -> BridgeState
defn bs-add-pipeline-msg
  | pid args ap [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs ir er
        [cons [pipe-msg pid args ap] pm]

;; ===========================================================
;; Phase 27: vat-side `ask` wiring — bridge-send-question
;; ===========================================================
;;
;; The atomic "send a question" operation: allocate a fresh local
;; promise, register it as an outbound question in BridgeState
;; (q-pos = pid for simplicity — single-connection model uses
;; pid as the answer-pos identity), and encode the wire bytes.
;; Returns all four values via the BridgeQuestion struct.
;;
;; Caller usage:
;;   let bq := [bridge-send-question tgt-export args v st]
;;   - send `[bq-bytes bq]` over the wire to peer
;;   - hold `[bq-pid bq]` to await resolution
;;   - thread `[bq-vat bq]` and `[bq-state bq]` into subsequent ops

data BridgeQuestion
  bridge-question : Vat -> BridgeState -> Nat -> String
  ;; (vat-after-allocation, state-with-question-registered,
  ;;  promise-id-awaiting-answer, wire-bytes-of-outbound-question)
  ;; Single constructor — avoids issue #60 cross-module inference.

spec bq-vat BridgeQuestion -> Vat
defn bq-vat
  | bridge-question v _ _ _ -> v

spec bq-state BridgeQuestion -> BridgeState
defn bq-state
  | bridge-question _ st _ _ -> st

spec bq-pid BridgeQuestion -> Nat
defn bq-pid
  | bridge-question _ _ p _ -> p

spec bq-bytes BridgeQuestion -> String
defn bq-bytes
  | bridge-question _ _ _ b -> b

;; Atomic ask: allocate promise, register in outbound-questions,
;; encode wire bytes. Q-pos = pid (1:1 mapping in single-connection
;; model). Returns BridgeQuestion carrying everything the caller
;; needs.
spec bridge-send-question Nat SyrupValue Vat BridgeState -> BridgeQuestion
defn bridge-send-question [tgt-export args v st]
  let alloc := [fresh-promise v]
    let pid := [alloc-id alloc]
      let v1 := [alloc-vat alloc]
        let st1 := [bs-add-outbound-question pid pid st]
          let bytes := [outbound-question-bytes tgt-export args pid]
            bridge-question v1 st1 pid bytes

;; ===========================================================
;; State-aware dispatcher
;; ===========================================================
;;
;; Returns a `BridgeStep` carrying both the updated Vat and the
;; updated BridgeState. We use a concrete struct rather than a
;; Sigma to avoid the Sigma-pattern-match issue (#14).

data BridgeStep
  bridge-step : Vat -> BridgeState

spec bridge-step-vat BridgeStep -> Vat
defn bridge-step-vat
  | bridge-step v _ -> v

spec bridge-step-state BridgeStep -> BridgeState
defn bridge-step-state
  | bridge-step _ st -> st

;; Phase 15 helper: handle op:deliver with answer-pos =
;; some <remote-pos>. Look up an existing question-table entry
;; for `remote`; if found, use the local-id directly. Else
;; allocate a fresh local promise, record (remote → local), and
;; use the new local-id.

spec deliver-with-ap Nat SyrupValue Nat Vat BridgeState -> BridgeStep
defn deliver-with-ap [tgt args remote v st]
  match [bs-lookup-question remote st]
    | some local ->
        bridge-step [enqueue-msg [vmsg-deliver tgt args [some Nat local]] v] st
    | none ->
        let alloc := [fresh-promise v]
          let v' := [alloc-vat alloc]
            let local := [alloc-id alloc]
              let st' := [bs-add-question remote local st]
                bridge-step
                  [enqueue-msg [vmsg-deliver tgt args [some Nat local]] v']
                  st'

;; Phase 15 helper: handle op:deliver. If answer-pos is `some <remote>`,
;; map to a fresh local promise via the question table; if `none`,
;; pass through.

;; deliver-with-fresh-pid: build the bridge-step using a known
;; local promise id (no allocation needed).
spec deliver-with-fresh-pid Nat SyrupValue Nat Vat BridgeState -> BridgeStep
defn deliver-with-fresh-pid [tgt args local v st]
  bridge-step [enqueue-msg [vmsg-deliver tgt args [some Nat local]] v] st

;; deliver-allocate: allocate a fresh local promise and record
;; (remote → local) in the question table; then deliver.
spec deliver-allocate Nat SyrupValue Nat Vat BridgeState -> BridgeStep
defn deliver-allocate [tgt args remote v st]
  let alloc := [fresh-promise v]
    deliver-with-fresh-pid tgt args
      [alloc-id alloc]
      [alloc-vat alloc]
      [bs-add-question remote [alloc-id alloc] st]

;; ===========================================================
;; Phase 34b: refr extraction from inbound args
;; ===========================================================
;;
;; When peer sends `op:deliver tgt args ...`, the args may contain
;; nested `desc:export N` (or `desc:answer N`) tags representing
;; refrs peer is sharing with us. Each occurrence is an "import" —
;; we now hold a reference. The bridge tracks these in
;; `imports-refcount` so that release-import (Phase 34e) can later
;; emit op:gc-export to peer.
;;
;; Phase 34b handles the COMMON case: desc:export in args. The
;; less-common case (desc:answer in args, peer sharing a promise)
;; is acknowledged but deferred to a future phase.

;; Extract refrs from a desc:export payload. Payload should be a
;; syrup-nat N OR syrup-int N (wire decoder produces the latter for
;; `N+` literals). Anything else returns empty list (peer bug).
;; wire-nat handles both shapes; this function lifts that into a
;; List Refr.
spec match-payload-as-export SyrupValue -> List Refr
defn match-payload-as-export [p]
  match [wire-nat p]
    | none   -> [nil Refr]
    | some n -> [cons [refr-remote-export n] [nil Refr]]

;; Same for desc:answer payloads.
spec match-payload-as-answer SyrupValue -> List Refr
defn match-payload-as-answer [p]
  match [wire-nat p]
    | none   -> [nil Refr]
    | some n -> [cons [refr-remote-answer n] [nil Refr]]

;; Phase 37: same for desc:import-object payloads. The OCapN
;; three-vat handoff form. Decoded as refr-remote-import-object;
;; carries the same (kind, id) shape as other refrs but currently no
;; netlayer plumbing actually invokes through it. Receiving one means
;; "peer is introducing some capability; we'll preserve its identity
;; and round-trip it on the wire" — full handoff semantics deferred.
spec match-payload-as-import-object SyrupValue -> List Refr
defn match-payload-as-import-object [p]
  match [wire-nat p]
    | none   -> [nil Refr]
    | some n -> [cons [refr-remote-import-object n] [nil Refr]]

;; Phase 37: handle the desc:answer / desc:import-object branch of
;; tag-dispatch. Pulled out as a 2-deep helper so the top-level
;; extract-refrs-from-tagged stays at depth 2 (no 3-deep nest;
;; pitfall #18 / #33).
spec dispatch-non-export-tag String SyrupValue -> List Refr
defn dispatch-non-export-tag [tag p]
  match [str::eq tag "desc:answer"]
    | true  -> match-payload-as-answer p
    | false ->
        match [str::eq tag "desc:import-object"]
          | true  -> match-payload-as-import-object p
          | false -> [nil Refr]

;; Tag dispatch: recognize "desc:export", "desc:answer", and
;; "desc:import-object" tags. Anything else returns empty list (could
;; be other tagged shapes like Error, syrup records, etc — none carry
;; refrs at this level).
spec extract-refrs-from-tagged String SyrupValue -> List Refr
defn extract-refrs-from-tagged [tag p]
  match [str::eq tag "desc:export"]
    | true  -> match-payload-as-export p
    | false -> dispatch-non-export-tag tag p

;; Single-element check: refrs reachable directly from a SyrupValue
;; (top-level desc:export / desc:answer tag). Does NOT recurse into
;; syrup-list children — see extract-refrs-from-args's wrapper for
;; the one-level-deep list walk. Mutual recursion with a list walker
;; isn't supported in Prologos (pitfall #16: no forward references),
;; so the design is "outer one-layer list walk + inner shallow check
;; per element."
;;
;; Limitation: refrs nested inside records or deeper than one list
;; level aren't found. For the OCapN common case (args = list of
;; refrs and primitives, OR args = a single refr), this is enough.
;; A future phase that wants full recursion can add it via foldr +
;; type-erased generic walker.
spec shallow-refr SyrupValue -> List Refr
defn shallow-refr
  | syrup-null         -> [nil Refr]
  | syrup-bool _       -> [nil Refr]
  | syrup-nat _        -> [nil Refr]
  | syrup-int _        -> [nil Refr]
  | syrup-string _     -> [nil Refr]
  | syrup-symbol _     -> [nil Refr]
  | syrup-refr _       -> [nil Refr]
  | syrup-promise _    -> [nil Refr]
  | syrup-bytes _      -> [nil Refr]
  | syrup-list _       -> [nil Refr]    ;; SHALLOW: nested lists not walked
  | syrup-tagged tag p -> [extract-refrs-from-tagged tag p]

;; Walk a list of SyrupValue once, calling shallow-refr on each
;; element. NOT mutually recursive (only calls shallow-refr).
;; Uses bracketed-arg + inline `match` form (same shape as data/list's
;; concat) — works around the multi-arity-with-cons-pattern issue
;; that `defn name | nil -> ... | [cons hd tl] -> ...` triggers.
spec walk-toplevel-list [List SyrupValue] -> List Refr
defn walk-toplevel-list [xs]
  match xs
    | nil          -> [nil Refr]
    | cons hd tl   -> [append Refr [shallow-refr hd] [walk-toplevel-list tl]]

;; Top-level walk: collect refrs from a SyrupValue. If args itself
;; is a desc:* tag, extract directly. If args is a syrup-list, walk
;; one level into the list. Other shapes (atomic) yield no refrs.
spec extract-refrs-from-args SyrupValue -> List Refr
defn extract-refrs-from-args
  | syrup-null         -> [nil Refr]
  | syrup-bool _       -> [nil Refr]
  | syrup-nat _        -> [nil Refr]
  | syrup-int _        -> [nil Refr]
  | syrup-string _     -> [nil Refr]
  | syrup-symbol _     -> [nil Refr]
  | syrup-refr _       -> [nil Refr]
  | syrup-promise _    -> [nil Refr]
  | syrup-bytes _      -> [nil Refr]
  | syrup-list xs      -> [walk-toplevel-list xs]
  | syrup-tagged tag p -> [extract-refrs-from-tagged tag p]

;; Increment imports-refcount for one Refr value. Only
;; remote-export refrs increment imports-refcount; other kinds
;; (local-*, remote-answer) are no-ops here (remote-answer would
;; need a separate imports-promise table — deferred).
spec bs-incr-import-by-refr Refr BridgeState -> BridgeState
defn bs-incr-import-by-refr [r st]
  match [refr-remote-export? r]
    | true  -> [bs-incr-import [refr-id r] st]
    | false -> st

;; Bulk-increment imports-refcount for a list of Refrs (the result
;; of extract-refrs-from-args). Used by captp-incoming-with-state
;; to register all imports before dispatching.
spec bs-incr-imports [List Refr] BridgeState -> BridgeState
defn bs-incr-imports
  | nil           st -> st
  | [cons r rest] st -> [bs-incr-imports rest [bs-incr-import-by-refr r st]]

;; dispatch-deliver: route an op:deliver based on whether the
;; answer-pos is `some <remote>` or `none`.
;;   none  → pass-through (no promise needed)
;;   some  → if remote is in question table, reuse local;
;;           else allocate fresh local + record mapping
spec dispatch-deliver Nat SyrupValue [Option Nat] Vat BridgeState -> BridgeStep
defn dispatch-deliver [tgt args ap v st]
  match ap
    | none ->
        bridge-step [enqueue-msg [vmsg-deliver tgt args [none Nat]] v] st
    | some remote ->
        match [bs-lookup-question remote st]
          | some local -> deliver-with-fresh-pid tgt args local v st
          | none       -> deliver-allocate tgt args remote v st

;; Phase 38: wire-level promise pipelining (responder side).
;;
;; Peer sent `<op:deliver <desc:answer N> args ...>` where N is one of
;; THEIR question positions — i.e., a position WE recorded in our
;; inbound `bs-questions` table when peer first asked us. They want
;; us to chain `args` onto whatever the answer at N is:
;;   - If N's local promise is unresolved, queue `args` on it (so
;;     when we eventually resolve it, queued messages flow forward
;;     to the resolution target via vat-side pipelining).
;;   - If N has resolved to a registered actor, send `args` to it.
;;   - If N is unknown / settled-with-non-actor, drop.
;;
;; `pipeline-deliver` (from prologos::ocapn::pipelining) implements
;; the actor-vs-promise dispatch on the local id; the bridge's job is
;; just the q-pos → local-id lookup.
spec dispatch-pipeline-on-our-q Nat SyrupValue [Option Nat] Vat BridgeState -> BridgeStep
defn dispatch-pipeline-on-our-q [qpos args ap v st]
  match [bs-lookup-question qpos st]
    | none     -> bridge-step v st
    | some pid ->
        ;; Phase 41: dual-queue. The vat-side queue (via pipeline-deliver)
        ;; is for in-process pipelining (and gets wiped on fulfill). The
        ;; bridge-side queue (via bs-add-pipeline-msg) survives fulfill so
        ;; pump-outbound can emit forwarding bytes when the local promise
        ;; resolves to a peer-export refr.
        ;; Phase 45: ap (peer's answer-pos for the pipelined deliver)
        ;; threaded through so break-forward can emit error answers
        ;; if the local promise breaks.
        bridge-step [pipeline-deliver pid args v]
                    [bs-add-pipeline-msg pid args ap st]

;; Phase 25 questioner-side: peer is replying to our outbound
;; question. Look up the local promise tied to our question-pos
;; in `bs-outbound-questions`; resolve it with the answer payload.
;;
;; Phase 38 fall-through: if `qpos` is NOT in our outbound table,
;; check the inbound table — peer might be pipelining onto a question
;; THEY asked, not replying to one WE asked. Same wire shape, two
;; semantics; the disambiguation is which table holds `qpos`. (No
;; overlap: outbound q-pos ids are allocated by us, inbound by peer.)
;; Unknown to both = drop.
spec dispatch-incoming-answer Nat SyrupValue [Option Nat] Vat BridgeState -> BridgeStep
defn dispatch-incoming-answer [qpos args ap v st]
  match [bs-lookup-outbound-question qpos st]
    | none      -> dispatch-pipeline-on-our-q qpos args ap v st
    | some pid  -> bridge-step [resolve-promise pid args v] st

;; Phase 51: op:listen late-registration handling.
;;
;; When peer sends op:listen for a target promise, the target may
;; already have settled (peer's view is async; their op:listen may
;; arrive after our pump-outbound already emitted the resolution).
;; Two cases:
;;
;;   target unsettled  → add listener to bs-listeners as usual; the
;;                       next pump-outbound walks listeners during
;;                       resolution emission.
;;   target settled    → stage an immediate listener-notify-bytes on
;;                       pending-out (flushed by the next pump). Do
;;                       NOT add to bs-listeners — pid is already in
;;                       `emitted`, so the pump's walk would skip it,
;;                       leaving the listener stuck forever.
;;
;; Without this handler, late-arriving op:listen for a settled promise
;; never fires the notification; the listener entry leaks because no
;; future pump-outbound iteration touches it.
spec bs-handle-listen-with-late-fire Nat Nat Vat BridgeState -> BridgeState
defn bs-handle-listen-with-late-fire [tgt resolver v st]
  match [lookup-promise tgt v]
    | none -> bs-add-listener tgt resolver st
    | some pst ->
        match [resolution-syrup-of-pst pst]
          | none         -> bs-add-listener tgt resolver st
          | some payload ->
              bs-append-pending-out [listener-notify-bytes resolver payload] st

spec captp-incoming-with-state CapTPOp Vat BridgeState -> BridgeStep
  :doc "Apply an inbound CapTPOp to (Vat, BridgeState). Phase 14 + 15 + 25 + 34b."
defn captp-incoming-with-state
  | [op-deliver tgt args ap _rm] v st ->
      ;; Phase 34b: inbound args may contain refrs peer is sharing
      ;; with us (desc:export / desc:answer in nested positions).
      ;; Each occurrence increments imports-refcount so release-import
      ;; can later emit op:gc-export.
      dispatch-deliver tgt args ap v
        [bs-incr-imports [extract-refrs-from-args args] st]
  | [op-deliver-only tgt args] v st ->
      ;; Phase 34b: same import-bookkeeping for fire-and-forget deliveries.
      bridge-step [send-only tgt args v]
        [bs-incr-imports [extract-refrs-from-args args] st]
  | [op-abort _reason] v st ->
      bridge-step v st
  | [op-start-session _ver _loc] v st ->
      ;; Phase 25 handshake: peer's session arrived — state already
      ;; carries our session bytes in pending-out (set up via
      ;; bridge-state-with-our-session); the next pump-outbound call
      ;; will flush them. State-preserving here, emission deferred.
      bridge-step v st
  | [op-listen tgt resolver] v st ->
      ;; Phase 51: late-registration handling. If the target promise
      ;; has ALREADY settled by the time the op:listen arrives, the
      ;; pump-outbound walk would skip it (the `emitted` set gates
      ;; re-emission). Register the listener anyway so the next pump
      ;; sees it AND stage an immediate notification on pending-out
      ;; — without this, a "late" op:listen never fires because the
      ;; promise's pump pass already happened.
      bridge-step v
        [bs-handle-listen-with-late-fire tgt resolver v st]
  | [op-gc-export pos cnt] v st ->
      ;; Phase 36: peer dropped k references to our export N.
      ;; Decrement exports-refcount[N] by k (saturating at 0) AND
      ;; append to gc-exports audit log (preserves diagnostic
      ;; visibility into peer's claims).
      bridge-step v [bs-decr-export pos cnt [bs-add-gc-export pos cnt st]]
  | [op-gc-answer pos] v st ->
      ;; Phase 33: peer is done with our inbound-question at q-pos N
      ;; (one of OUR answer-table entries). Remove it from
      ;; bs-questions — we no longer need to remember the local
      ;; promise tied to that q-pos. Also append to gc-answers audit
      ;; log so callers can inspect what was released.
      bridge-step v [bs-remove-question pos [bs-add-gc-answer pos st]]
  | [op-deliver-to-answer qpos args ap _rm] v st ->
      ;; Phase 25 questioner-side: peer is replying to our question
      ;; with pos `qpos`. Look up `qpos` in BridgeState's
      ;; outbound-questions; if found, resolve the corresponding
      ;; local promise with the answer payload. Unknown qpos = drop
      ;; (peer answered a question we don't know about — could be
      ;; protocol error or stale connection; conservative no-op).
      ;; Phase 34b: the answer args may contain refrs (peer sharing
      ;; refrs with us in their reply); increment imports-refcount.
      ;; Phase 45: ap threaded so dispatch-pipeline-on-our-q can
      ;; record the queued deliver's answer-pos for break-forwarding.
      dispatch-incoming-answer qpos args ap v
        [bs-incr-imports [extract-refrs-from-args args] st]

;; ===========================================================
;; Phase 41: resolution-value inspection + forwarding
;; ===========================================================
;;
;; The wire-out closure of pipelining: when a local promise resolves
;; to a peer-export refr, walk the bridge-side pipeline queue and emit
;; forwarding op:deliver bytes for each queued (pid, args).
;;
;; "Resolves to a peer-export refr" means the resolution-value is a
;; SyrupValue of shape `<desc:export K>`. Other resolution shapes
;; (peer-answer, local-actor, plain value, broken) drop queued msgs
;; for now — desc:answer chaining (resolve-to-promise) and local-actor
;; forwarding are deferred to a future phase.

;; Extract the Nat from a syrup-nat OR a non-negative syrup-int (the
;; wire decoder produces syrup-int for `N+` literals — both shapes
;; need to be handled). Reuses captp-wire's wire-nat which does the
;; syrup-int → Nat conversion when the int is non-negative.
spec tagged-payload-as-nat SyrupValue -> [Option Nat]
defn tagged-payload-as-nat [p]
  wire-nat p

;; Inspect a SyrupValue. Returns Some K if it's `<desc:export K>`;
;; None for any other shape (including desc:answer, plain value, list,
;; etc). 2-deep match (sidesteps pitfall #18).
spec syrup-as-export-target SyrupValue -> [Option Nat]
defn syrup-as-export-target
  | syrup-null       -> [none Nat]
  | syrup-bool _     -> [none Nat]
  | syrup-nat _      -> [none Nat]
  | syrup-int _      -> [none Nat]
  | syrup-string _   -> [none Nat]
  | syrup-symbol _   -> [none Nat]
  | syrup-list _     -> [none Nat]
  | syrup-refr _     -> [none Nat]
  | syrup-bytes _    -> [none Nat]
  | syrup-promise _  -> [none Nat]
  | syrup-tagged tag p ->
      match [str::eq tag "desc:export"]
        | true  -> tagged-payload-as-nat p
        | false -> [none Nat]

;; Phase 44: same inspection for desc:answer chained-answer resolution.
;; Returns Some M if shape is `<desc:answer M>`, else none.
spec syrup-as-answer-target SyrupValue -> [Option Nat]
defn syrup-as-answer-target
  | syrup-null       -> [none Nat]
  | syrup-bool _     -> [none Nat]
  | syrup-nat _      -> [none Nat]
  | syrup-int _      -> [none Nat]
  | syrup-string _   -> [none Nat]
  | syrup-symbol _   -> [none Nat]
  | syrup-list _     -> [none Nat]
  | syrup-refr _     -> [none Nat]
  | syrup-bytes _    -> [none Nat]
  | syrup-promise _  -> [none Nat]
  | syrup-tagged tag p ->
      match [str::eq tag "desc:answer"]
        | true  -> tagged-payload-as-nat p
        | false -> [none Nat]

;; Build the wire bytes for a forwarded op:deliver:
;;   <op:deliver <TAG target> args false false>
;; where TAG is "desc:export" (Phase 41 — peer's export) or
;; "desc:answer" (Phase 44 — chained answer at peer's bs-questions).
;; Caller picks the tag based on the resolution-value shape.
spec forward-deliver-bytes String Nat SyrupValue -> String
defn forward-deliver-bytes [tag target args]
  wire::encode-record "op:deliver"
    [cons [syrup-tagged tag [syrup-nat target]]
      [cons args
        [cons [syrup-bool false]
          [cons [syrup-bool false] nil]]]]

;; Walk pipelined-msgs; for each entry whose pid matches `pid`, emit
;; forwarding bytes targeting (TAG, target). Entries with mismatched
;; pid are ignored (they'll be handled when their own promise resolves
;; on a future pump). Result is built head-first (most-recent first);
;; caller appends/prepends as appropriate.
spec forward-bytes-loop String Nat Nat [List PipeMsg] [List String] -> [List String]
defn forward-bytes-loop
  | _   _   _      nil                            accum -> accum
  | tag pid target [cons [pipe-msg p args _] rest] accum ->
      match [nat-eq? p pid]
        | true  -> forward-bytes-loop tag pid target rest [cons [forward-deliver-bytes tag target args] accum]
        | false -> forward-bytes-loop tag pid target rest accum

;; ===========================================================
;; Phase 42: local-actor forwarding
;; ===========================================================
;;
;; Phase 41 handles the wire path: queued msgs forwarded to peer when
;; resolution is `<desc:export K>` and K is peer's export. Phase 42
;; handles the case where K is OUR own actor (registered in the vat's
;; actor table). Then forwarding means delivering the queued msg
;; LOCALLY via send-only — enqueueing a VatMsg on the vat queue, ready
;; for the next drain.
;;
;; Discrimination: lookup-actor K v. If found, K is local; else K is
;; (presumably) peer's export. In our id space actor ids and external
;; refr ids don't collide (actors are vat-local; peer-export ids are
;; peer-vat-local).

;; Walk pipelined-msgs; for each entry whose pid matches `pid`, send
;; the args to local actor `k`. Returns updated vat with msgs queued.
spec deliver-locally-loop Nat Nat [List PipeMsg] Vat -> Vat
defn deliver-locally-loop
  | _   _ nil                            v -> v
  | pid k [cons [pipe-msg p args _] rest] v ->
      match [nat-eq? p pid]
        | true  -> deliver-locally-loop pid k rest [send-only k args v]
        | false -> deliver-locally-loop pid k rest v

;; ===========================================================
;; Phase 45: break-forwarding
;; ===========================================================
;;
;; When the local promise breaks (pst-broken r), each queued pipelined
;; msg with ap = some M needs an error answer at peer's q-pos M, so
;; peer's awaiting promise at M doesn't hang. Wire form for the error
;; answer mirrors a normal answer reply:
;;
;;   <op:deliver <desc:answer M> <Error r> false false>
;;
;; Queued msgs whose ap was none (fire-and-forget pipelined deliver)
;; are dropped silently — peer wasn't expecting an answer.

;; Inner: ap is some/none and r is the broken reason. If ap is some M,
;; build the error answer bytes and prepend; otherwise leave accum.
spec break-step-matched-pid Nat SyrupValue [Option Nat] [List String] -> [List String]
defn break-step-matched-pid [pid r ap accum]
  match ap
    | none   -> accum
    | some m -> [cons [outbound-deliver-bytes m [wrap-error r]] accum]

;; Middle: per-PipeMsg processing. If entry's pid matches, dispatch
;; on its ap; otherwise pass through.
spec break-step Nat SyrupValue PipeMsg [List String] -> [List String]
defn break-step [pid r entry accum]
  match entry
    | pipe-msg p _args ap ->
        match [nat-eq? p pid]
          | false -> accum
          | true  -> break-step-matched-pid pid r ap accum

;; Walk pipelined-msgs accumulating error-answer bytes for each
;; pid-matching entry whose ap is some.
spec break-forward-loop Nat SyrupValue [List PipeMsg] [List String] -> [List String]
defn break-forward-loop
  | _   _ nil                accum -> accum
  | pid r [cons entry rest]  accum ->
      break-forward-loop pid r rest [break-step pid r entry accum]

;; Phase 45: dispatch the broken case. If pst is pst-broken r, walk
;; pipelined-msgs and emit error-answer bytes for each queued deliver
;; that had a non-false answer-pos. Other PromiseStates: no effect.
spec dispatch-broken-resolution Nat PromiseState [List PipeMsg] Vat -> ForwardEffect
defn dispatch-broken-resolution
  | _   [pst-unresolved _] _   v -> [forward-effect v [nil String]]
  | _   [pst-fulfilled  _] _   v -> [forward-effect v [nil String]]
  | pid [pst-broken     r] pms v ->
      [forward-effect v [break-forward-loop pid r pms [nil String]]]

;; Phase 46: plain-value resolution. When the promise fulfills with a
;; value that isn't a callable (not desc:export, not desc:answer),
;; applying op:deliver to it is itself an error. Each queued msg is
;; processed as if delivered, fails type-check, and produces an error
;; answer at peer's ap. Same shape as break-forwarding (Phase 45) with
;; a synthesized reason. Queued msgs with ap=none have nowhere to send
;; the error, but ARE still semantically processed (not dropped).
spec plain-value-error-reason String -> SyrupValue
defn plain-value-error-reason [_msg]
  ;; The reason names the type-error condition. Caller passes a hint
  ;; string for now (kept generic in case future variants want richer
  ;; reasons — e.g., the actual resolution-value SyrupValue inlined).
  syrup-string "deliver-to-non-callable"

spec dispatch-plain-value-resolution Nat [List PipeMsg] Vat -> ForwardEffect
defn dispatch-plain-value-resolution [pid pms v]
  [forward-effect v [break-forward-loop pid [plain-value-error-reason ""] pms [nil String]]]

;; ForwardEffect bundles the two outcomes of forwarding: an updated
;; Vat (if msgs were delivered locally) plus a list of bytes (if any
;; were forwarded on the wire). Single-constructor avoids issue #60.
data ForwardEffect
  forward-effect : Vat -> [List String]

spec fwd-effect-vat ForwardEffect -> Vat
defn fwd-effect-vat
  | forward-effect v _ -> v

spec fwd-effect-bytes ForwardEffect -> List String
defn fwd-effect-bytes
  | forward-effect _ bs -> bs

;; Innermost helper for desc:export: K is the export target.
;; Discriminate local-actor (Phase 42) vs peer-export (Phase 41) via
;; lookup-actor. Bottom of the helper chain that sidesteps pitfall #18's
;; 3-deep nested match.
spec dispatch-export-target Nat Nat [List PipeMsg] Vat -> ForwardEffect
defn dispatch-export-target [pid k pms v]
  match [lookup-actor k v]
    | some _ -> [forward-effect [deliver-locally-loop pid k pms v] [nil String]]
    | none   -> [forward-effect v [forward-bytes-loop "desc:export" pid k pms [nil String]]]

;; Phase 44: chained-answer dispatch. Resolution to `<desc:answer M>`
;; means "the result is whatever lives at our outbound-question M (or
;; will live there when peer answers)." Forwarding via wire as
;; `<op:deliver <desc:answer M> args false false>` works: peer decodes
;; the desc:answer target, falls through their dispatch-incoming-answer
;; → dispatch-pipeline-on-our-q (Phase 38), looks up M in peer's
;; bs-questions (= peer's local promise tied to our outbound Q), and
;; queues the args there. The pipelining loop continues across the
;; chain. No local re-binding needed.
;;
;; This is purely wire-side; the local-actor case doesn't apply to
;; desc:answer (an answer-target isn't a local actor).
spec dispatch-answer-target Nat Nat [List PipeMsg] Vat -> ForwardEffect
defn dispatch-answer-target [pid m pms v]
  [forward-effect v [forward-bytes-loop "desc:answer" pid m pms [nil String]]]

;; Middle helper: V is the resolution-value SyrupValue. Try
;; desc:export first (most common); fall through to desc:answer
;; (chained); else plain value (Phase 46) — error-forward each queued
;; msg with reason "deliver-to-non-callable". We never drop the queue:
;; per the user's correction (Phase 46 design), `op:deliver` to a
;; plain non-callable value is a TYPE error reported at the queued
;; msg's ap, structurally identical to broken-promise error-forwarding
;; (Phase 45). Two-deep match (sidesteps pitfall #18).
spec dispatch-resolution-value Nat SyrupValue [List PipeMsg] Vat -> ForwardEffect
defn dispatch-resolution-value [pid V pms v]
  match [syrup-as-export-target V]
    | some k -> dispatch-export-target pid k pms v
    | none ->
        match [syrup-as-answer-target V]
          | some m -> dispatch-answer-target pid m pms v
          | none   -> dispatch-plain-value-resolution pid pms v

;; Top-level: given a resolved promise's pid + resolution PromiseState
;; + bridge's pipelined-msgs list + current Vat, return a ForwardEffect
;; carrying (updated-vat, forward-bytes). Outcomes by PromiseState:
;;   pst-broken r       → error-forward (Phase 45): emit <op:deliver
;;                        <desc:answer M> <Error r> false false> for
;;                        each queued msg with ap = some M.
;;   pst-fulfilled V    → fulfilled-forward, dispatch on V's shape:
;;                          desc:export → local-actor (Phase 42) or
;;                                        peer-export wire forward
;;                                        (Phase 41)
;;                          desc:answer → chained-answer wire forward
;;                                        (Phase 44)
;;                          plain V    → error-forward (Phase 46) with
;;                                        reason "deliver-to-non-
;;                                        callable" — same shape as
;;                                        broken; we never drop the
;;                                        queue.
;;   pst-unresolved _   → no effect (caller already gates on
;;                        outbound-from-resolution returning some;
;;                        unresolved means "wait, not drop").
;; broken? gates the dispatch into the error path before resolution-
;; value collapses fulfilled and broken into the same Some.
spec build-forward-effect Nat PromiseState [List PipeMsg] Vat -> ForwardEffect
defn build-forward-effect [pid pst pms v]
  match [broken? pst]
    | true  -> dispatch-broken-resolution pid pst pms v
    | false ->
        match [resolution-value pst]
          | none   -> [forward-effect v [nil String]]
          | some V -> dispatch-resolution-value pid V pms v

;; ===========================================================
;; Wire-OUT pump — Phase 16
;; ===========================================================
;;
;; After draining the vat, walk the question table. For each
;; (remote, local) entry whose local promise has been fulfilled
;; AND hasn't been emitted yet, produce outbound bytes:
;;   <op:deliver <desc:answer remote> resolved-value false false>
;;
;; The "emitted" list prevents duplicate sends across turns.
;;
;; This closes the bridge loop: any incoming op:deliver that
;; specifies an answer-pos round-trips to outbound bytes once
;; the local promise resolves, no manual orchestration required.

;; Membership check on a Nat list. Returns true iff `n` is in `xs`.
spec member-nat? Nat [List Nat] -> Bool
defn member-nat?
  | _ nil -> false
  | n [cons h t] ->
      match [nat-eq? n h]
        | true  -> true
        | false -> member-nat? n t

;; ===========================================================
;; Phase 47: GC of bridge-side pipelined-msgs entries
;; ===========================================================
;;
;; Once pump-outbound has emitted forwarding bytes (or break-forward /
;; plain-value error answers) for a given local promise pid, the
;; queued entries with that pid are no longer needed — they've been
;; processed end-to-end. Without GC, bs-pipelined-msgs grows
;; monotonically across the connection's lifetime; with GC the queue
;; shrinks back to entries whose pid hasn't yet been emitted.
;;
;; The filter is applied at connection-step granularity (after
;; pump-outbound), keyed by pump-result's `emitted` cumulative list.

spec list-filter-pipe-by-emitted [List PipeMsg] [List Nat] -> [List PipeMsg]
  :doc "Drop pipe-msg entries whose pid is in the emitted set."
defn list-filter-pipe-by-emitted
  | nil _ -> [nil PipeMsg]
  | [cons [pipe-msg p args ap] rest] emitted ->
      match [member-nat? p emitted]
        | true  -> list-filter-pipe-by-emitted rest emitted
        | false ->
            [cons [pipe-msg p args ap] [list-filter-pipe-by-emitted rest emitted]]

spec bs-gc-pipelined-msgs-by-emitted [List Nat] BridgeState -> BridgeState
  :doc "Phase 47: drop pipelined-msgs entries whose pid is in `emitted`. Applied after pump-outbound at connection-step granularity."
defn bs-gc-pipelined-msgs-by-emitted
  | emitted [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state ls es as qs p oqs ir er
        [list-filter-pipe-by-emitted pm emitted]

;; ===========================================================
;; Phase 48: op:listen notification on resolution
;; ===========================================================
;;
;; When a local promise pid settles, peer-registered listeners
;; targeting pid get a notification: `op:deliver` to the listener's
;; resolver-pos with the resolution payload (the value if fulfilled,
;; <Error r> if broken). Listeners are one-shot — once notified, the
;; entry is filtered out of bs-listeners.
;;
;; Pre-Phase-48 behaviour: bs-add-listener stored entries but they
;; were never consulted; resolution didn't notify the registrant.
;; This phase wires the notification path end-to-end alongside
;; pump-outbound's existing per-pid handling.

;; Walk listeners; for every entry whose target = pid, prepend
;; notification bytes (op:deliver to resolver-pos with payload) to
;; accum. Returns the resulting bytes list.
spec listener-notify-loop [List Listener] Nat SyrupValue [List String] -> [List String]
defn listener-notify-loop
  | nil _ _ accum -> accum
  | [cons [listener tgt res] rest] pid payload accum ->
      match [nat-eq? tgt pid]
        | true  ->
            listener-notify-loop rest pid payload
              [cons [listener-notify-bytes res payload] accum]
        | false -> listener-notify-loop rest pid payload accum

;; Filter listeners: drop entries whose target is in the notified-pids
;; set. One-shot semantics — once a listener has fired, its entry is
;; no longer needed (and re-firing on a re-resolved promise would be a
;; spec violation; promises settle exactly once).
spec list-filter-listeners-by-notified [List Listener] [List Nat] -> [List Listener]
defn list-filter-listeners-by-notified
  | nil _ -> [nil Listener]
  | [cons [listener tgt res] rest] notified ->
      match [member-nat? tgt notified]
        | true  -> list-filter-listeners-by-notified rest notified
        | false ->
            [cons [listener tgt res]
              [list-filter-listeners-by-notified rest notified]]

spec bs-gc-listeners-by-notified [List Nat] BridgeState -> BridgeState
  :doc "Phase 48: drop listener entries whose target is in `notified`. Applied after pump-outbound at connection-step granularity, alongside pipelined-msgs GC."
defn bs-gc-listeners-by-notified
  | notified [bridge-state ls es as qs p oqs ir er pm] ->
      bridge-state [list-filter-listeners-by-notified ls notified] es as qs p oqs ir er pm

;; Result of the pump: bytes emitted this turn + updated emitted-pids
;; + the vat (Phase 42 may have enqueued local-actor messages on it
;; via pipelined-msg forwarding to a refr-local-export resolution).
data PumpResult
  pump-result : Vat -> [List String] -> [List Nat]

spec pump-result-vat PumpResult -> Vat
defn pump-result-vat
  | pump-result v _ _ -> v

spec pump-result-bytes PumpResult -> List String
defn pump-result-bytes
  | pump-result _ bs _ -> bs

spec pump-result-emitted PumpResult -> List Nat
defn pump-result-emitted
  | pump-result _ _ es -> es

;; Per-question: if the local promise has settled (fulfilled OR
;; broken) AND the pid hasn't been emitted yet, prepend bytes
;; targeting the REMOTE answer-pos and add local to the emitted
;; list. Phase 17 extends Phase 16 to broken promises via
;; `outbound-from-resolution`. Phase 41 also walks pipelined-msgs
;; and emits forwarding bytes when resolution is a peer-export refr;
;; Phase 42 delivers locally if the export id is one of our own
;; actors (the ForwardEffect carries the updated vat).
;; Phase 48: build listener-notification bytes for `local` if pst has
;; settled. Walks `ls` filtering target=local and emits notify bytes
;; per matching listener. Returns the (possibly extended) accum.
;; Pre-pump callers always have a settled pst here (called only on
;; the `some bytes` branch), but resolution-syrup-of-pst still gates
;; defensively to keep the helper total.
spec listener-bytes-for-pid [List Listener] Nat PromiseState [List String] -> [List String]
defn listener-bytes-for-pid [ls pid pst accum]
  match [resolution-syrup-of-pst pst]
    | none         -> accum
    | some payload -> listener-notify-loop ls pid payload accum

spec pump-one Nat Nat Vat [List PipeMsg] [List Listener] [List Nat] [List String] -> PumpResult
defn pump-one [remote local v pms ls emitted accum]
  match [member-nat? local emitted]
    | true  -> pump-result v accum emitted
    | false ->
        match [lookup-promise local v]
          | none -> pump-result v accum emitted
          | some pst ->
              match [outbound-from-resolution remote pst]
                | none       -> pump-result v accum emitted
                | some bytes ->
                    let fwd := [build-forward-effect local pst pms v]
                      let listener-bytes :=
                            [listener-bytes-for-pid ls local pst [nil String]]
                        [pump-result
                          [fwd-effect-vat fwd]
                          [cons bytes
                            [append String [fwd-effect-bytes fwd]
                              [append String listener-bytes accum]]]
                          [cons local emitted]]

;; Walk the question-table list once.
spec pump-loop [List QEntry] Vat [List PipeMsg] [List Listener] [List Nat] [List String] -> PumpResult
defn pump-loop
  | nil v _ _ emitted accum -> pump-result v accum emitted
  | [cons [q-entry remote local] rest] v pms ls emitted accum ->
      let r := [pump-one remote local v pms ls emitted accum]
        pump-loop rest [pump-result-vat r] pms ls
          [pump-result-emitted r]
          [pump-result-bytes r]

;; Prepend the pending-out bytes to the pump-loop's result.
;; Defined BEFORE pump-outbound so the call site below can resolve.
spec prepend-pending-out [List String] PumpResult -> PumpResult
defn prepend-pending-out [pending pr]
  pump-result [pump-result-vat pr]
              [append String pending [pump-result-bytes pr]]
              [pump-result-emitted pr]

;; Public top-level pump.
spec pump-outbound Vat BridgeState [List Nat] -> PumpResult
  :doc "Walk the question table; emit bytes for newly-resolved promises plus any pending-out bytes (e.g. handshake reply). Phase 42: also delivers pipelined msgs locally to actors when applicable; the resulting Vat is in the PumpResult. Phase 48: also emits listener-notification bytes for any registered op:listen targeting a settled pid."
defn pump-outbound [v st emitted]
  prepend-pending-out [bs-pending-out st]
    [pump-loop [bs-questions st] v
      [bs-pipelined-msgs st] [bs-listeners st] emitted nil]

;; Convenience helper for tests / callers that want the first
;; emitted byte-string (or a default if nothing was emitted).
;; Avoids the polymorphic `head` resolution issues across
;; namespaces.
spec first-bytes-or-default String [List String] -> String
defn first-bytes-or-default
  | default nil          -> default
  | _       [cons h _]   -> h

;; ===========================================================
;; Connection lifecycle composer — Phase 18
;; ===========================================================
;;
;; A `ConnectionState` carries everything needed to model one
;; CapTP connection's local side:
;;   - The Vat (actors + promises + queue).
;;   - The BridgeState (listeners, gc requests, question table).
;;   - Emitted-pids list (for the wire-OUT pump's idempotence).
;;   - Aborted? flag — set after seeing op:abort; further ops
;;     are ignored.
;;
;; `connection-step` is the single entry point: take one inbound
;; CapTPOp, apply it through the bridge, drain the vat, pump
;; outbound bytes for newly-resolved promises, return updated
;; state + new bytes to send.
;;
;; A real netlayer loop is just:
;;   while (not aborted)
;;     read op  ←  decode bytes from socket
;;     step = connection-step op cs
;;     write each byte-string in (conn-step-outbound step)  →  socket
;;     cs = conn-step-state step

data ConnectionState
  conn-state : Vat -> BridgeState -> [List Nat] -> Bool

def empty-connection : ConnectionState :=
  [conn-state empty-vat bridge-state-empty nil false]

spec conn-vat ConnectionState -> Vat
defn conn-vat
  | conn-state v _ _ _ -> v

spec conn-bridge-state ConnectionState -> BridgeState
defn conn-bridge-state
  | conn-state _ st _ _ -> st

spec conn-emitted ConnectionState -> List Nat
defn conn-emitted
  | conn-state _ _ es _ -> es

spec conn-aborted? ConnectionState -> Bool
defn conn-aborted?
  | conn-state _ _ _ a -> a

;; Result of one step: updated state + outbound bytes.
data ConnStep
  conn-step : ConnectionState -> [List String]

spec conn-step-state ConnStep -> ConnectionState
defn conn-step-state
  | conn-step cs _ -> cs

spec conn-step-outbound ConnStep -> List String
defn conn-step-outbound
  | conn-step _ bs -> bs

;; ===========================================================
;; Phase 28: high-level questioner-side ask on ConnectionState
;; ===========================================================
;;
;; The user-facing companion to `connection-step` (which dispatches
;; ONE inbound op). `connection-ask` is the OUTBOUND analog: the
;; caller has a ConnectionState and wants to ask peer a question,
;; tracking the resulting promise. Returns a `ConnAsk` carrying:
;;   - updated ConnectionState (with the question registered)
;;   - the local promise-id to await
;;   - the wire bytes to send to peer
;;
;; Composes with connection-step: the caller writes bytes to the
;; socket, eventually reads peer's reply, dispatches via
;; connection-step (which routes the op-deliver-to-answer through
;; dispatch-incoming-answer → resolves the promise).
;;
;; A real netlayer using BOTH:
;;   ;; questioner side
;;   ask = connection-ask refr args cs
;;   write (conn-ask-bytes ask) → socket
;;   cs = conn-ask-state ask
;;
;;   ;; responder side (handles peer-initiated ops + our incoming answers)
;;   while not aborted:
;;     read op  ← decode bytes from socket
;;     step = connection-step op cs
;;     write each (conn-step-outbound step) → socket
;;     cs = conn-step-state step
;;     if (lookup-promise (conn-ask-pid ask) (conn-vat cs)) is fulfilled:
;;       … the peer answered our question

data ConnAsk
  conn-ask : ConnectionState -> Nat -> String
  ;; (state-with-question-registered, promise-id-awaiting-answer,
  ;;  wire-bytes-to-send)
  ;; Single constructor — avoids issue #60.

spec conn-ask-state ConnAsk -> ConnectionState
defn conn-ask-state
  | conn-ask cs _ _ -> cs

spec conn-ask-pid ConnAsk -> Nat
defn conn-ask-pid
  | conn-ask _ p _ -> p

spec conn-ask-bytes ConnAsk -> String
defn conn-ask-bytes
  | conn-ask _ _ b -> b

;; High-level ask: take a ConnectionState, ask peer's export `tgt`
;; with payload `args`, return ConnAsk. Internally calls
;; bridge-send-question and packs the result + emitted-pids +
;; aborted? back into a ConnectionState.
;;
;; Aborted-check: if the connection is already aborted, this is a
;; no-op — returns the same state with pid=0 and empty bytes.
;; Caller should check `conn-aborted?` before calling and decide
;; whether to retry or surface an error.
spec connection-ask Nat SyrupValue ConnectionState -> ConnAsk
defn connection-ask [tgt args cs]
  match [conn-aborted? cs]
    | true  -> conn-ask cs zero ""
    | false ->
        let bq    := [bridge-send-question tgt args [conn-vat cs] [conn-bridge-state cs]]
          let cs' := [conn-state [bq-vat bq] [bq-state bq] [conn-emitted cs] [conn-aborted? cs]]
            conn-ask cs' [bq-pid bq] [bq-bytes bq]

;; ===========================================================
;; Phase 32: outbound GC release API
;; ===========================================================
;;
;; Manual reference-count release. The user is the source of truth
;; about "I'm done with this": calls release-answer (we no longer
;; need an outbound-question entry) or release-import (we dropped
;; k references to peer's export).
;;
;; Both return ConnRelease(cs', bytes-list) — the bytes to write
;; to peer's socket plus the updated state.
;;
;; ConnRelease is the parallel of ConnAsk for the release path.
;; Single-constructor — avoids issue #60.

data ConnRelease
  conn-release : ConnectionState -> [List String]

spec conn-release-state ConnRelease -> ConnectionState
defn conn-release-state
  | conn-release cs _ -> cs

spec conn-release-bytes ConnRelease -> List String
defn conn-release-bytes
  | conn-release _ bs -> bs

;; Build the wire bytes for an op:gc-answer N message.
spec gc-answer-bytes Nat -> String
defn gc-answer-bytes [pos]
  wire::encode [syrup-tagged "op:gc-answer" [syrup-nat pos]]

;; Build the wire bytes for an op:gc-export N k message.
spec gc-export-bytes Nat Nat -> String
defn gc-export-bytes [pos cnt]
  wire::encode-record "op:gc-export"
    [cons [syrup-nat pos] [cons [syrup-nat cnt] nil]]

;; Release: we're done with our outbound-question at q-pos N. Emits
;; op:gc-answer N bytes for peer (so they can free their answer-table
;; entry) and removes the q-pos → promise mapping from our
;; outbound-questions table. Aborted-aware (no-op if connection
;; already aborted).
;;
;; Note: removing the outbound-questions entry means subsequent
;; inbound op-deliver-to-answer for the same q-pos won't resolve any
;; promise (they'd be dropped by dispatch-incoming-answer). That's
;; correct: "done" means done.
spec release-answer Nat ConnectionState -> ConnRelease
defn release-answer [our-q-pos cs]
  match [conn-aborted? cs]
    | true  -> conn-release cs [nil String]
    | false ->
        let st'   := [bs-remove-outbound-question our-q-pos [conn-bridge-state cs]]
          let cs' := [conn-state [conn-vat cs] st' [conn-emitted cs] [conn-aborted? cs]]
            let bytes := [gc-answer-bytes our-q-pos]
              conn-release cs' [cons bytes [nil String]]

;; Release: we dropped k references to peer's export at export-pos N.
;; Emits op:gc-export N k bytes for peer (so they can decrement their
;; refcount) AND decrements our local imports-refcount[N] by k
;; (saturating at 0). After Phase 34c, imports-refcount tracks how
;; many references we hold; this is the symmetric decrement of the
;; auto-increment-on-decode (Phase 34b).
spec release-import Nat Nat ConnectionState -> ConnRelease
defn release-import [export-pos cnt cs]
  match [conn-aborted? cs]
    | true  -> conn-release cs [nil String]
    | false ->
        let st'   := [bs-decr-import export-pos cnt [conn-bridge-state cs]]
          let cs' := [conn-state [conn-vat cs] st' [conn-emitted cs] [conn-aborted? cs]]
            let bytes := [gc-export-bytes export-pos cnt]
              conn-release cs' [cons bytes [nil String]]

;; ===========================================================
;; Phase 50: declarative release queue
;; ===========================================================
;;
;; release-import (above) is the imperative form: it returns a
;; ConnRelease whose bytes the caller threads into the outbound
;; stream. That works for one-shot release calls, but doesn't
;; integrate naturally with the pump-on-each-step flow — every
;; release-import call requires the caller to do its own bytes
;; concatenation.
;;
;; This phase adds the declarative form: the caller stages a
;; release on bridge state via bs-queue-release-import, and the
;; next pump-outbound flushes the staged op:gc-export bytes
;; alongside any newly-resolved question replies (because
;; pump-outbound already prepends bs-pending-out to its result).
;;
;; Shape symmetry: this is exactly how bridge-state-with-our-session
;; pre-queues the start-session reply for flush on the first pump.
;; Phase 50 generalises that pre-queue mechanism to "any outbound
;; bytes the caller wants flushed" — op:gc-export is the first
;; consumer.

spec bs-queue-release-import Nat Nat BridgeState -> BridgeState
  :doc "Phase 50: stage an op:gc-export N k for flush on next pump, AND decrement imports-refcount[N] by k. Declarative form of release-import — returns the updated bridge state instead of immediate bytes."
defn bs-queue-release-import [export-pos cnt st]
  let bytes := [gc-export-bytes export-pos cnt]
    [bs-append-pending-out bytes [bs-decr-import export-pos cnt st]]

;; ConnectionState wrapper around bs-queue-release-import. Returns
;; the updated CS without producing bytes — the next connection-step
;; flushes them via pump-outbound.
spec connection-queue-release-import Nat Nat ConnectionState -> ConnectionState
  :doc "Phase 50: declarative release-import on a ConnectionState. Aborted-aware (no-op if connection is aborted)."
defn connection-queue-release-import [export-pos cnt cs]
  match [conn-aborted? cs]
    | true  -> cs
    | false ->
        let st' := [bs-queue-release-import export-pos cnt [conn-bridge-state cs]]
          conn-state [conn-vat cs] st' [conn-emitted cs] [conn-aborted? cs]

;; ===========================================================
;; Phase 39: questioner-side promise pipelining (sender)
;; ===========================================================
;;
;; Symmetric to Phase 38 (which handled inbound pipelined messages).
;; Here WE pipeline a follow-up message onto a question we previously
;; asked: target = our q-pos (which peer recorded in their answers
;; table when we asked). The wire shape is identical to a reply:
;;
;;   <op:deliver <desc:answer our-q-pos> args false false>
;;
;; Disambiguation is on the receiving side (peer): if our-q-pos is in
;; their inbound questions table (the Q WE asked them), this is a
;; pipelined chain; their bridge looks up the local promise/actor and
;; forwards/queues. Same wire shape as their reply path; their bridge's
;; Phase 38 fall-through resolves the ambiguity.
;;
;; State: no allocation, no tracking change — peer queues on their
;; side. We just emit bytes. Reuses ConnRelease as the (state, bytes)
;; carrier; the type's name is overspecific to GC but the shape fits.
;;
;; Caller usage:
;;   ask  = connection-ask tgt args cs0          ; allocate Q
;;   write (conn-ask-bytes ask)                  ; send Q bytes
;;   ;; ... later, before peer replies ...
;;   pipe = connection-pipeline (conn-ask-pid ask) more-args (conn-ask-state ask)
;;   write (conn-release-bytes pipe)             ; send pipelined bytes
;;
;; Aborted-aware: no-op (empty bytes) if connection already aborted.
spec connection-pipeline Nat SyrupValue ConnectionState -> ConnRelease
defn connection-pipeline [our-q-pos args cs]
  match [conn-aborted? cs]
    | true  -> conn-release cs [nil String]
    | false ->
        let bytes := [outbound-deliver-bytes our-q-pos args]
          conn-release cs [cons bytes [nil String]]

;; The per-op aborted check. We use a Bool predicate via match
;; rather than a boolean op (Prologos doesn't expose a generic
;; `||`). Once aborted, every subsequent step is a no-op
;; returning the same state with no outbound bytes.

;; Determine whether this op is itself an abort.
spec op-is-abort? CapTPOp -> Bool
defn op-is-abort?
  | op-abort _         -> true
  | op-start-session _ _ -> false
  | op-deliver _ _ _ _ -> false
  | op-deliver-only _ _ -> false
  | op-listen _ _      -> false
  | op-gc-export _ _   -> false
  | op-gc-answer _     -> false
  | op-deliver-to-answer _ _ _ _ -> false

;; Once-aborted bool: was-aborted OR op-is-abort.
spec or-bool Bool Bool -> Bool
defn or-bool
  | true  _     -> true
  | false other -> other

;; Drain fuel: 5 successive turns is plenty for our test cases.
def drain-fuel : Nat := [suc [suc [suc [suc [suc zero]]]]]

;; The single entry point.
;; Step:
;;   1. If already aborted, return state unchanged with no bytes.
;;   2. Apply the inbound op via captp-incoming-with-state.
;;   3. Drain the vat with bounded fuel.
;;   4. Pump outbound bytes — emits pending-out (e.g. our handshake
;;      reply pre-queued via bridge-state-with-our-session) plus
;;      bytes for newly-resolved questions.
;;   5. Clear pending-out so subsequent pumps don't re-emit.
;;   6. Update emitted-pids and aborted? flag.
spec connection-step CapTPOp ConnectionState -> ConnStep
defn connection-step [op cs]
  match [conn-aborted? cs]
    | true  -> conn-step cs nil
    | false ->
        let bs    := [captp-incoming-with-state op [conn-vat cs] [conn-bridge-state cs]]
          let v'    := [run-vat drain-fuel [bridge-step-vat bs]]
            let st0   := [bs-clear-pending-out [bridge-step-state bs]]
              let pump  := [pump-outbound v' [bridge-step-state bs] [conn-emitted cs]]
                ;; Phase 47: GC pipelined-msgs whose pid has been
                ;; emitted (forwarding/break-forward/plain-value-error
                ;; bytes already produced); the queue no longer needs
                ;; them. Without this the queue grows monotonically
                ;; across the connection's lifetime.
                ;; Phase 48: GC listeners that have been notified
                ;; (one-shot: a promise settles exactly once, so a
                ;; consumed listener entry serves no further purpose).
                let st1   := [bs-gc-pipelined-msgs-by-emitted [pump-result-emitted pump] st0]
                  let st'   := [bs-gc-listeners-by-notified [pump-result-emitted pump] st1]
                    let cs'   := [conn-state v' st' [pump-result-emitted pump] [or-bool [conn-aborted? cs] [op-is-abort? op]]]
                      conn-step cs' [pump-result-bytes pump]

