ns prologos::ocapn::behavior

;; ========================================
;; Built-in actor behaviours
;; ========================================
;;
;; In Goblins, an actor's behaviour is an arbitrary Racket closure.
;; In Prologos there is no straightforward way to store heterogeneous
;; closures inside a single `data` constructor and dispatch them at
;; runtime — so we model behaviours as a closed sum (BehaviorTag) and
;; provide a fixed dispatcher (`step-behavior`) keyed by tag.
;;
;; Adding a new actor type means: (1) extending `BehaviorTag`,
;; (2) writing the per-tag step function, (3) extending
;; `step-behavior` to dispatch it. This is the load-bearing limitation
;; documented in goblin-pitfalls #3.
;;
;; The built-in set is small but covers the patterns we test:
;;
;;   beh-cell      — settable storage cell. msg = tagged "set" v / "get"
;;   beh-counter   — incrementable counter. msg = tagged "inc" / "get"
;;   beh-greeter   — greeter that constructs greetings
;;   beh-echo      — returns its argument unchanged
;;   beh-adder     — running sum, message = arg, state = total
;;   beh-forwarder — forwards everything to a fixed target refr id
;;   beh-fulfiller — resolves a promise with a constant value (for tests)

require [prologos::ocapn::syrup
         :refer [SyrupValue
                 syrup-null syrup-bool syrup-nat syrup-int syrup-string
                 syrup-symbol syrup-list syrup-tagged
                 syrup-refr syrup-promise
                 wire-nat]]
        [prologos::data::list   :refer [List nil cons]]
        [prologos::data::option :refer [Option none some]]
        [prologos::data::nat    :refer [add]]
        [prologos::data::string :as str :refer []]

;; ========================================
;; Behaviour tags
;; ========================================

data BehaviorTag
  beh-cell
  beh-counter
  beh-greeter
  beh-echo
  beh-adder
  beh-forwarder
  beh-fulfiller
  ;; Upstream's promise RESOLVER: interprets ['fulfill v] / ['break r]
  ;; rather than resolving with the whole message (which beh-fulfiller does).
  beh-resolver

;; ========================================
;; Side-effects an actor can request
;; ========================================
;;
;; The vat fully owns the world; behaviours don't mutate anything.
;; They describe what they want done as a list of Effects, which the
;; vat interprets atomically when the turn closes.

;; TWO ID NAMESPACES, deliberately distinguished. A `Nat` target is
;; ambiguous on its own: it can name a LOCAL actor (a key in the vat's
;; actor table) or a REMOTE object the peer exported to us (which arrives
;; on the wire as `desc:import-object N` and must be addressed back as
;; `desc:export N`). Those numbers are drawn from independent counters and
;; DO collide in practice.
;;
;; `deliver-msg` used to disambiguate by heuristic — "no local actor at
;; this id, therefore it must be remote". That silently misroutes whenever
;; the peer's id happens to match one of ours. It bit the upstream greeter
;; test exactly: the peer delivers `<desc:import-object 1>` to the greeter,
;; which itself sits at local actor id 1, so the greeter's reply was
;; delivered back to the greeter instead of going out on the wire. Nothing
;; errored; the connection simply produced no bytes and upstream timed out.
;;
;; So the namespace is part of the effect, not something to infer later.
data Effect
  ;; Send to a LOCAL refr (fire-and-forget) — `t` is a vat actor-table key.
  eff-send-only   : Nat -> SyrupValue
  ;; Send to a REMOTE object the peer exported — `t` is the peer's export
  ;; position, straight to the outbound queue with no actor-table lookup.
  eff-send-remote : Nat -> SyrupValue
  ;; Resolve a promise with a value (pst-fulfilled).
  eff-resolve     : Nat -> SyrupValue
  ;; Break a promise with a reason (pst-broken).
  eff-break       : Nat -> SyrupValue

;; ========================================
;; ActStep — what one method invocation produces
;; ========================================
;;
;; new-state, return-value, side-effects.

data ActStep
  act-step : SyrupValue -> SyrupValue -> [List Effect]

;; Selectors.

spec step-state ActStep -> SyrupValue
defn step-state
  | act-step st _ _ -> st

spec step-return ActStep -> SyrupValue
defn step-return
  | act-step _ rv _ -> rv

spec step-effects ActStep -> List Effect
defn step-effects
  | act-step _ _ es -> es

;; ========================================
;; A small helper: "no change" step
;; ========================================

spec no-op SyrupValue -> ActStep
  :doc "Return state unchanged with no effects, return-value = state"
defn no-op [state]
  act-step state state nil

;; ========================================
;; Per-behavior step functions
;; ========================================

;; --- echo ---
spec step-echo SyrupValue SyrupValue -> ActStep
defn step-echo [state args]
  act-step state args nil

;; --- cell ---
;; State: stored value. Args: tagged "set" v / "get" / anything.
spec step-cell SyrupValue SyrupValue -> ActStep
defn step-cell
  | state [syrup-tagged tag p] ->
      match [str::eq tag "set"]
        | true  -> act-step p syrup-null nil
        | false -> match [str::eq tag "get"]
            | true  -> no-op state
            | false -> no-op state
  | state syrup-null        -> no-op state
  | state [syrup-bool _]    -> no-op state
  | state [syrup-nat _]     -> no-op state
  | state [syrup-int _]     -> no-op state
  | state [syrup-string _]  -> no-op state
  | state [syrup-symbol _]  -> no-op state
  | state [syrup-list _]    -> no-op state
  | state [syrup-refr _]    -> no-op state
  | state [syrup-promise _] -> no-op state

;; --- counter ---
;; State: syrup-nat n. Args: tagged "inc" _ | tagged "get" _.
;; Adds an explicit "get" branch (returns count without changing it)
;; per Copilot review #28#discussion_r3150426679 — the previous
;; version advertised "get" in this comment but treated it as a
;; no-op alongside every other unknown tag.
spec step-counter SyrupValue SyrupValue -> ActStep
defn step-counter [state args]
  match state
    | syrup-nat n ->
        match args
          | syrup-tagged tag _ ->
              match [str::eq tag "inc"]
                | true  -> act-step [syrup-nat [add n [suc zero]]]
                                    [syrup-nat [add n [suc zero]]]
                                    nil
                | false -> match [str::eq tag "get"]
                    | true  -> no-op state    ;; return count, state unchanged
                    | false -> no-op state    ;; unknown tag
          | syrup-null      -> no-op state
          | syrup-bool _    -> no-op state
          | syrup-nat _     -> no-op state
          | syrup-int _     -> no-op state
          | syrup-string _  -> no-op state
          | syrup-symbol _  -> no-op state
          | syrup-list _    -> no-op state
          | syrup-refr _    -> no-op state
          | syrup-promise _ -> no-op state
    | syrup-null      -> no-op state
    | syrup-bool _    -> no-op state
    | syrup-int _     -> no-op state
    | syrup-string _  -> no-op state
    | syrup-symbol _  -> no-op state
    | syrup-list _    -> no-op state
    | syrup-tagged _ _ -> no-op state
    | syrup-refr _    -> no-op state
    | syrup-promise _ -> no-op state

;; --- greeter ---
;; State: syrup-string greeting. Args: syrup-string name.
;; Returns syrup-string "{greeting}, {name}!".
;; (Trailing "!" added per Copilot review
;; #28#discussion_r3150426776 — implementation now matches comment.)
;; --- upstream-spec greeter support (Phase 59b part 3) ---
;;
;; Upstream's Greeter takes a REFR and SENDS "Hello" to it — a different
;; behaviour from our original string-greeting greeter. Rather than change
;; the existing semantics (tests depend on it), the refr / list-of-refr
;; arms, which previously did nothing, now send.
;;
;; Factored into helpers because step-greeter is already a 2-deep match and
;; a 3-deep nested match fails at IMPORT time (prologos-syntax.md).
;; refr-id-of precedes first-refr-in: single-pass modules, callee first (#16).

;; A peer reference arrives on the wire as a TAGGED descriptor
;; (`desc:import-object N` when the peer hands us one of its objects),
;; not as a bare syrup-refr. Addressing it back is `desc:export N`,
;; which listener-notify-bytes emits. Handling only syrup-refr made the
;; greeter silently no-op on every real upstream frame.

spec first-nat-in [List SyrupValue] -> [Option Nat]
defn first-nat-in [xs]
  match xs
    | nil        -> [none Nat]
    | [cons h _] ->
        match h
          | syrup-nat n      -> [some n]
          | syrup-null       -> [none Nat]
          | syrup-bool _     -> [none Nat]
          | syrup-int _      -> [none Nat]
          | syrup-string _   -> [none Nat]
          | syrup-symbol _   -> [none Nat]
          | syrup-list _     -> [none Nat]
          | syrup-tagged _ _ -> [none Nat]
          | syrup-refr _     -> [none Nat]
          | syrup-promise _  -> [none Nat]

;; A syrup RECORD decodes as tag + an ARGUMENT LIST, so the payload of
;; <desc:import-object 7> is [syrup-nat 7], not a bare syrup-nat. Accept
;; both: the bare form is what hand-built test values use, the list form
;; is what the wire actually delivers.
;; A descriptor's table position arrives as a Syrup POSITIVE INTEGER on the
;; wire (`<18'desc:import-object1+>` — the `+` suffix), so it decodes to
;; `syrup-int`, NOT `syrup-nat`. This arm used to return none for
;; `syrup-int`, which is why the greeter silently found no target in a
;; descriptor it had just been handed: length-1 list, right tag, and still
;; `none`. Delegate to syrup's `wire-nat`, which is the ONE reader for this
;; (it carries the negative guard); do not re-derive the conversion here.
spec nat-payload SyrupValue -> [Option Nat]
defn nat-payload [v]
  match v
    | syrup-nat n      -> [some n]
    | syrup-int _      -> wire-nat v
    | syrup-list xs    -> first-nat-in xs
    | syrup-null       -> [none Nat]
    | syrup-bool _     -> [none Nat]
    | syrup-string _   -> [none Nat]
    | syrup-symbol _   -> [none Nat]
    | syrup-tagged _ _ -> [none Nat]
    | syrup-refr _     -> [none Nat]
    | syrup-promise _  -> [none Nat]

spec desc-target-of String SyrupValue -> [Option Nat]
defn desc-target-of [tag inner]
  match [str::eq tag "desc:import-object"]
    | true  -> nat-payload inner
    | false ->
        match [str::eq tag "desc:export"]
          | true  -> nat-payload inner
          | false -> [none Nat]

spec refr-id-of SyrupValue -> [Option Nat]
defn refr-id-of [v]
  match v
    | syrup-refr t     -> [some t]
    | syrup-null       -> [none Nat]
    | syrup-bool _     -> [none Nat]
    | syrup-nat _      -> [none Nat]
    | syrup-int _      -> [none Nat]
    | syrup-string _   -> [none Nat]
    | syrup-symbol _   -> [none Nat]
    | syrup-list _     -> [none Nat]
    | syrup-tagged t inner -> desc-target-of t inner
    | syrup-promise _  -> [none Nat]

spec first-refr-in [List SyrupValue] -> [Option Nat]
defn first-refr-in [xs]
  match xs
    | nil        -> [none Nat]
    | [cons h _] -> refr-id-of h

;; The refr the greeter is handed came off the wire as a
;; `desc:import-object` / `desc:export` descriptor, so `t` is the PEER's
;; export position, not one of our actor ids — hence eff-send-remote.
;; Using eff-send-only here is what made the upstream test hang: see the
;; namespace note on `data Effect` above.
spec greeter-send SyrupValue [Option Nat] -> ActStep
defn greeter-send
  | state none     -> no-op state
  | state [some t] -> act-step state syrup-null [cons [eff-send-remote t [syrup-list [cons [syrup-string "Hello"] nil]]] nil]

spec step-greeter SyrupValue SyrupValue -> ActStep
defn step-greeter [state args]
  match state
    | syrup-string g ->
        match args
          | syrup-string n ->
              act-step state
                [syrup-string [str::append [str::append [str::append g ", "] n] "!"]]
                nil
          | syrup-null      -> no-op state
          | syrup-bool _    -> no-op state
          | syrup-nat _     -> no-op state
          | syrup-int _     -> no-op state
          | syrup-symbol _  -> no-op state
          | syrup-list xs   -> greeter-send state [first-refr-in xs]
          | syrup-tagged _ _ -> no-op state
          | syrup-refr t    -> greeter-send state [some t]
          | syrup-promise _ -> no-op state
    | syrup-null      -> no-op state
    | syrup-bool _    -> no-op state
    | syrup-nat _     -> no-op state
    | syrup-int _     -> no-op state
    | syrup-symbol _  -> no-op state
    | syrup-list _    -> no-op state
    | syrup-tagged _ _ -> no-op state
    | syrup-refr _    -> no-op state
    | syrup-promise _ -> no-op state

;; --- adder ---
;; State: syrup-nat running-total. Args: syrup-nat addend.
;; new state := total + addend; return new total.
spec step-adder SyrupValue SyrupValue -> ActStep
defn step-adder [state args]
  match state
    | syrup-nat t ->
        match args
          | syrup-nat a ->
              act-step [syrup-nat [add t a]] [syrup-nat [add t a]] nil
          | syrup-null      -> no-op state
          | syrup-bool _    -> no-op state
          | syrup-int _     -> no-op state
          | syrup-string _  -> no-op state
          | syrup-symbol _  -> no-op state
          | syrup-list _    -> no-op state
          | syrup-tagged _ _ -> no-op state
          | syrup-refr _    -> no-op state
          | syrup-promise _ -> no-op state
    | syrup-null      -> no-op state
    | syrup-bool _    -> no-op state
    | syrup-int _     -> no-op state
    | syrup-string _  -> no-op state
    | syrup-symbol _  -> no-op state
    | syrup-list _    -> no-op state
    | syrup-tagged _ _ -> no-op state
    | syrup-refr _    -> no-op state
    | syrup-promise _ -> no-op state

;; --- forwarder ---
;; State: syrup-refr target. Forwards args via a fire-and-forget send.
;; Returns null.
spec step-forwarder SyrupValue SyrupValue -> ActStep
defn step-forwarder [state args]
  match state
    | syrup-refr t ->
        act-step state syrup-null
                 [cons [eff-send-only t args] nil]
    | syrup-null       -> act-step state syrup-null nil
    | syrup-bool _     -> act-step state syrup-null nil
    | syrup-nat _      -> act-step state syrup-null nil
    | syrup-int _      -> act-step state syrup-null nil
    | syrup-string _   -> act-step state syrup-null nil
    | syrup-symbol _   -> act-step state syrup-null nil
    | syrup-list _     -> act-step state syrup-null nil
    | syrup-tagged _ _ -> act-step state syrup-null nil
    | syrup-promise _  -> act-step state syrup-null nil

;; --- fulfiller ---
;; State: syrup-promise pid (the promise to settle).
;; Args: any value. Resolves the named promise to that value, returns null.
spec step-fulfiller SyrupValue SyrupValue -> ActStep
defn step-fulfiller [state args]
  match state
    | syrup-promise pid ->
        act-step state syrup-null
                 [cons [eff-resolve pid args] nil]
    | syrup-null       -> act-step state syrup-null nil
    | syrup-bool _     -> act-step state syrup-null nil
    | syrup-nat _      -> act-step state syrup-null nil
    | syrup-int _      -> act-step state syrup-null nil
    | syrup-string _   -> act-step state syrup-null nil
    | syrup-symbol _   -> act-step state syrup-null nil
    | syrup-list _     -> act-step state syrup-null nil
    | syrup-tagged _ _ -> act-step state syrup-null nil
    | syrup-refr _     -> act-step state syrup-null nil

;; ========================================
;; Dispatcher — the "ABI" for actors
;; ========================================

;; --- resolver (upstream promise-resolver pair) ---
;;
;; State: `syrup-promise pid` — the vow this resolver settles.
;; Message: `['fulfill <value>]` or `['break <reason>]`.
;;
;; beh-fulfiller cannot serve here: it emits `eff-resolve pid args` with the
;; WHOLE message, so settling produced `['fulfill ['fulfill ok]]` where
;; upstream expects `['fulfill ok]` — and a break came back as a FULFILL
;; whose value happened to be `['break oh-no]`, inverting the outcome.
;;
;; Helper chain rather than a nested match: a three-deep `match` in one body
;; does not elaborate (prologos-syntax.md § "Never write three-deep nested
;; match").

spec resolver-settle Nat String SyrupValue -> ActStep
defn resolver-settle [pid verb payload]
  match [str::eq verb "break"]
    | true  -> act-step [syrup-promise pid] syrup-null [cons [eff-break pid payload] nil]
    | false -> act-step [syrup-promise pid] syrup-null [cons [eff-resolve pid payload] nil]

spec resolver-payload Nat String [List SyrupValue] -> ActStep
defn resolver-payload [pid verb rest]
  match rest
    | nil        -> resolver-settle pid verb syrup-null
    | [cons p _] -> resolver-settle pid verb p

spec resolver-verb Nat [List SyrupValue] -> ActStep
defn resolver-verb [pid xs]
  match xs
    | nil -> no-op [syrup-promise pid]
    | [cons h rest] ->
        match h
          | syrup-symbol verb -> resolver-payload pid verb rest
          | _                 -> no-op [syrup-promise pid]

spec resolver-with-pid Nat SyrupValue -> ActStep
defn resolver-with-pid [pid args]
  match args
    | syrup-list xs -> resolver-verb pid xs
    | _             -> no-op [syrup-promise pid]

spec step-resolver SyrupValue SyrupValue -> ActStep
defn step-resolver [state args]
  match state
    | syrup-promise pid -> resolver-with-pid pid args
    | _                 -> no-op state

spec step-behavior BehaviorTag SyrupValue SyrupValue -> ActStep
defn step-behavior [tag state args]
  match tag
    | beh-cell      -> step-cell state args
    | beh-counter   -> step-counter state args
    | beh-greeter   -> step-greeter state args
    | beh-echo      -> step-echo state args
    | beh-adder     -> step-adder state args
    | beh-forwarder -> step-forwarder state args
    | beh-fulfiller -> step-fulfiller state args
    | beh-resolver  -> step-resolver state args
