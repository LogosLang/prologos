ns prologos::ocapn::handshake

;; ========================================
;; OCapN handshake — Phase 58.b
;; ========================================
;;
;; Build the canonical 4-field signed `op:start-session` wire bytes
;; using captp-core's syrup codec + crypto FFI. This is the SINGLE
;; client implementation of the handshake — an earlier revision had
;; a parallel Racket-side fixture whose syrup encoder duplicated
;; `prologos::ocapn::syrup-wire`; that fixture was deleted in
;; Phase 58.b-3 once this module subsumed it.
;;
;; Wire shape:
;;
;;   <op:start-session ver pubkey-sexpr location sig-sexpr>
;;
;;   pubkey-sexpr = (public-key (ecc (curve Ed25519) (flags eddsa) (q PK)))
;;   sig-sexpr    = (sig-val (eddsa (r R) (s S)))
;;   location     = <ocapn-peer 'tcp-testing-only ADDRESS HINTS>
;;
;; Signature is over the syrup-encoded `<my-location LOC>`.
;;
;; IMPLEMENTATION NOTE — why bytes-level assembly:
;;
;; Prologos's `SyrupValue` models a record as `syrup-tagged label
;; payload` with a SINGLE payload — `encode` of that gives the
;; WRONG shape `<label [a b c]>` for a multi-arg record. The OCapN
;; spec (and the Python ocapn-test-suite) needs `<label a b c>`
;; with N direct args. So records are assembled at the BYTES level
;; here: each arg is pre-encoded, then concatenated between
;; `<label` and `>`.
;;
;; Likewise, crypto byte-payloads (pubkey, sig halves) are
;; Latin-1-encoded Strings where 1 char == 1 wire byte. The
;; generic `syrup-bytes` encoder uses `str::bytes-length` (UTF-8
;; byte count) which over-counts chars 128-255. We build the
;; bytes-atoms directly with `str::length` (char count == Latin-1
;; byte count).

require [prologos::ocapn::syrup    :refer [SyrupValue syrup-list syrup-symbol
                                            syrup-bytes syrup-string syrup-tagged]]
        [prologos::ocapn::syrup-wire :as wire :refer [encode encode-record]]
        [prologos::ocapn::crypto   :refer [gen-keypair-raw pubkey-raw sign-raw verify-raw]]
        [prologos::data::list      :refer [List nil cons]]
        [prologos::data::string    :as str :refer []]
        [prologos::data::option    :refer [Option some none]]

;; Hex-decode inbound frame bytes. The conversion is an FFI call
;; rather than a Prologos loop because the tree-walking reducer is
;; far too slow at incremental byte-string assembly — see
;; ocapn-frame-ffi.rkt.
foreign racket "ocapn-frame-ffi.rkt"
  [ocapn-hex-decode :as hex-to-bytes : String -> String]

;; ----------------------------------------
;; Bytes-level assembly primitives
;; ----------------------------------------

spec concat-strings [List String] -> String
defn concat-strings
  | nil          -> ""
  | cons hd tl   -> str::append hd [concat-strings tl]

spec list-bytes [List String] -> String
  :doc "Assemble `[item-bytes...]` from already-encoded element byte-strings."
defn list-bytes [item-bytes]
  str::append "[" [str::append [concat-strings item-bytes] "]"]

spec record-bytes String [List String] -> String
  :doc "Assemble `<label arg-bytes...>` from a label + already-encoded arg byte-strings."
defn record-bytes [label arg-bytes]
  str::append "<"
    [str::append [wire::encode [syrup-symbol label]]
      [str::append [concat-strings arg-bytes] ">"]]

;; A Syrup `bstr` atom is `<byte-count>:<bytes>`. For Latin-1
;; byte-strings, the byte count == the char count (str::length).
spec bytes-atom String -> String
  :doc "Encode a Latin-1 byte-string as a Syrup bstr: <char-count>:<chars>."
defn bytes-atom [b]
  str::append [str::from-int [str::length b]] [str::append ":" b]

;; ----------------------------------------
;; gcrypt-style s-expressions (bytes-level)
;; ----------------------------------------
;;
;; gcrypt s-exprs are nested syrup-lists whose head is a name-
;; symbol. Lists encode as `[items]` with no length prefix, so the
;; list structure is fine — but the q/r/s payloads are crypto
;; bytes-atoms needing the Latin-1-correct length.

spec gcrypt-pair-sym-bytes String String -> String
  :doc "Wire bytes for a gcrypt (key SYMBOL) sub-form."
defn gcrypt-pair-sym-bytes [key sym]
  list-bytes
    [cons [wire::encode [syrup-symbol key]]
      [cons [wire::encode [syrup-symbol sym]] nil]]

spec gcrypt-pair-str-bytes String String -> String
  :doc "Wire bytes for a gcrypt (key STRING) sub-form."
defn gcrypt-pair-str-bytes [key value]
  list-bytes
    [cons [wire::encode [syrup-symbol key]]
      [cons [wire::encode [syrup-string value]] nil]]

spec gcrypt-pair-bytes-atom String String -> String
  :doc "Wire bytes for a gcrypt (key BYTES-ATOM) sub-form."
defn gcrypt-pair-bytes-atom [key payload]
  list-bytes
    [cons [wire::encode [syrup-symbol key]]
      [cons [bytes-atom payload] nil]]

spec gcrypt-pubkey-bytes String -> String
  :doc "Wire bytes for (public-key (ecc (curve Ed25519) (flags eddsa) (q PK)))."
defn gcrypt-pubkey-bytes [pk]
  list-bytes
    [cons [wire::encode [syrup-symbol "public-key"]]
      [cons [list-bytes
              [cons [wire::encode [syrup-symbol "ecc"]]
                [cons [gcrypt-pair-sym-bytes "curve" "Ed25519"]
                  [cons [gcrypt-pair-sym-bytes "flags" "eddsa"]
                    [cons [gcrypt-pair-bytes-atom "q" pk] nil]]]]]
        nil]]

spec gcrypt-sig-bytes String String -> String
  :doc "Wire bytes for (sig-val (eddsa (r R) (s S)))."
defn gcrypt-sig-bytes [r s]
  list-bytes
    [cons [wire::encode [syrup-symbol "sig-val"]]
      [cons [list-bytes
              [cons [wire::encode [syrup-symbol "eddsa"]]
                [cons [gcrypt-pair-bytes-atom "r" r]
                  [cons [gcrypt-pair-bytes-atom "s" s] nil]]]]
        nil]]

;; ----------------------------------------
;; Location: <ocapn-peer transport address hints>
;; ----------------------------------------

spec ocapn-peer-bytes String String String String -> String
  :doc "Build the wire bytes for <ocapn-peer 'TRANSPORT ADDRESS HINTS>. HINTS is modelled as a syrup-list of (host H) (port P) sub-lists — a future revision can lift to a real syrup dict once the SyrupValue model gains one. transport/host/port are ASCII so the generic encoder is fine for them."
defn ocapn-peer-bytes [transport address host port]
  record-bytes "ocapn-peer"
    [cons [wire::encode [syrup-symbol transport]]
      [cons [wire::encode [syrup-string address]]
        [cons [list-bytes
                [cons [gcrypt-pair-str-bytes "host" host]
                  [cons [gcrypt-pair-str-bytes "port" port] nil]]]
          nil]]]

;; ----------------------------------------
;; my-location envelope + signing
;; ----------------------------------------
;;
;; The OCapN spec mandates the signature is over the syrup-encoded
;; `<my-location LOC>` envelope, not over LOC directly — this
;; prevents a captured signature being replayed as a bare location.

spec my-location-envelope-bytes String -> String
  :doc "Wrap pre-encoded location bytes in <my-location LOC>."
defn my-location-envelope-bytes [location-bytes]
  record-bytes "my-location" [cons location-bytes nil]

spec sign-location Nat String -> String
  :doc "Given a keypair handle + pre-encoded location bytes, return the 64-byte Ed25519 signature over the my-location envelope."
defn sign-location [kp location-bytes]
  sign-raw kp [my-location-envelope-bytes location-bytes]

;; ----------------------------------------
;; Build the signed op:start-session bytes
;; ----------------------------------------

spec start-session-bytes String Nat String -> String
  :doc "Build the 4-field signed <op:start-session ver pubkey loc sig> wire bytes given (captp-version, keypair-handle, pre-encoded-location-bytes). 4 DIRECT record args."
defn start-session-bytes [ver kp location-bytes]
  let pk := [pubkey-raw kp]
    let sig := [sign-location kp location-bytes]
      let r := [str::slice sig 0 32]
        let s := [str::slice sig 32 64]
          [record-bytes "op:start-session"
            [cons [wire::encode [syrup-string ver]]
              [cons [gcrypt-pubkey-bytes pk]
                [cons location-bytes
                  [cons [gcrypt-sig-bytes r s] nil]]]]]

;; ----------------------------------------
;; Convenience: build the full handshake in one call
;; ----------------------------------------

spec mk-handshake-bytes String String String String String -> String
  :doc "Generate a fresh Ed25519 keypair and build the signed op:start-session bytes for (ver, transport, address, host, port)."
defn mk-handshake-bytes [ver transport address host port]
  let kp := [gen-keypair-raw unit]
    let location-bytes := [ocapn-peer-bytes transport address host port]
      start-session-bytes ver kp location-bytes

;; ----------------------------------------
;; Incoming handshake validation — Phase 58.c
;; ----------------------------------------
;;
;; The OCapN spec requires the receiver of an op:start-session to
;; reject it (with op:abort) when the CapTP version is unsupported.
;; The decision logic lives HERE, in the core implementation — the
;; test server is a thin TCP shell that only frames bytes.
;;
;; Inbound wire bytes reach this module HEX-ENCODED: embedding
;; arbitrary Latin-1 bytes in a Prologos string literal (the server's
;; only channel into a Prologos call) is fragile, so the server
;; hex-encodes the frame and `hex-to-bytes` (FFI) recovers it here.

;; --- op:abort builder ---

spec abort-bytes String -> String
  :doc "Build the <op:abort reason> wire bytes for a reason string."
defn abort-bytes [reason]
  record-bytes "op:abort" [cons [wire::encode [syrup-string reason]] nil]

;; --- record-header / version-field parse ---
;;
;; Only the first two fields of the inbound record are touched —
;; the label (a symbol) and the CapTP version (a string). Both are
;; flat atoms, so this never descends into the pubkey / location /
;; signature sub-structures (whose decoding is Phase 58.d work).

spec is-start-session-label? SyrupValue -> Bool
defn is-start-session-label? [v]
  match v
    | syrup-symbol s -> [str::eq s "op:start-session"]
    | _              -> false

spec syrup-string-value SyrupValue -> [Option String]
defn syrup-string-value [v]
  match v
    | syrup-string s -> [some s]
    | _              -> none

spec version-after-label String SyrupValue Int -> [Option String]
defn version-after-label [frame label off]
  match [is-start-session-label? label]
    | false -> none
    | true  ->
        match [wire::decode-at frame off]
          | none   -> none
          | some d -> [syrup-string-value [wire::d-value d]]

spec parse-incoming-version String -> [Option String]
  :doc "Extract the CapTP version from an inbound op:start-session frame."
defn parse-incoming-version [frame]
  match [int-lt [str::length frame] 2]
    | true  -> none
    | false ->
        match [wire::decode-at frame 1]
          | none   -> none
          | some d -> [version-after-label frame [wire::d-value d] [wire::d-consumed d]]

;; --- top-level decision ---

spec decide-incoming String [Option String] -> String
defn decide-incoming [expected-ver mv]
  match mv
    | none   -> [abort-bytes "expected op:start-session"]
    | some v ->
        match [str::eq v expected-ver]
          | true  -> ""
          | false -> [abort-bytes "unsupported CapTP version"]

spec check-incoming-start-session String String -> String
  :doc "Validate an inbound op:start-session frame (hex-encoded wire
        bytes). Returns the empty string when the handshake is
        acceptable, or op:abort wire bytes to send before closing."
defn check-incoming-start-session [expected-ver hex-frame]
  decide-incoming expected-ver [parse-incoming-version [hex-to-bytes hex-frame]]
