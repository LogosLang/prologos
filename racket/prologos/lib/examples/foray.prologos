;; some examples using broadcast selection `:` operator
def users :=
  @[@[{:userName "Lisa" :age 30}]
    @[{:userName "John" :age 25}]
    @[{:userName "Mike" :age 35}]]


{:name "John"}

users:0:userName
;; @["Lisa" "John" "Mike"] : 〈 String 〉
users:{0.userName^}
;; @[["Lisa"] ["John"] ["Mike"]]


;; :< broadcast pick/unwrap (APL)
users:<{0.userName^}
;; @["Lisa" "John" "Mike"] : 〈〈 String 〉〉
users:{0.userName^ 0.age^}
;; @[@["Lisa" 30] @["John" 25] @["Mike" 35]] : 〈〈 String Int 〉〉


users:0:{userName}
