;; Path Selection Algebra
;; { } select  (postfix juxtaposition, no space)
;; :  broadcast
;; .  deeper level
;; k^ drop key, keep value only
;; k^k' dynamic key rename
;; m{l.k^_} rewrite key to full path: {:l-k v}
;; .*  splat operator - select all keys at this level
;; .N  returns value at index N of a vector
;; {N} returns a vector of values at indices N of a vector, N-ary
;; {N M} returns values at indices N and M of a vector, N-ary

def app-config
  :name "MyApp"
  :date [now]   ;; date is computed dynamically
  :version "1.0.0"
  :server
    :host "localhost"
    :port 8080
    :ssl
      :enabled true
      :cert-path "/etc/ssl/cert.pem"
  :database
    :url [env "DATABASE_URL"]
    :pool-size 10
  :features @[:auth :logging :caching]
  :admins
    - :name "Alice"
      :role :super
    - :name "Bob"
      :role :regular


app-config{server.ssl.{enabled^-ssl cert-path^cert}}

