spec one-minus Posit64 -> Posit64
defn one-minus [x]
  .(1 - x)

defn floatOneMinus [x:Float64] : Float64
  .(1 - x)  


;; this is my version, which *should work*
spec independent-occurence [PVec Posit32] -> Posit32




defn independent-occurence [xs]
  #:spec [Seq Num] -> Num
  #:doc "Compute the probability of at least one occurrence of independent events
         with probabilities in `xs`."
  .(1 - [reduce * [map [- 1 _] xs]])



  
;; and the work-around spelling(s):
spec prod-one-minus [List Posit32] -> Posit32
defn prod-one-minus [xs]
  match xs
    | nil       -> 1.0
    | cons a as -> [p32* [p32- 1.0 a] [prod-one-minus as]]

spec independent-occurence [PVec Posit32] -> Posit32
defn independent-occurence [xs]
   p32- 1.0 [prod-one-minus [pvec-to-list-fn xs]]




trait Approx {A}
  spacing : A -> A
  :doc "An inexact scheme — arithmetic rounds to nearest.
        `spacing x` is the distance from x to the next representable value.
        (The numerics term of art is ULP, 'unit in the last place'.)"

bundle Probability := (Num Div Approx)

property unit {A}
  :doc "Probability values are in the unit interval [0,1]."
  :where (Ord A) (FromInt A)
  :over  x : A
  :holds [in-range 0 1 x]

;; PROPERTY — propositional witness (m0). Indexed by a TYPE, not a value.
;; ⚠ Not derivable: "Posit32 rounds to nearest" is an AXIOM about the
;;    implementation, asserted per type, not proven.
property Approx {A : Type}
  :doc "A is an inexact scheme — its arithmetic rounds to nearest."
axiom Approx Posit8, Approx Posit16, Approx Posit32, Approx Posit64
axiom Approx Float32, Approx Float64

;; PROPERTY — Σ form. Indexed by a VALUE. Decidable, so dischargeable.
property proportion {A} :where (Ord A) (FromInt A)
  :over  x : A
  :holds [in-range [from-int 0] [from-int 1] x]

;; TRAITS — computational witness (mw dictionaries). These already exist.
;;   bundle Num := (Add Sub Mul Neg Eq Ord Abs FromInt)
;;   trait Div {A} …
;; And the Approx-gated operation, now correctly a trait rather than a marker:
trait Spacing {A} :where (Approx A)
  spacing : A -> A
  :doc "Distance from x to the next representable value (numerics: ULP)."  



defn independent-occurrence [xs]
  :spec  Probability -> Probability
  :doc   "Probability of at least one occurrence of independent events."
  .(1 - [reduce * [map [- 1 _] xs]])


  


