spec collect-bad [Int -> Bool] Int Int -> [List Int]
defn collect-bad [ok? k n]
  match [int-lt n k]
    | true -> nil
    | false ->
      match [ok? k]
        | true  -> [collect-bad ok? [int+ k 1] n]
        | false -> [cons k [collect-bad ok? [int+ k 1] n]]

spec p64-ok? Int -> Bool
defn p64-ok? [k]
  let x := [p64-from-int k]
    [p64-eq [p64* x [p64/ 1.0p x]] 1.0p]

spec bad-p64 Int -> [List Int]
defn bad-p64 [n] [collect-bad p64-ok? 1 n]



bad-p64 201






spec i2f Int -> Float64
  :doc "Convert an integer to a Float64 by repeated addition. This is a slow, 
        inefficient, and naive implementation, but it is useful for testing
        the correctness of the Float64 implementation."
defn i2f [k]
  match [int-le k 0]
    | true  -> (the Float64 0.0)
    | false -> [f64+ (the Float64 1.0) [i2f [int- k 1]]]

spec f64-ok? Int -> Bool
defn f64-ok? [k]
  match [int-le k 0]
    | true  -> true
    | false ->
      let x := [i2f k]
        [f64-eq [f64* x [f64/ (the Float64 1.0) x]] (the Float64 1.0)]


filter [fn [k:Int] [not [f64-ok? k]]]
  map [fn [k:Nat] [from-nat k]] 
    range 351N


        







