spec point-add Point Point -> Point
defn point-add [p1 p2]
  {:x .(p1.x + p2.x)
   :y .(p1.y + p2.y)}

defn point-add2 [p1:Point p2:Point] : Point
  {:x [+ p1.x p2.x]
   :y [+ p1.y p2.y]}

defn point-identity [p : Point] : Point
  p

point-identity p1
point-identity p3
point-identity p4

point-add p1 p2
point-add2 p1 p3



