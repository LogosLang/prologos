;; the `_` indicates we don't care about that particular logic-variable
(rel [🍆]
  &> fruit-color 🍆 _
     not (red-or-green-fruits 🍆)
     not (blue-or-yellow 🍆))

(rel [🐒] 
  &> blue-or-yellow 🐒
     fruit-not-of-color 🐒 "blue")



