;; vehicle light-vehicle automobile


;; vehicle(bicycle).
;; light_vehicle(bicycle).

defr vehicle [?type]
  || "bicycle"
     "golf-cart"
     "automobile"

defr license [?v]
  || "automobile"

defr light-vehicle [?v]
  &> (vehicle v) (not (license v))

solve (light-vehicle lv)

solve (light-vehicle "bicycle")
solve (vehicle v)
solve (not (license v))
solve (license v)

solve (rel [?v] (vehicle v) (not (license v)))
solve (light-vehicle v)

;; define a record type with `schema`
schema VHS
  :rewound Bool
  :title String
  :year  Int

def movie : VHS := {:rewound true :title "Lord of the Rings" :year 2001}
;; a Map without a declared type will have each keys value type inferred by its value-literal:
def movie2 {:rewound true :title "The Chronicles of Narnia" :year 2005}
;; We can also use "Implicit Map" syntax
def movie3 : VHS
  :rewound false
  :title "Lost in Space"
  :year 1998
movie3
;; `movie4` won't passa VHS schema check because it's missing the :year field
def movie4 {:rewound true :title "Timeless"}

defn rewound? [v : VHS] : Bool
  v.rewound

;; even though `movie2` is not defined with a VHS type
;; it still passes the appropriate schema-check:
rewound? movie2
rewound? movie3
;; `movie4` does not satisfy the schema type for VHS
rewound? movie4

defr movies : VHS
  || true  "The Matrix"                     1999
     true  "Inception"                      2010
     false "Interstellar"                   2014
     false "Pulp Fiction"                   1994
     false "The Nightmare Before Christmas" 1993

defr ready-to-watch [movie]
  &> movies true movie _

def ready := (ready-to-watch m)

ready[0].m


